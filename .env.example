# Repo-root .env — read by `docker compose -f docker-compose.prod.yml` for variable
# substitution INSIDE that YAML file (Postgres container env, and the web image's build arg).
# This is NOT where the api container's runtime secrets go — those live in .env.prod
# (see apps/api/.env.example for the full checklist of what belongs there).

POSTGRES_USER=cantero
POSTGRES_PASSWORD=change-me-to-a-strong-generated-password
POSTGRES_DB=cantero

# Public URL the web app's browser bundle calls — baked in at build time (NEXT_PUBLIC_* vars are
# inlined into the client bundle, not read at container runtime), so rebuild `web` if this changes.
NEXT_PUBLIC_API_URL=https://api.example.com/api
