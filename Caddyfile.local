# Caddyfile for docker-compose.local.yml — the same two sites as ./Caddyfile, on *.localhost with
# certificates from Caddy's own local CA, and on unprivileged ports.

{
	local_certs
	http_port 8080
	https_port 8443
}

app.localhost {
	reverse_proxy web:3000
}

api.localhost {
	reverse_proxy api:4000
}
