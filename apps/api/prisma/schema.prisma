/// Who did what, when — for accountability in a multi-role B2B tool.
/// actorName is denormalized (not just a User relation) so history reads
/// correctly even after a member is removed; actorUserId is nullable for
/// actions taken by a non-member (e.g. a client deciding on a public estimate link).
model AuditLog {
  id          String   @id @default(uuid())
  companyId   String
  actorUserId String?
  actorName   String
  action      String
  entityType  String
  entityId    String
  summary     String
  metadata    Json?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("audit_logs")
}

/// Company-level credential for the read-only external integration API (/api/v1/*).
/// The raw key is shown once at creation and never persisted — only its hash.
model ApiKey {
  id         String    @id @default(uuid())
  companyId  String
  name       String
  /// First few characters of the raw key, kept for display so a company can tell keys apart without re-showing the secret.
  keyPrefix  String
  keyHash    String    @unique
  /// Which /v1/* resources this key may read. Empty array = unrestricted (legacy keys created
  /// before scoping existed, and the default if none are picked at creation time).
  scopes     String[]  @default([])
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("api_keys")
}

/// A company-configured HTTP callback: on subscribed events, the raw secret signs the
/// POST body (HMAC-SHA256) so the receiver can verify it actually came from Cantero.
/// The secret is shown in full only at creation/regeneration — unlike ApiKey it must
/// stay retrievable server-side since every delivery needs it to sign the payload.
model WebhookEndpoint {
  id                 String    @id @default(uuid())
  companyId          String
  url                String
  secret             String
  /// Event names this endpoint receives, e.g. "estimate.sent" — see WEBHOOK_EVENTS in @cantero/shared.
  events             String[]
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  lastDeliveryAt     DateTime?
  lastDeliveryStatus String?

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([companyId])
  @@map("webhook_endpoints")
}

/// A rolling delivery log per endpoint, kept for the Settings UI so a company can see
/// why a webhook stopped firing (timeout, 4xx/5xx, DNS failure) without external tooling.
model WebhookDelivery {
  id                String   @id @default(uuid())
  webhookEndpointId String
  /// Set when this delivery was produced by the OutboxProcessor — null for older rows and for
  /// notifyChat (Slack/Teams) deliveries, which aren't outbox-backed. Paired with
  /// webhookEndpointId in a unique constraint so a retried outbox job can tell it already
  /// delivered to this endpoint and skip re-sending instead of double-posting.
  outboxEventId     String?
  event             String
  success           Boolean
  statusCode        Int?
  error             String?
  createdAt         DateTime @default(now())

  endpoint WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)
  outboxEvent OutboxEvent? @relation(fields: [outboxEventId], references: [id], onDelete: SetNull)

  @@unique([outboxEventId, webhookEndpointId])
  @@index([webhookEndpointId, createdAt])
  @@map("webhook_deliveries")
}

enum OutboxEventStatus {
  pending
  processing
  delivered
  failed
}

/// Transactional outbox for webhook delivery: callers write a row here in the SAME
/// prisma.$transaction() as the business event that triggers it (see OutboxService.enqueue), so
/// a process crash after commit still leaves a durable pending event — nothing is lost the way a
/// bare fire-and-forget WebhooksService.trigger() call could lose it. A separate polling
/// BullMQ worker (OutboxProcessor) picks up pending rows and delivers them with retry/backoff.
/// See AUDIT-2026-09-07.md "Доставка интеграций ненадёжна".
model OutboxEvent {
  id            String            @id @default(uuid())
  companyId     String
  /// Event name, e.g. "invoice.sent" — matched against WebhookEndpoint.events at delivery time.
  event         String
  payload       Json
  status        OutboxEventStatus @default(pending)
  attempts      Int               @default(0)
  lastError     String?
  nextAttemptAt DateTime          @default(now())
  createdAt     DateTime          @default(now())
  deliveredAt   DateTime?

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([status, nextAttemptAt])
  @@index([companyId, createdAt])
  @@map("outbox_events")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  name            String
  createdAt       DateTime  @default(now())
  /// TOTP secret (base32), set once the user completes 2FA setup — null means 2FA is off.
  totpSecret      String?
  totpEnabledAt   DateTime?
  /// Bcrypt-hashed one-time recovery codes, consumed (removed) as they're used.
  totpBackupCodes String[]  @default([])

  memberships         Membership[]
  workers             Worker[]
  documents           Document[]
  dailyLogs           DailyLog[]
  comments            Comment[]
  portalMessages      PortalMessage[]
  commentMentions     CommentMention[]
  savedViews          SavedView[]
  customReports       CustomReport[]
  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]
  notificationReads   NotificationRead[]
  dashboardWidgets    DashboardWidget[]
  projectMemberships  ProjectMember[]
  signatureRequests   SignatureRequest[]
  assignedTickets     SupportTicket[]

  @@map("users")
}

/// A revocable JWT-backed session, keyed by the token's own `sid` claim — lets a user see and
/// sign out individual devices without making the whole auth scheme stateful.
model UserSession {
  id         String    @id @default(uuid())
  userId     String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  userAgent  String?
  ipAddress  String?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Membership {
  id                          String               @id @default(uuid())
  userId                      String
  companyId                   String
  role                        MembershipRole       @default(owner)
  createdAt                   DateTime             @default(now())
  /// When this member last opened the notification bell — drives the unread-count badge.
  notificationsLastViewedAt   DateTime?
  /// When this member was last sent a web push notification — drives which newly-derived
  /// notifications (see NotificationsService) still need pushing, separate from the "seen" cursor above.
  pushNotificationsLastSentAt DateTime?
  /// Opt-in email summary of new notifications — "off" by default. emailDigestLastSentAt is a
  /// third independent cursor (own read/push cursors above), advanced once per due digest pass
  /// regardless of whether anything new was found, so the daily/weekly clock always resets cleanly.
  emailDigestFrequency        EmailDigestFrequency @default(off)
  emailDigestLastSentAt       DateTime?
  /// Notification `type` values (see NotificationsService.NotificationItem) this member has opted
  /// out of — filtered out of both the bell list and the email digest before either is built.
  /// Empty means everything shows, same as before this field existed.
  mutedNotificationTypes      String[]             @default([])
  /// Grants this member every permission tier listed in the custom role's basePermissions, on
  /// top of whatever `role` above already allows — never a reduction, always additive. Null
  /// means no custom role; `role` alone still governs, exactly as before this feature existed.
  customRoleId                String?

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pushSubscriptions PushSubscription[]
  customRole        CustomRole?        @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("memberships")
}

/// A company-defined named permission bundle — e.g. "Site Lead" = foreman + estimator tiers —
/// for when one person needs the combined permissions of more than one fixed MembershipRole.
/// Purely additive: it layers on top of the member's own `role`, never replaces or restricts it,
/// so every existing @Roles(...) check across the app keeps working unchanged. basePermissions
/// is deliberately restricted to the non-owner manageable tiers (see MEMBERSHIP_ROLES_MANAGEABLE)
/// — a custom role can never grant owner-level access.
model CustomRole {
  id              String           @id @default(uuid())
  companyId       String
  name            String
  basePermissions MembershipRole[]
  createdAt       DateTime         @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("custom_roles")
}

/// A browser's Push API subscription for one membership (device-specific — a user
/// with the same membership on two browsers gets two rows). Endpoint is unique because
/// the browser vendor's push service issues one per subscription.
model PushSubscription {
  id           String   @id @default(uuid())
  membershipId String
  endpoint     String   @unique
  p256dh       String
  auth         String
  createdAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId])
  @@map("push_subscriptions")
}

model Invite {
  id         String         @id @default(uuid())
  companyId  String
  email      String
  role       MembershipRole @default(worker)
  token      String         @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("invites")
}

// ---------- Billing ----------

model Plan {
  id            String   @id @default(uuid())
  code          String   @unique // starter | growth | pro
  name          String
  pricePerSeat  Decimal  @db.Decimal(10, 2)
  currency      Currency @default(EUR)
  stripePriceId String?
  seatMinimum   Int      @default(1)
  createdAt     DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(uuid())
  companyId            String             @unique
  planId               String
  seats                Int                @default(1)
  status               SubscriptionStatus @default(incomplete)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

// ---------- Estimates (flagship) ----------

model MaterialCatalogItem {
  id                     String   @id @default(uuid())
  companyId              String
  code                   String
  name                   String
  unit                   String
  defaultUnitPrice       Decimal  @db.Decimal(12, 4)
  /// Below this quantity on hand (summed across warehouses), a low-stock alert is queued. Null = no alert.
  reorderThreshold       Decimal? @db.Decimal(14, 4)
  /// How much to auto-order when a low-stock alert fires. Both this and preferredSupplierId
  /// must be set for the low-stock processor to draft a purchase order automatically.
  reorderQuantity        Decimal? @db.Decimal(14, 4)
  preferredSupplierId    String?
  /// Embodied carbon per unit of this material, in kg CO2-equivalent — null means unknown/not
  /// entered, not zero, so a carbon report can distinguish "no footprint" from "not tracked yet".
  carbonFootprintKgCo2e  Decimal? @db.Decimal(12, 4)
  greenCertified         Boolean  @default(false)
  /// Free text naming the certifying body/standard (e.g. "FSC", "Cradle to Cradle", "EPD") —
  /// only meaningful when greenCertified is true.
  greenCertificationBody String?
  /// Scan-to-identify code for receiving/counting workflows — unique per company when set, null
  /// means this item has no physical barcode assigned yet (most catalog items won't).
  barcode                String?
  createdAt              DateTime @default(now())

  company             Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  preferredSupplier   Supplier?                     @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  rateCatalogItemUses RateCatalogItemMaterial[]
  stockLevels         StockLevel[]
  stockMovements      StockMovement[]
  costLayers          InventoryCostLayer[]
  stockTransfers      StockTransfer[]
  purchaseOrderLines  PurchaseOrderLine[]
  requirementLines    EstimateMaterialRequirement[]
  stockCountLines     StockCountLine[]
  rfqLines            MaterialRfqLine[]
  priceChanges        MaterialPriceChange[]
  vendorBillLines     VendorBillLine[]

  @@unique([companyId, code])
  @@unique([companyId, barcode])
  @@index([companyId])
  @@index([preferredSupplierId])
  @@map("material_catalog_items")
}

/// Logged only when defaultUnitPrice moves by at least MaterialCatalogService's significance
/// threshold — a routine rounding tweak doesn't create a record or a notification, a real price
/// swing does. Feeds both the notification bell and the "which open estimates does this affect"
/// lookup, neither of which existed before this — MaterialCatalogService.priceHistory() already
/// tracked purchase-order prices over time, but nothing surfaced a catalog-price change itself.
model MaterialPriceChange {
  id                    String   @id @default(uuid())
  companyId             String
  materialCatalogItemId String
  oldPrice              Decimal  @db.Decimal(12, 4)
  newPrice              Decimal  @db.Decimal(12, 4)
  changePercent         Decimal  @db.Decimal(6, 2)
  changedByUserId       String?
  changedByName         String
  createdAt             DateTime @default(now())

  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  materialCatalogItem MaterialCatalogItem @relation(fields: [materialCatalogItemId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([materialCatalogItemId])
  @@map("material_price_changes")
}

/// A named grouping of RateCatalogItems (e.g. "Residential" vs. "Commercial" pricing) a company
/// can switch between. Optional by design — RateCatalogItem.catalogId is nullable, so every item
/// created before this existed (and any new item left unassigned) simply shows as uncategorized
/// rather than requiring a data backfill.
model Catalog {
  id        String   @id @default(uuid())
  companyId String
  name      String
  createdAt DateTime @default(now())

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   RateCatalogItem[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("catalogs")
}

model RateCatalogItem {
  id                String   @id @default(uuid())
  companyId         String
  catalogId         String?
  code              String
  name              String
  unit              String
  laborHoursPerUnit Decimal  @db.Decimal(10, 4)
  /// Optional arithmetic expression (e.g. "length * height") evaluated against formulaParams to
  /// derive a line's quantity instead of the user typing one directly — see FormulaService.
  formula           String?
  formulaParams     String[] @default([])
  createdAt         DateTime @default(now())

  company             Company                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  catalog             Catalog?                       @relation(fields: [catalogId], references: [id], onDelete: SetNull)
  materials           RateCatalogItemMaterial[]
  estimateLines       EstimateLine[]
  changeOrderLines    ChangeOrderLine[]
  assemblyItems       AssemblyItem[]
  revisions           RateCatalogItemRevision[]
  pendingChanges      RateCatalogItemPendingChange[]
  takeoffMeasurements TakeoffMeasurement[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([catalogId])
  @@map("rate_catalog_items")
}

/// A snapshot of a RateCatalogItem's prior state, written every time it's edited — the update()
/// call itself was missing entirely before this phase (rate items could only be created, never
/// changed), so this both adds the missing edit capability and makes every edit auditable.
model RateCatalogItemRevision {
  id                String   @id @default(uuid())
  rateCatalogItemId String
  code              String
  name              String
  unit              String
  laborHoursPerUnit Decimal  @db.Decimal(10, 4)
  changedByUserId   String?
  changedByName     String
  createdAt         DateTime @default(now())

  rateCatalogItem RateCatalogItem @relation(fields: [rateCatalogItemId], references: [id], onDelete: Cascade)

  @@index([rateCatalogItemId])
  @@map("rate_catalog_item_revisions")
}

enum RateCatalogPendingChangeStatus {
  pending
  approved
  rejected
}

/// Held instead of applying immediately when an edit's laborHoursPerUnit swing exceeds
/// Company.rateCatalogApprovalThresholdPercent — see RateCatalogService.update()/approvePendingChange().
/// Mirrors update()'s own field set (the proposed new values), not a diff.
model RateCatalogItemPendingChange {
  id                String                         @id @default(uuid())
  companyId         String
  rateCatalogItemId String
  name              String?
  unit              String?
  laborHoursPerUnit Decimal?                       @db.Decimal(10, 4)
  catalogId         String?
  formula           String?
  formulaParams     String[]                       @default([])
  status            RateCatalogPendingChangeStatus @default(pending)
  proposedByUserId  String?
  proposedByName    String
  proposedAt        DateTime                       @default(now())
  decidedByUserId   String?
  decidedByName     String?
  decidedAt         DateTime?
  decisionNote      String?

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rateCatalogItem RateCatalogItem @relation(fields: [rateCatalogItemId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([rateCatalogItemId])
  @@map("rate_catalog_item_pending_changes")
}

model RateCatalogItemMaterial {
  id                    String  @id @default(uuid())
  rateCatalogItemId     String
  materialCatalogItemId String
  quantityPerUnit       Decimal @db.Decimal(12, 6)
  wasteFactorPercent    Decimal @default(0) @db.Decimal(5, 2)

  rateCatalogItem     RateCatalogItem     @relation(fields: [rateCatalogItemId], references: [id], onDelete: Cascade)
  materialCatalogItem MaterialCatalogItem @relation(fields: [materialCatalogItemId], references: [id], onDelete: Restrict)

  @@unique([rateCatalogItemId, materialCatalogItemId])
  @@index([rateCatalogItemId])
  @@map("rate_catalog_item_materials")
}

/// A digital takeoff — one uploaded plan/photo, calibrated against a real-world reference length
/// so pixel-space drawings can be converted into real quantities. scalePixelLength/scaleRealLength/
/// scaleUnit are all null until the user draws a calibration line; measurements can't be added
/// (beyond storing raw points) until calibration is set — see TakeoffsService.
model Takeoff {
  id               String   @id @default(uuid())
  companyId        String
  projectId        String
  name             String
  imageStorageKey  String
  imageMimeType    String
  scalePixelLength Decimal? @db.Decimal(12, 4)
  scaleRealLength  Decimal? @db.Decimal(12, 4)
  scaleUnit        String?
  createdAt        DateTime @default(now())

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  measurements TakeoffMeasurement[]

  @@index([companyId])
  @@index([projectId])
  @@map("takeoffs")
}

enum TakeoffMeasurementType {
  length
  area
}

/// `points` is an array of {x,y} pixel coordinates in the source image's natural pixel space —
/// a 2-point line for `length` (or more, for a multi-segment run), 3+ points for an `area`
/// polygon. `value` is computed server-side from `points` plus the parent Takeoff's calibrated
/// scale (see takeoff-geometry.ts) rather than trusted from the client.
model TakeoffMeasurement {
  id                String                 @id @default(uuid())
  takeoffId         String
  type              TakeoffMeasurementType
  label             String
  points            Json
  value             Decimal                @db.Decimal(14, 4)
  unit              String
  rateCatalogItemId String?
  createdAt         DateTime               @default(now())

  takeoff         Takeoff          @relation(fields: [takeoffId], references: [id], onDelete: Cascade)
  rateCatalogItem RateCatalogItem? @relation(fields: [rateCatalogItemId], references: [id], onDelete: SetNull)

  @@index([takeoffId])
  @@map("takeoff_measurements")
}

/// A bundle of rate-catalog items priced and added to an estimate as one unit — e.g. "install a
/// bathroom" instead of adding tile, plumbing, and fixtures one line at a time. Adding an
/// assembly to an estimate expands it into ordinary EstimateLines (quantityPerUnit × the assembly
/// quantity entered); nothing downstream needs to know assemblies exist.
model Assembly {
  id        String   @id @default(uuid())
  companyId String
  code      String
  name      String
  unit      String
  createdAt DateTime @default(now())

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   AssemblyItem[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("assemblies")
}

model AssemblyItem {
  id                String  @id @default(uuid())
  assemblyId        String
  rateCatalogItemId String
  quantityPerUnit   Decimal @db.Decimal(12, 4)

  assembly        Assembly        @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  rateCatalogItem RateCatalogItem @relation(fields: [rateCatalogItemId], references: [id], onDelete: Restrict)

  @@index([assemblyId])
  @@map("assembly_items")
}

model Estimate {
  id               String         @id @default(uuid())
  companyId        String
  projectId        String?
  name             String
  status           EstimateStatus @default(draft)
  laborRatePerHour Decimal        @db.Decimal(10, 2)
  markupPercent    Decimal        @default(15) @db.Decimal(5, 2)
  taxPercent       Decimal        @default(0) @db.Decimal(5, 2)
  /// Snapshotted from `project.currency ?? company.currency` at creation — see Project.currency.
  /// A later change to the project's override never retroactively changes an issued estimate.
  currency         Currency       @default(EUR)
  /// A template is a reusable line-item structure with no project of its own;
  /// "create from template" clones its sections/lines into a brand-new estimate.
  isTemplate       Boolean        @default(false)
  /// Bumped each time approve() snapshots the current state into EstimateRevision.
  currentVersion   Int            @default(1)

  materialsCostTotal Decimal @default(0) @db.Decimal(14, 2)
  laborCostTotal     Decimal @default(0) @db.Decimal(14, 2)
  subtotal           Decimal @default(0) @db.Decimal(14, 2)
  markupAmount       Decimal @default(0) @db.Decimal(14, 2)
  taxAmount          Decimal @default(0) @db.Decimal(14, 2)
  grandTotal         Decimal @default(0) @db.Decimal(14, 2)

  /// Independent from the internal `status` — tracks whether the client has signed off,
  /// set via the public decision link generated by send().
  clientDecision     EstimateClientDecision @default(pending)
  sentAt             DateTime?
  decisionAt         DateTime?
  clientDecisionNote String?
  /// Set together with clientDecision="countered" — the price the client is proposing instead.
  /// clientDecisionNote carries their reasoning, reusing the same field approve/reject already use.
  counterOfferAmount Decimal?               @db.Decimal(14, 2)
  /// Random token embedded in the public review link; set on send(), never exposed except there.
  clientAccessToken  String?                @unique
  /// Set together on approval only — a typed name plus a drawn signature (stored via StorageService), never on rejection.
  signerName         String?
  signatureImageKey  String?
  signedIp           String?

  /// Null on the first estimate of a group; every alternate option ("Basic"/"Premium" etc.)
  /// points back to that root so siblings can be listed/compared without their own model.
  variantOfId  String?
  variantLabel String?

  /// Optional client-facing intro text, rendered as a cover page ahead of the line items on the
  /// generated PDF — null skips the cover page entirely, same PDF as before this field existed.
  coverLetter String?

  /// Escalating day-N follow-up emails while sent and still awaiting a client decision — see
  /// EstimateRemindersService, same reminderCount/lastReminderSentAt shape as Invoice's reminders.
  reminderCount      Int       @default(0)
  lastReminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project?                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sections     EstimateSection[]
  lines        EstimateLine[]
  requirements EstimateMaterialRequirement[]
  revisions    EstimateRevision[]
  invoices     Invoice[]
  variantOf    Estimate?                     @relation("EstimateVariants", fields: [variantOfId], references: [id], onDelete: SetNull)
  variants     Estimate[]                    @relation("EstimateVariants")
  changeOrders ChangeOrder[]
  approvals    EstimateApproval[]
  alternates   EstimateAlternate[]

  @@index([companyId])
  @@index([projectId])
  @@index([variantOfId])
  @@map("estimates")
}

enum EstimateAlternateStatus {
  pending
  accepted
  rejected
}

/// A priced add/deduct option within a single estimate — e.g. "Add-alt: upgrade to metal roofing,
/// +€4,200" or "Deduct-alt: laminate instead of hardwood, -€1,800" — offered alongside the base
/// bid during pre-award value engineering. Deliberately distinct from Estimate's own
/// variantOf/variants pair: a variant is a whole competing estimate (its own sections/lines/total,
/// e.g. "Basic" vs "Premium" packages), while an alternate is a single priced line item the client
/// can accept or reject within the one estimate they're already reviewing. amount is a delta
/// (positive for an add, negative for a deduct), not a new grand total — accepting one is a
/// bookkeeping decision recorded here, not a change to the base estimate's own calculated totals.
model EstimateAlternate {
  id          String                  @id @default(uuid())
  companyId   String
  estimateId  String
  title       String
  description String?
  amount      Decimal                 @db.Decimal(14, 2)
  status      EstimateAlternateStatus @default(pending)
  createdAt   DateTime                @default(now())
  decidedAt   DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([estimateId])
  @@map("estimate_alternates")
}

/// One row per person who has signed off on a high-value estimate — see Company.approvalThresholdAmount.
/// A given user can only appear once per estimate (the unique constraint doubles as the "already approved" check).
model EstimateApproval {
  id         String   @id @default(uuid())
  estimateId String
  userId     String
  actorName  String
  approvedAt DateTime @default(now())

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@unique([estimateId, userId])
  @@index([estimateId])
  @@map("estimate_approvals")
}

/// A formal addendum to an already-approved Estimate — extra scope proposed after the
/// original contract, with its own internal approval and client sign-off, so the original
/// approved document stays an untouched record of what was first agreed. Reuses Estimate's
/// own status/decision enums since the workflow (draft -> approved -> sent -> client decides)
/// is identical in shape, just scoped to one estimate's addenda instead of the whole quote.
model ChangeOrder {
  id          String         @id @default(uuid())
  companyId   String
  estimateId  String
  /// Sequential per estimate (CO-1, CO-2, ...), not globally — see @@unique below.
  number      Int
  title       String
  description String?
  status      EstimateStatus @default(draft)

  materialsCostTotal Decimal @default(0) @db.Decimal(14, 2)
  laborCostTotal     Decimal @default(0) @db.Decimal(14, 2)
  subtotal           Decimal @default(0) @db.Decimal(14, 2)
  markupAmount       Decimal @default(0) @db.Decimal(14, 2)
  taxAmount          Decimal @default(0) @db.Decimal(14, 2)
  grandTotal         Decimal @default(0) @db.Decimal(14, 2)

  clientDecision     EstimateClientDecision @default(pending)
  sentAt             DateTime?
  decisionAt         DateTime?
  clientDecisionNote String?
  clientAccessToken  String?                @unique
  signerName         String?
  signatureImageKey  String?
  signedIp           String?

  /// Same shape as Estimate.reminderCount/lastReminderSentAt — ChangeOrderRemindersService's
  /// escalating cadence, capped and self-clearing the same way once clientDecision leaves "pending".
  reminderCount      Int       @default(0)
  lastReminderSentAt DateTime?
  /// Calendar-day extension this change order adds to (positive) or pulls into (negative) the
  /// project schedule — entered by whoever raises the CO, since it isn't derivable from cost lines
  /// alone. Null means no schedule impact has been assessed yet.
  scheduleImpactDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  estimate             Estimate              @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  lines                ChangeOrderLine[]
  approvals            ChangeOrderApproval[]
  clientChangeRequest  ClientChangeRequest?
  linkedRfis           Rfi[]
  linkedPunchListItems PunchListItem[]

  @@unique([estimateId, number])
  @@index([companyId])
  @@index([estimateId])
  @@map("change_orders")
}

/// Same multi-approver-chain shape as EstimateApproval, gated by
/// Company.changeOrderApprovalThresholdAmount instead of the estimate one.
model ChangeOrderApproval {
  id            String   @id @default(uuid())
  changeOrderId String
  userId        String
  actorName     String
  approvedAt    DateTime @default(now())

  changeOrder ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)

  @@unique([changeOrderId, userId])
  @@index([changeOrderId])
  @@map("change_order_approvals")
}

model ChangeOrderLine {
  id                String  @id @default(uuid())
  changeOrderId     String
  rateCatalogItemId String
  quantity          Decimal @db.Decimal(12, 4)
  materialsCost     Decimal @default(0) @db.Decimal(14, 2)
  laborCost         Decimal @default(0) @db.Decimal(14, 2)
  lineTotal         Decimal @default(0) @db.Decimal(14, 2)
  sortOrder         Int     @default(0)
  /// Optional CSI cost code, for job-costing/schedule-of-values roll-ups — see JobCostingService.
  costCodeId        String?

  changeOrder     ChangeOrder     @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  rateCatalogItem RateCatalogItem @relation(fields: [rateCatalogItemId], references: [id])
  costCode        CostCode?       @relation(fields: [costCodeId], references: [id], onDelete: SetNull)

  @@index([changeOrderId])
  @@index([costCodeId])
  @@map("change_order_lines")
}

enum ClientChangeRequestStatus {
  submitted
  under_review
  converted
  declined
}

/// A change/scope request the client originates themselves through the portal — distinct from
/// ChangeOrder, which the GC always creates. Triaged by the GC into either a real ChangeOrder
/// (convertedChangeOrderId set, status=converted) or declined with a note; the request itself
/// stays as the auditable record of what the client asked for and when.
model ClientChangeRequest {
  id                     String                    @id @default(uuid())
  companyId              String
  projectId              String
  submittedByClientId    String
  submittedByName        String
  title                  String
  description            String
  status                 ClientChangeRequestStatus @default(submitted)
  reviewNote             String?
  convertedChangeOrderId String?                   @unique
  reviewedByName         String?
  reviewedAt             DateTime?
  createdAt              DateTime                  @default(now())

  company              Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project              Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedByClient    Client       @relation(fields: [submittedByClientId], references: [id], onDelete: Cascade)
  convertedChangeOrder ChangeOrder? @relation(fields: [convertedChangeOrderId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@index([submittedByClientId])
  @@map("client_change_requests")
}

enum MarkupCostType {
  materials
  labor
}

/// A company-wide markup override by cost type — when present for "materials" or "labor", a
/// change order's markup on that portion of the subtotal uses this rate instead of the parent
/// Estimate's single flat markupPercent (see ChangeOrdersService.recompute / tiered-markup.ts).
/// One rule per cost type; a cost type with no rule keeps using the flat estimate percentage.
model MarkupRule {
  id            String         @id @default(uuid())
  companyId     String
  costType      MarkupCostType
  markupPercent Decimal        @db.Decimal(5, 2)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, costType])
  @@index([companyId])
  @@map("markup_rules")
}

/// Immutable, fully denormalized snapshot of an estimate's state at approval
/// time — captures rate item names/codes directly (not just FK references) so
/// history stays accurate even if the catalog changes or an item is deleted later.
model EstimateRevision {
  id            String @id @default(uuid())
  estimateId    String
  versionNumber Int
  name          String

  laborRatePerHour Decimal @db.Decimal(10, 2)
  markupPercent    Decimal @db.Decimal(5, 2)
  taxPercent       Decimal @db.Decimal(5, 2)

  materialsCostTotal Decimal @db.Decimal(14, 2)
  laborCostTotal     Decimal @db.Decimal(14, 2)
  subtotal           Decimal @db.Decimal(14, 2)
  markupAmount       Decimal @db.Decimal(14, 2)
  taxAmount          Decimal @db.Decimal(14, 2)
  grandTotal         Decimal @db.Decimal(14, 2)

  /// EstimateRevisionLineSnapshot[]: { rateCatalogItemCode, rateCatalogItemName, unit, quantity, materialsCost, laborCost, lineTotal }
  lines Json

  createdAt DateTime @default(now())

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
  @@map("estimate_revisions")
}

model EstimateSection {
  id         String @id @default(uuid())
  estimateId String
  name       String
  sortOrder  Int    @default(0)

  estimate Estimate       @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  lines    EstimateLine[]

  @@index([estimateId])
  @@map("estimate_sections")
}

model EstimateLine {
  id                String  @id @default(uuid())
  estimateId        String
  sectionId         String?
  rateCatalogItemId String
  quantity          Decimal @db.Decimal(12, 4)
  materialsCost     Decimal @default(0) @db.Decimal(14, 2)
  laborCost         Decimal @default(0) @db.Decimal(14, 2)
  lineTotal         Decimal @default(0) @db.Decimal(14, 2)
  sortOrder         Int     @default(0)
  /// Optional CSI cost code, for job-costing/schedule-of-values roll-ups — see JobCostingService.
  costCodeId        String?

  estimate        Estimate         @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  section         EstimateSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  rateCatalogItem RateCatalogItem  @relation(fields: [rateCatalogItemId], references: [id], onDelete: Restrict)
  costCode        CostCode?        @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  tasks           Task[]
  stockMovements  StockMovement[]

  @@index([estimateId])
  @@index([costCodeId])
  @@map("estimate_lines")
}

/// Snapshot of the material requirement list generated when an estimate is approved.
model EstimateMaterialRequirement {
  id                    String  @id @default(uuid())
  estimateId            String
  materialCatalogItemId String
  quantity              Decimal @db.Decimal(14, 4)
  unit                  String

  estimate            Estimate            @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  materialCatalogItem MaterialCatalogItem @relation(fields: [materialCatalogItemId], references: [id], onDelete: Restrict)

  @@unique([estimateId, materialCatalogItemId])
  @@index([estimateId])
  @@map("estimate_material_requirements")
}

// ---------- Materials & Inventory (schema-only until Phase 2, except MaterialCatalogItem above) ----------

model Warehouse {
  id        String  @id @default(uuid())
  companyId String
  name      String
  address   String?

  company                Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockLevels            StockLevel[]
  stockMovements         StockMovement[]
  incomingTransfers      StockMovement[]      @relation("TransferDestination")
  stockCounts            StockCount[]
  costLayers             InventoryCostLayer[]
  outgoingStockTransfers StockTransfer[]      @relation("StockTransferFrom")
  incomingStockTransfers StockTransfer[]      @relation("StockTransferTo")

  @@index([companyId])
  @@map("warehouses")
}

model StockLevel {
  id                    String   @id @default(uuid())
  warehouseId           String
  materialCatalogItemId String
  quantityOnHand        Decimal  @default(0) @db.Decimal(14, 4)
  /// Free-text aisle/shelf/bin within this warehouse — per warehouse+item since the same material
  /// can sit in a different spot at each location. Null means not yet assigned a location.
  binLocation           String?
  /// Running weighted-average unit cost, blended in on every receipt that carries a unitCost —
  /// see calculateWeightedAverageCost. Null until the first costed receipt. Maintained regardless
  /// of Company.inventoryCostingMethod (cheap to keep, and lets a company switch method without
  /// losing this history), but only actually used to cost issues under weighted_average.
  averageCost           Decimal? @db.Decimal(12, 4)

  warehouse           Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  materialCatalogItem MaterialCatalogItem @relation(fields: [materialCatalogItemId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, materialCatalogItemId])
  @@map("stock_levels")
}

model StockMovement {
  id                    String            @id @default(uuid())
  companyId             String
  warehouseId           String
  /// Only set for type=transfer — the destination warehouse credited alongside
  /// the source warehouseId being debited, both recorded as one movement row.
  toWarehouseId         String?
  materialCatalogItemId String
  type                  StockMovementType
  quantity              Decimal           @db.Decimal(14, 4)
  projectId             String?
  estimateLineId        String?
  createdAt             DateTime          @default(now())
  /// For type=receipt: the cost per unit entered when recording it (optional — a receipt with no
  /// cost doesn't move averageCost/cost layers). For type=issue/write_off/transfer: the per-unit
  /// cost the costing engine (FIFO or weighted-average) charged this movement, computed at record
  /// time — see inventory-costing.ts. Null when this movement carried/produced no cost data.
  unitCost              Decimal?          @db.Decimal(12, 4)

  warehouse           Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  toWarehouse         Warehouse?          @relation("TransferDestination", fields: [toWarehouseId], references: [id], onDelete: Cascade)
  materialCatalogItem MaterialCatalogItem @relation(fields: [materialCatalogItemId], references: [id], onDelete: Restrict)
  project             Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  estimateLine        EstimateLine?       @relation(fields: [estimateLineId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([warehouseId])
  @@index([toWarehouseId])
  @@map("stock_movements")
}

/// One FIFO cost lot: created by a costed receipt, consumed oldest-first by later issues/write-offs/
/// transfers-out at this warehouse (see calculateFifoConsumption). Only populated/consulted when
/// Company.inventoryCostingMethod is "fifo" — a company on weighted_average never creates or reads
/// these, so switching a company onto fifo later starts with an empty cost history for existing stock.
model InventoryCostLayer {
  id                    String   @id @default(uuid())
  companyId             String
  warehouseId           String
  materialCatalogItemId String
  remainingQuantity     Decimal  @db.Decimal(14, 4)
  unitCost              Decimal  @db.Decimal(12, 4)
  receivedAt            DateTime @default(now())

  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse           Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  materialCatalogItem MaterialCatalogItem @relation(fields: [materialCatalogItemId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([warehouseId, materialCatalogItemId, receivedAt])
  @@map("inventory_cost_layers")
}

/// A warehouse-to-warehouse transfer that tracks goods while in transit, as opposed to
/// StockService.transferStock()'s instant same-moment transfer — for transfers that take real
/// time (a truck run between yards in different cities) where the goods shouldn't count as stock
/// at either warehouse while en route. unitCost is captured from the source's costing engine at
/// initiate() and carried forward to credit the destination at the same cost on receive(), so the
/// transfer doesn't invent or reset a cost basis mid-transit.
model StockTransfer {
  id                    String              @id @default(uuid())
  companyId             String
  fromWarehouseId       String
  toWarehouseId         String
  materialCatalogItemId String
  quantity              Decimal             @db.Decimal(14, 4)
  unitCost              Decimal?            @db.Decimal(12, 4)
  status                StockTransferStatus @default(in_transit)
  initiatedByName       String
  initiatedAt           DateTime            @default(now())
  receivedByName        String?
  receivedAt            DateTime?
  cancelledAt           DateTime?

  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromWarehouse       Warehouse           @relation("StockTransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Cascade)
  toWarehouse         Warehouse           @relation("StockTransferTo", fields: [toWarehouseId], references: [id], onDelete: Cascade)
  materialCatalogItem MaterialCatalogItem @relation(fields: [materialCatalogItemId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@map("stock_transfers")
}

enum StockCountStatus {
  draft
  finalized
}

/// A physical inventory count for one warehouse. Lines snapshot the system
/// quantity at count-start time so variance stays meaningful even if other
/// movements happen while the count is still in progress. Finalizing applies
/// each line's variance as an ordinary receipt/write_off StockMovement —
/// reusing the existing movement machinery rather than a parallel one.
model StockCount {
  id          String           @id @default(uuid())
  companyId   String
  warehouseId String
  status      StockCountStatus @default(draft)
  createdAt   DateTime         @default(now())
  finalizedAt DateTime?

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  lines     StockCountLine[]

  @@index([companyId])
  @@index([warehouseId])
  @@map("stock_counts")
}

model StockCountLine {
  id                    String  @id @default(uuid())
  stockCountId          String
  materialCatalogItemId String
  /// Snapshot of StockLevel.quantityOnHand when the count line was created.
  systemQuantity        Decimal @db.Decimal(14, 4)
  /// Defaults to systemQuantity until staff overwrite it with what they physically counted.
  countedQuantity       Decimal @db.Decimal(14, 4)

  stockCount          StockCount          @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  materialCatalogItem MaterialCatalogItem @relation(fields: [materialCatalogItemId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, materialCatalogItemId])
  @@index([stockCountId])
  @@map("stock_count_lines")
}

model Supplier {
  id        String  @id @default(uuid())
  companyId String
  name      String
  email     String?
  phone     String?

  company                     Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrders              PurchaseOrder[]
  preferredForItems           MaterialCatalogItem[]
  rfqQuotes                   MaterialRfqQuote[]
  equipmentMaintenanceRecords EquipmentMaintenanceRecord[]
  equipmentFuelLogs           EquipmentFuelLog[]
  documents                   SupplierDocument[]
  reviews                     SupplierReview[]
  portalLoginTokens           SupplierPortalLoginToken[]
  vendorBills                 VendorBill[]
  longLeadItems               LongLeadItem[]

  @@unique([id, companyId])
  @@index([companyId])
  @@map("suppliers")
}

enum SupplierDocumentType {
  general_liability_insurance
  workers_comp_insurance
  other
}

/// An insurance certificate on file for a material supplier — same shape and expiry-tracking
/// purpose as SubcontractorDocument, but deliberately not a hard gate on anything (unlike
/// SubcontractorsService.assertCompliant()): a supplier just ships materials, it doesn't put
/// workers on this company's job sites, so there's no analogous site-safety reason to block on it.
model SupplierDocument {
  id         String               @id @default(uuid())
  companyId  String
  supplierId String
  type       SupplierDocumentType
  name       String
  expiresAt  DateTime
  createdAt  DateTime             @default(now())

  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier    Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  attachments Document[]

  @@index([companyId])
  @@index([supplierId])
  @@map("supplier_documents")
}

enum CompanyDocumentType {
  general_liability_insurance
  workers_comp_insurance
  umbrella_insurance
  builders_risk_insurance
  other
}

/// The GC's own insurance certificates (as opposed to SubcontractorDocument/SupplierDocument,
/// which track other parties' coverage) — same type/name/expiresAt shape, tracked so a client or
/// lender can be handed a current certificate on demand via the public COI link
/// (Company.coiPublicToken/coiPubliclyShared) rather than someone digging up a PDF by email.
model CompanyDocument {
  id        String              @id @default(uuid())
  companyId String
  type      CompanyDocumentType
  name      String
  expiresAt DateTime
  createdAt DateTime            @default(now())

  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attachments Document[]

  @@index([companyId])
  @@map("company_documents")
}

/// A manual, qualitative rating for a supplier — complements SuppliersService.scorecard(), which
/// is entirely derived from PurchaseOrder timing/spend data and has no room for "would we order
/// from them again" or a subjective 1-5. Same rating/comments shape as
/// SubcontractorPerformanceReview, minus the fields that only make sense for a sub with a crew on
/// site (safetyIncidents, reworkCount).
model SupplierReview {
  id               String   @id @default(uuid())
  companyId        String
  supplierId       String
  reviewedByUserId String?
  reviewedByName   String
  /// Overall 1-5 rating.
  rating           Int
  wouldReorder     Boolean?
  comments         String?
  createdAt        DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([supplierId])
  @@map("supplier_reviews")
}

enum MaterialRfqStatus {
  open
  closed
}

/// A request-for-quote for a material list — the office records what each invited supplier
/// quoted (per line, since one supplier can beat another on some materials but not others) and
/// compares them side by side. Deliberately internal-only (no supplier self-service portal, unlike
/// BidRequest's subcontractor-portal submission flow) — quotes typically arrive by phone/email and
/// get keyed in, which is the actual workflow this is meant to speed up.
model MaterialRfq {
  id        String            @id @default(uuid())
  companyId String
  projectId String?
  title     String
  dueDate   DateTime?
  status    MaterialRfqStatus @default(open)
  createdAt DateTime          @default(now())

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lines   MaterialRfqLine[]

  @@index([companyId])
  @@index([projectId])
  @@map("material_rfqs")
}

model MaterialRfqLine {
  id                    String  @id @default(uuid())
  rfqId                 String
  materialCatalogItemId String
  quantity              Decimal @db.Decimal(14, 4)

  rfq                 MaterialRfq         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  materialCatalogItem MaterialCatalogItem @relation(fields: [materialCatalogItemId], references: [id], onDelete: Restrict)
  quotes              MaterialRfqQuote[]

  @@index([rfqId])
  @@map("material_rfq_lines")
}

/// One supplier's quoted unit price for one RFQ line. isAwarded marks the winner for that line
/// specifically — awarding is per-line, not per-RFQ, since the cheapest supplier can differ by material.
model MaterialRfqQuote {
  id          String   @id @default(uuid())
  rfqLineId   String
  supplierId  String
  unitPrice   Decimal  @db.Decimal(12, 4)
  notes       String?
  isAwarded   Boolean  @default(false)
  submittedAt DateTime @default(now())

  rfqLine  MaterialRfqLine @relation(fields: [rfqLineId], references: [id], onDelete: Cascade)
  supplier Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([rfqLineId, supplierId])
  @@index([supplierId])
  @@map("material_rfq_quotes")
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  companyId      String
  supplierId     String
  status         PurchaseOrderStatus @default(draft)
  /// True when created by the low-stock processor rather than a person — surfaced
  /// in the UI as a nudge to review quantities/pricing before ordering.
  autoGenerated  Boolean             @default(false)
  /// When the supplier is expected to deliver/be paid — feeds the cash-flow forecast's outflow buckets.
  expectedDate   DateTime?
  receivedAt     DateTime?
  createdAt      DateTime            @default(now())
  /// Set when the supplier confirms the order from their own portal — independent of internal
  /// status (a PO can be "ordered" and separately "acknowledged" by the vendor).
  acknowledgedAt DateTime?
  /// Supplier's own delivery estimate, which may differ from the internally-set expectedDate.
  supplierEta    DateTime?
  supplierNote   String?

  /// Composite FK (not just supplierId) so the DB rejects a PO pointing at a supplier belonging
  /// to a different company — see AUDIT-2026-09-07.md "составные FK".
  supplier               Supplier               @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict)
  lines                  PurchaseOrderLine[]
  vendorBills            VendorBill[]
  receivingDiscrepancies ReceivingDiscrepancy[]
  longLeadItems          LongLeadItem[]

  @@index([companyId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                    String  @id @default(uuid())
  purchaseOrderId       String
  materialCatalogItemId String
  quantity              Decimal @db.Decimal(14, 4)
  unitPrice             Decimal @db.Decimal(12, 4)
  /// Cumulative good (non-damaged) quantity received against this line so far — a partial
  /// shipment adds to this rather than replacing it, so multiple receiving passes (backorders
  /// arriving later) accumulate correctly. Compared against `quantity` to tell whether the line
  /// is fully received.
  quantityReceived      Decimal @default(0) @db.Decimal(14, 4)

  purchaseOrder          PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  materialCatalogItem    MaterialCatalogItem    @relation(fields: [materialCatalogItemId], references: [id], onDelete: Restrict)
  receivingDiscrepancies ReceivingDiscrepancy[]

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

enum ReceivingDiscrepancyType {
  short_ship
  over_ship
  damaged
  backorder
}

enum ReceivingDiscrepancyResolution {
  pending
  credit_issued
  replacement_sent
  disputed
}

/// Flagged automatically when a receiving pass (PurchaseOrdersService.receiveShipment) logs a
/// received quantity that doesn't match what was ordered, or any damaged quantity — the queue the
/// purchasing team works through to get a credit, replacement, or dispute the vendor bill over.
model ReceivingDiscrepancy {
  id                  String                         @id @default(uuid())
  companyId           String
  purchaseOrderId     String
  purchaseOrderLineId String
  type                ReceivingDiscrepancyType
  quantity            Decimal                        @db.Decimal(14, 4)
  resolution          ReceivingDiscrepancyResolution @default(pending)
  resolutionNotes     String?
  createdAt           DateTime                       @default(now())

  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrder     PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  photos            Document[]

  @@index([companyId])
  @@index([purchaseOrderId])
  @@index([purchaseOrderLineId])
  @@map("receiving_discrepancies")
}

enum VendorBillStatus {
  draft
  approved
  paid
}

/// A supplier invoice for materials or services — the AP-side counterpart to the AR-side
/// Invoice/InvoiceLine. When purchaseOrderId is set, VendorBillsService.matchStatus() 3-way
/// matches this bill's line quantities/prices (by materialCatalogItemId) against what the PO
/// ordered, so a variance is caught before the bill is approved for payment; a bill with no PO
/// (e.g. a one-off service invoice) skips matching entirely.
model VendorBill {
  id                   String           @id @default(uuid())
  companyId            String
  supplierId           String
  purchaseOrderId      String?
  billNumber           String
  billDate             DateTime         @default(now())
  dueDate              DateTime?
  status               VendorBillStatus @default(draft)
  approvedAt           DateTime?
  approvedByName       String?
  /// When the office plans to actually pay this bill — independent of the vendor's own dueDate,
  /// which is a contractual term, not a payment-run decision. Only meaningful pre-payment; set via
  /// schedulePayment(), feeding the disbursement calendar.
  scheduledPaymentDate DateTime?
  paidAt               DateTime?
  notes                String?
  createdAt            DateTime         @default(now())

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier      Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  lines         VendorBillLine[]

  @@index([companyId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@map("vendor_bills")
}

model VendorBillLine {
  id                    String  @id @default(uuid())
  vendorBillId          String
  materialCatalogItemId String?
  description           String
  quantity              Decimal @db.Decimal(14, 4)
  unitPrice             Decimal @db.Decimal(12, 4)

  vendorBill          VendorBill           @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  materialCatalogItem MaterialCatalogItem? @relation(fields: [materialCatalogItemId], references: [id], onDelete: SetNull)

  @@index([vendorBillId])
  @@map("vendor_bill_lines")
}

// ---------- Projects (thin in Phase 1; Scheduling schema-only until Phase 3) ----------

model Project {
  id                          String    @id @default(uuid())
  companyId                   String
  name                        String
  address                     String?
  clientId                    String?
  createdAt                   DateTime  @default(now())
  /// When the finished project was handed over to the client — the anchor date for the warranty window.
  handoverDate                DateTime?
  /// Warranty length in months from handoverDate; null means no warranty is configured yet.
  warrantyMonths              Int?
  /// Set when a review-request email has been sent to the client — null means never sent, and
  /// the UI uses this to avoid nagging the client twice for the same project.
  reviewRequestedAt           DateTime?
  /// Site geofence center + radius for field-app clock-in proximity checks — all three null
  /// disables the check entirely (TimeEntry.withinGeofence stays null for this project's entries).
  geofenceLat                 Float?
  geofenceLng                 Float?
  geofenceRadiusMeters        Int?
  /// When true, only members listed in ProjectMember (plus owner/admin, who always see
  /// everything) can see this project — false (the default) means visible to the whole company,
  /// same as before this field existed.
  restrictedToMembers         Boolean   @default(false)
  /// Marks a government-funded contract subject to prevailing-wage rules — surfaces the
  /// Certified Payroll panel on the project and is printed on the WH-347-style report header.
  isPublicWork                Boolean   @default(false)
  /// Awarding-body contract number, printed on certified payroll reports. Free text since the
  /// format varies by agency.
  contractNumber              String?
  /// Bills this project in a currency other than the company's default (e.g. a EUR-based company
  /// running one CAD-denominated job) — null means "use the company's currency", unchanged
  /// behavior. Estimate/Invoice snapshot their own `currency` from this at creation time, so an
  /// override change here never retroactively changes an already-issued document.
  currency                    Currency?
  /// Overrides Company.budgetAlertThresholdPercent for this project only — null means use the
  /// company default.
  budgetAlertThresholdPercent Int?
  /// Total reserve set aside for unforeseen costs on this project, distinct from the markup/margin
  /// already baked into estimate pricing — null means no contingency fund tracked. Remaining
  /// balance is computed live as this minus the sum of ContingencyDraw.amount, never stored.
  contingencyAmount           Decimal?  @db.Decimal(14, 2)

  company                     Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client                      Client?                      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  estimates                   Estimate[]
  invoices                    Invoice[]
  recurringInvoices           RecurringInvoice[]
  tasks                       Task[]
  milestones                  Milestone[]
  stockMovements              StockMovement[]
  timeEntries                 TimeEntry[]
  expenses                    Expense[]
  documents                   Document[]
  subcontractorCosts          SubcontractorCost[]
  equipmentAssignments        EquipmentAssignment[]
  subcontractorAssignments    SubcontractorAssignment[]
  dailyLogs                   DailyLog[]
  punchListItems              PunchListItem[]
  rfis                        Rfi[]
  incidentReports             IncidentReport[]
  insuranceClaims             InsuranceClaim[]
  safetyBriefings             SafetyBriefing[]
  jobHazardAnalyses           JobHazardAnalysis[]
  submittals                  Submittal[]
  warrantyClaims              WarrantyClaim[]
  resourceAssignments         ResourceAssignment[]
  lienWaivers                 LienWaiver[]
  drawRequests                DrawRequest[]
  takeoffs                    Takeoff[]
  greenCertifications         ProjectGreenCertification[]
  portalMessages              PortalMessage[]
  bidRequests                 BidRequest[]
  materialRfqs                MaterialRfq[]
  serviceContracts            ServiceContract[]
  inspectionChecklists        InspectionChecklist[]
  deficiencies                Deficiency[]
  comments                    Comment[]
  members                     ProjectMember[]
  contracts                   Contract[]
  certifiedPayrollReports     CertifiedPayrollReport[]
  drawingSheets               DrawingSheet[]
  permits                     Permit[]
  npsSurveys                  NpsSurvey[]
  crewSmsBroadcasts           CrewSmsBroadcast[]
  siteSignIns                 SiteSignIn[]
  budgetRevisions             BudgetRevision[]
  contingencyDraws            ContingencyDraw[]
  suretyBonds                 SuretyBond[]
  contractClaims              ContractClaim[]
  supportTickets              SupportTicket[]
  warrantyRegistrations       WarrantyRegistration[]
  hazmatInventory             ProjectHazmatInventory[]
  lienNotices                 LienNotice[]
  mechanicsLienFilings        MechanicsLienFiling[]
  toolCheckouts               ToolCheckout[]
  stormwaterPermits           StormwaterPermit[]
  environmentalIncidents      EnvironmentalIncident[]
  scheduleScenarios           ScheduleScenario[]
  commissioningSystems        CommissioningSystem[]
  progressEstimates           ProgressEstimate[]
  transmittals                Transmittal[]
  concretePours               ConcretePour[]
  allowances                  Allowance[]
  unitPriceItems              UnitPriceItem[]
  tmTickets                   TMTicket[]
  productivityLogs            ProductivityLog[]
  subcontractorBackcharges    SubcontractorBackcharge[]
  subcontractorDefaultNotices SubcontractorDefaultNotice[]
  clientChangeRequests        ClientChangeRequest[]
  safetyObservations          SafetyObservation[]
  scheduleBaselines           ScheduleBaseline[]
  meetings                    Meeting[]
  longLeadItems               LongLeadItem[]
  costCodeBudgetTransfers     CostCodeBudgetTransfer[]

  @@unique([id, companyId])
  @@index([companyId])
  @@map("projects")
}

enum ContractClaimType {
  delay
  differing_conditions
  scope_dispute
  other
}

enum ContractClaimStatus {
  notice_given
  submitted
  negotiating
  resolved
  rejected
}

/// A formal contractual claim (delay, differing site conditions, scope dispute) — distinct from
/// ChangeOrder, which is for scope changes both parties have already agreed to. Most construction
/// contracts require a documented notice-and-evidence trail before a claim can be pursued, which
/// is what ContractClaimEvent's timeline is for.
model ContractClaim {
  id              String              @id @default(uuid())
  companyId       String
  projectId       String
  type            ContractClaimType
  title           String
  description     String?
  noticeDate      DateTime
  requestedAmount Decimal?            @db.Decimal(14, 2)
  requestedDays   Int?
  status          ContractClaimStatus @default(notice_given)
  resolution      String?
  resolvedAt      DateTime?
  createdAt       DateTime            @default(now())

  company Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events  ContractClaimEvent[]

  @@index([companyId])
  @@index([projectId])
  @@map("contract_claims")
}

/// One timeline entry in a claim's notice-and-documentation trail (notice served, evidence
/// submitted, response received, negotiation meeting, etc.) — same append-only journal shape as
/// DailyLog, but scoped to a single claim.
model ContractClaimEvent {
  id            String   @id @default(uuid())
  companyId     String
  claimId       String
  description   String
  occurredAt    DateTime @default(now())
  createdByName String
  createdAt     DateTime @default(now())

  claim ContractClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([claimId])
  @@map("contract_claim_events")
}

/// Client satisfaction survey (NPS: 0-10) sent once per project, mirroring
/// Project.reviewRequestedAt's "manual button, once per project" pattern rather than an
/// automatic trigger — there's no project "closed" status to hook into, so a PM sends it
/// explicitly from the closeout flow. token is the unauthenticated link the client uses; unlike
/// ServiceVisit.satisfactionRating (1-5 stars, per visit) this is the standard 0-10 NPS scale
/// (promoter 9-10 / passive 7-8 / detractor 0-6), aggregated company-wide for a trend view.
model NpsSurvey {
  id          String    @id @default(uuid())
  companyId   String
  projectId   String
  token       String    @unique
  sentAt      DateTime  @default(now())
  score       Int?
  comment     String?
  respondedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@map("nps_surveys")
}

/// A one-way mass SMS sent to every crew member currently assigned to a project (or, when
/// projectId is null, every active Worker in the company) — distinct from SmsWebhooksService's
/// two-way per-task status texts. No reply is expected; recipientCount is a snapshot taken at
/// send time so the log stays accurate even if assignments change afterward.
model CrewSmsBroadcast {
  id             String   @id @default(uuid())
  companyId      String
  projectId      String?
  message        String
  recipientCount Int
  sentByUserId   String?
  sentByName     String
  createdAt      DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@map("crew_sms_broadcasts")
}

/// A company's override of one hard-coded message body (see MESSAGE_TEMPLATE_KEYS in
/// @cantero/shared) — e.g. the task-assignment SMS or the NPS survey email. body holds
/// {{placeholder}} tokens substituted at send time; unlike smsTemplates.ts's per-locale
/// translations, an override is a single body applied regardless of the recipient's locale — a
/// documented scope limit, not an oversight, since per-locale custom text would be a much bigger
/// editor. No row for a key means the built-in template still applies.
model MessageTemplate {
  id              String   @id @default(uuid())
  companyId       String
  key             String
  body            String
  updatedByUserId String?
  updatedByName   String
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@map("message_templates")
}

/// A visitor/subcontractor/inspector sign-in for a project's site roster — distinct from
/// TimeEntry (internal Worker hours) and SafetyBriefingAttendance (who attended one briefing).
/// signedOutAt null means still on site. Logged by whoever's running the site (foreman/PM) on
/// the visitor's behalf through the authenticated project routes — there's no self-serve kiosk
/// flow, same as DailyLog.
model SiteSignIn {
  id             String    @id @default(uuid())
  companyId      String
  projectId      String
  name           String
  visitorCompany String?
  purpose        String?
  signedInAt     DateTime  @default(now())
  signedOutAt    DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@map("site_sign_ins")
}

/// Quarterly internal "how likely are you to recommend working here" survey (0-10, standard NPS
/// scale) — the employee-side counterpart to NpsSurvey (client-facing). Sent by SMS, not email,
/// since Worker has no email field. workerId is kept on the row so the sender can dedupe/track
/// response rate, but the trend view (EnpsSurveysService.trend) only ever returns aggregate
/// numbers — no per-worker breakdown — so a respondent is never identifiable from the UI.
model EnpsSurvey {
  id          String    @id @default(uuid())
  companyId   String
  workerId    String
  token       String    @unique
  sentAt      DateTime  @default(now())
  score       Int?
  comment     String?
  respondedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([workerId])
  @@map("enps_surveys")
}

/// Opt-in per-project access list — only consulted when Project.restrictedToMembers is true.
model ProjectMember {
  id        String   @id @default(uuid())
  companyId String
  projectId String
  userId    String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([companyId])
  @@index([projectId])
  @@map("project_members")
}

model Task {
  id             String     @id @default(uuid())
  companyId      String
  projectId      String
  estimateLineId String?
  name           String
  status         TaskStatus @default(planned)
  startDate      DateTime?
  dueDate        DateTime?
  sortOrder      Int        @default(0)
  /// Marks work exposed to the elements (framing, roofing, concrete pour, etc.) so the
  /// weather-risk notification can flag it when the forecast for its startDate turns bad.
  isOutdoorWork  Boolean    @default(false)

  company             Company                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Composite FK (not just projectId) so the DB itself rejects a task pointing at a project
  /// belonging to a different company — see AUDIT-2026-09-07.md's "составные FK" recommendation.
  project             Project                        @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Cascade)
  estimateLine        EstimateLine?                  @relation(fields: [estimateLineId], references: [id], onDelete: SetNull)
  timeEntries         TimeEntry[]
  /// Dependencies where this task is the successor (i.e. what this task waits on).
  predecessorLinks    TaskDependency[]               @relation("TaskSuccessor")
  /// Dependencies where this task is the predecessor (i.e. what waits on this task).
  successorLinks      TaskDependency[]               @relation("TaskPredecessor")
  comments            Comment[]
  resourceAssignments ResourceAssignment[]
  jobHazardAnalyses   JobHazardAnalysis[]
  scenarioOverrides   ScheduleScenarioTaskOverride[]
  commitments         TaskCommitment[]

  @@index([companyId])
  @@index([projectId])
  @@map("tasks")
}

/// A saved snapshot of a project's schedule — typically taken at contract signing — that current
/// dates get compared against later to show slippage. Deliberately does NOT foreign-key to Task:
/// the snapshot must stay readable and meaningful even after the task it was taken from is later
/// deleted or renamed, so each row carries its own copy of name/startDate/dueDate rather than a
/// live join. taskId is kept as a plain (non-FK) reference purely to match a snapshot row back to
/// its current Task when one still exists with that id.
model ScheduleBaseline {
  id            String   @id @default(uuid())
  companyId     String
  projectId     String
  name          String
  createdByName String
  createdAt     DateTime @default(now())

  company Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   ScheduleBaselineTask[]

  @@index([companyId])
  @@index([projectId])
  @@map("schedule_baselines")
}

model ScheduleBaselineTask {
  id         String    @id @default(uuid())
  baselineId String
  taskId     String
  name       String
  startDate  DateTime?
  dueDate    DateTime?

  baseline ScheduleBaseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)

  @@index([baselineId])
  @@map("schedule_baseline_tasks")
}

enum TaskCommitmentStatus {
  committed
  completed
  missed
}

/// A weekly work-plan commitment for one task — the lean-construction "pull planning" unit that
/// PPC (percent plan complete) is measured against. Committing to a task for a given week is a
/// deliberate act distinct from just having a startDate; a task can be committed to in one week,
/// missed, and re-committed the next, each attempt its own row.
model TaskCommitment {
  id              String               @id @default(uuid())
  companyId       String
  taskId          String
  /// The Monday (or company convention) that starts the committed week — paired with taskId in
  /// the unique constraint so a task can't be double-committed for the same week.
  weekStarting    DateTime
  status          TaskCommitmentStatus @default(committed)
  /// Required when resolving as "missed" — the standard lean-construction variance-reason
  /// categories (e.g. "weather", "prior work not done", "material late") live in the shared
  /// TASK_COMMITMENT_VARIANCE_REASONS list, but this stays free text since a GC's real reasons
  /// rarely fit a fixed enum cleanly.
  varianceReason  String?
  committedByName String
  createdAt       DateTime             @default(now())
  resolvedAt      DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, weekStarting])
  @@index([companyId])
  @@index([taskId])
  @@map("task_commitments")
}

/// A hypothetical alternate schedule for a project — a named set of per-task date overrides that
/// can be compared against the real (baseline) Task dates via computeCriticalPath without
/// touching the live schedule. Applying a scenario (copying its overrides onto the real Task
/// rows) is a separate, explicit action; creating one never changes anything live.
model ScheduleScenario {
  id              String   @id @default(uuid())
  companyId       String
  projectId       String
  name            String
  createdAt       DateTime @default(now())
  createdByUserId String?

  company   Company                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  overrides ScheduleScenarioTaskOverride[]

  @@index([companyId])
  @@index([projectId])
  @@map("schedule_scenarios")
}

model ScheduleScenarioTaskOverride {
  id         String   @id @default(uuid())
  scenarioId String
  taskId     String
  startDate  DateTime
  dueDate    DateTime

  scenario ScheduleScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  task     Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, taskId])
  @@index([scenarioId])
  @@map("schedule_scenario_task_overrides")
}

enum TaskDependencyType {
  finish_to_start
  start_to_start
  finish_to_finish
  start_to_finish
}

/// A precedence link between two tasks in the same project — predecessor must satisfy the
/// constraint (offset by lagDays) before the successor can proceed. Powers auto date-shifting
/// and critical-path highlighting on the Gantt.
model TaskDependency {
  id            String             @id @default(uuid())
  predecessorId String
  successorId   String
  type          TaskDependencyType @default(finish_to_start)
  lagDays       Int                @default(0)

  predecessor Task @relation("TaskPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Task @relation("TaskSuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@map("task_dependencies")
}

model Milestone {
  id        String    @id @default(uuid())
  projectId String
  name      String
  dueDate   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("milestones")
}

/// One entry per project per calendar date — the standard site-diary convention (Procore et al.),
/// so a day's record is edited in place rather than accumulating duplicate entries.
model DailyLog {
  id                String            @id @default(uuid())
  companyId         String
  projectId         String
  date              DateTime
  authorUserId      String?
  authorName        String
  weatherCondition  WeatherCondition?
  weatherNotes      String?
  /// Structured hours of work lost to weather this day — distinct from the free-text `delays`
  /// field below, which covers any delay cause. Feeds the weather-delay report/export and the
  /// project's "shift schedule" action, so it needs to be a summable number, not prose.
  weatherDelayHours Decimal?          @db.Decimal(5, 2)
  crewCount         Int?
  crewNotes         String?
  workPerformed     String
  delays            String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User?      @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  photos  Document[]

  @@unique([projectId, date])
  @@index([companyId])
  @@map("daily_logs")
}

model PunchListItem {
  id                      String              @id @default(uuid())
  companyId               String
  projectId               String
  title                   String
  description             String?
  location                String?
  status                  PunchListItemStatus @default(open)
  assigneeWorkerId        String?
  /// Alternative to assigneeWorkerId — a punch list item belongs to whichever assignee is set,
  /// never both; nothing at the schema level stops both being set, same as
  /// Document's polymorphic attachment points.
  assigneeSubcontractorId String?
  dueDate                 DateTime?
  createdByUserId         String?
  createdByName           String
  resolvedAt              DateTime?
  resolvedByUserId        String?
  resolvedByName          String?
  verifiedAt              DateTime?
  verifiedByUserId        String?
  verifiedByName          String?
  createdAt               DateTime            @default(now())
  escalatedAt             DateTime?
  /// Optional pin location on a plan-room sheet — drawingSheetId set with pinX/pinY null (or vice
  /// versa) shouldn't happen but isn't enforced at the schema level, same as Document's attachment
  /// points above.
  drawingSheetId          String?
  pinX                    Float?
  pinY                    Float?
  /// Same dollar-estimate-then-confirm-via-CO pattern as Rfi.estimatedCostImpact/changeOrderId.
  estimatedCostImpact     Decimal?            @db.Decimal(14, 2)
  changeOrderId           String?

  company               Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project               Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee              Worker?                   @relation(fields: [assigneeWorkerId], references: [id], onDelete: SetNull)
  assigneeSubcontractor Subcontractor?            @relation(fields: [assigneeSubcontractorId], references: [id], onDelete: SetNull)
  drawingSheet          DrawingSheet?             @relation(fields: [drawingSheetId], references: [id], onDelete: SetNull)
  changeOrder           ChangeOrder?              @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)
  photos                Document[]
  comments              Comment[]
  backcharges           SubcontractorBackcharge[]

  @@index([projectId])
  @@index([companyId])
  @@index([assigneeSubcontractorId])
  @@index([changeOrderId])
  @@map("punch_list_items")
}

/// Formal question-and-answer thread between the field and the office/client, the standard
/// commercial-construction mechanism for resolving ambiguity in plans/specs that could affect
/// schedule or cost — closing without an answer is normal (the question was withdrawn or moot).
model Rfi {
  id                  String           @id @default(uuid())
  companyId           String
  projectId           String
  /// Human reference code, e.g. "RFI-001" — numbered per project, not globally.
  number              String
  subject             String
  question            String
  priority            RfiPriority      @default(medium)
  status              RfiStatus        @default(open)
  ballInCourtParty    BallInCourtParty @default(internal)
  dueDate             DateTime?
  costImpact          Boolean          @default(false)
  /// A dollar estimate of costImpact, entered independently of it (costImpact can be true with no
  /// estimate yet). Becomes "confirmed" once changeOrderId links to an actual priced change order.
  estimatedCostImpact Decimal?         @db.Decimal(14, 2)
  /// Set once a change order is raised as a consequence of this RFI — see RfiService.linkChangeOrder().
  changeOrderId       String?
  scheduleImpactDays  Int?
  askedByUserId       String?
  askedByName         String
  answer              String?
  answeredAt          DateTime?
  answeredByUserId    String?
  answeredByName      String?
  closedAt            DateTime?
  closedByUserId      String?
  closedByName        String?
  createdAt           DateTime         @default(now())
  escalatedAt         DateTime?
  /// Optional pin location on a plan-room sheet — see PunchListItem's identical fields.
  drawingSheetId      String?
  pinX                Float?
  pinY                Float?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  drawingSheet DrawingSheet? @relation(fields: [drawingSheetId], references: [id], onDelete: SetNull)
  changeOrder  ChangeOrder?  @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)
  comments     Comment[]
  documents    Document[]

  @@unique([projectId, number])
  @@index([companyId])
  @@index([changeOrderId])
  @@map("rfis")
}

// ---------- Finance (thin in Phase 1; Payments/budget-vs-actual in Phase 4) ----------

/// A manual log entry recording that a project's budget baseline moved — distinct from a
/// ChangeOrder (which is client-billed scope/price change) and from BudgetService's live
/// budget-vs-actual snapshot (which just compares approved-estimate totals against current
/// actuals with no memory of past baselines). This is purely an internal record of why/when
/// the target moved, e.g. "unforeseen site conditions, +5,000 EUR, approved internally."
model BudgetRevision {
  id              String   @id @default(uuid())
  companyId       String
  projectId       String
  /// Signed delta against the current budget baseline — positive increases it, negative reduces it.
  amount          Decimal  @db.Decimal(14, 2)
  reason          String
  createdByUserId String?
  createdByName   String
  createdAt       DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@map("budget_revisions")
}

/// A withdrawal against Project.contingencyAmount — logged when a change order, overrun, or
/// unforeseen cost is deliberately funded from the reserve instead of a fresh budget revision.
/// Same manual-log shape as BudgetRevision, kept as its own model since a contingency draw always
/// reduces the reserve (never negative/additive the way a budget revision can go either way).
model ContingencyDraw {
  id              String   @id @default(uuid())
  companyId       String
  projectId       String
  amount          Decimal  @db.Decimal(14, 2)
  reason          String
  createdByUserId String?
  createdByName   String
  createdAt       DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@map("contingency_draws")
}

model Invoice {
  id                         String        @id @default(uuid())
  companyId                  String
  projectId                  String
  clientId                   String
  estimateId                 String?
  /// Set when a RecurringInvoice's scheduled pass generated this invoice — null for everything else.
  recurringInvoiceId         String?
  /// Snapshot of RecurringInvoice.nextRunDate at the moment this invoice was generated — null for
  /// a non-recurring invoice. Paired with recurringInvoiceId in a unique constraint so a retried
  /// generation pass (e.g. after a crash between creating the invoice and advancing the schedule)
  /// can't produce two invoices for the same billing period.
  recurringBillingPeriod     DateTime?
  number                     String
  status                     InvoiceStatus @default(draft)
  subtotal                   Decimal       @db.Decimal(14, 2)
  taxAmount                  Decimal       @default(0) @db.Decimal(14, 2)
  total                      Decimal       @db.Decimal(14, 2)
  /// Snapshotted from the source estimate's currency (or `project.currency ?? company.currency`
  /// for an invoice with no estimate) at creation — see Estimate.currency.
  currency                   Currency      @default(EUR)
  dueDate                    DateTime?
  createdAt                  DateTime      @default(now())
  /// Cumulative % of the linked estimate billed as of this draw — set only on progress-billing
  /// invoices (see InvoicesService.generateProgressInvoice), null for ordinary invoices.
  percentComplete            Decimal?      @db.Decimal(5, 2)
  retainagePercent           Decimal?      @db.Decimal(5, 2)
  /// Amount withheld from this draw, held until releaseRetainage() generates a release invoice.
  retainageAmount            Decimal       @default(0) @db.Decimal(14, 2)
  /// True for the one-off invoice that pays out retainage withheld across prior progress draws.
  isRetainageRelease         Boolean       @default(false)
  /// Set once this invoice has been pushed to the connected accounting system (QuickBooks/Xero) —
  /// the external record's own ID, used to skip it on the next sync pass. Null means not yet synced.
  externalAccountingId       String?
  externalAccountingSyncedAt DateTime?
  /// Escalating overdue-reminder cadence (see InvoiceReminderService) — count of reminders sent
  /// so far (caps at the cadence's length) and when the last one went out.
  reminderCount              Int           @default(0)
  lastReminderSentAt         DateTime?
  /// Snapshotted from the client's own taxJurisdictionId at the moment TaxService.recalculateTax
  /// runs — kept independent of the client's current setting so an already-issued invoice's tax
  /// basis never silently shifts if the client's jurisdiction is edited later.
  taxJurisdictionId          String?
  /// Running total of every "Late fee" line ever charged on this invoice — subtracted back out of
  /// `total` when computing the principal balance a new late-fee accrual is based on, so charging
  /// a fee never compounds onto a previously-charged fee. See InvoicesService.computeLateFeeAccrued.
  lateFeeChargedTotal        Decimal       @default(0) @db.Decimal(14, 2)
  /// When the late-fee clock was last reset by an actual charge — null means it hasn't been
  /// charged yet, so accrual still starts from dueDate. Advancing this on every charge is what
  /// makes each charge cover only the time since the last one, not the whole overdue period again.
  lastLateFeeAccrualAt       DateTime?

  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Composite FKs (not just projectId/clientId) so the DB rejects an invoice pointing at a
  /// project or client belonging to a different company — see AUDIT-2026-09-07.md "составные FK".
  project          Project              @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Cascade)
  client           Client               @relation(fields: [clientId, companyId], references: [id, companyId], onDelete: Restrict)
  estimate         Estimate?            @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  recurringInvoice RecurringInvoice?    @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)
  taxJurisdiction  TaxJurisdiction?     @relation(fields: [taxJurisdictionId], references: [id], onDelete: SetNull)
  lines            InvoiceLine[]
  payments         Payment[]
  installments     InvoiceInstallment[]
  documents        Document[]
  bankTransactions BankTransaction[]
  drawRequest      DrawRequest?

  @@unique([companyId, number])
  @@unique([recurringInvoiceId, recurringBillingPeriod])
  @@index([companyId])
  @@index([taxJurisdictionId])
  @@map("invoices")
}

/// A billing template that generates a new draft Invoice on a schedule — for retainers
/// and ongoing contracts that don't start from a fresh Estimate each cycle. The scheduled
/// pass (RecurringInvoiceProcessor) always leaves the generated invoice as a draft so the
/// office reviews it before sending, same restraint as the low-stock auto-drafted POs.
model RecurringInvoice {
  id              String                    @id @default(uuid())
  companyId       String
  projectId       String
  clientId        String
  name            String
  frequency       RecurringInvoiceFrequency
  taxPercent      Decimal                   @default(0) @db.Decimal(5, 2)
  active          Boolean                   @default(true)
  /// Charges the client's saved card (Client.stripePaymentMethodId) immediately after each
  /// generated invoice is sent — off_session, so no client interaction is needed. Can only be
  /// turned on when the client already has a card on file; a declined charge just leaves the
  /// invoice "sent" for the normal reminder flow to chase, same as a manually-sent invoice.
  autopayEnabled  Boolean                   @default(false)
  startDate       DateTime
  /// The next date this template is due to generate an invoice; advanced by `frequency` after each run.
  nextRunDate     DateTime
  endDate         DateTime?
  lastGeneratedAt DateTime?
  createdAt       DateTime                  @default(now())

  company  Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project  Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client   Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lines    RecurringInvoiceLine[]
  invoices Invoice[]

  @@index([companyId])
  @@index([active, nextRunDate])
  @@map("recurring_invoices")
}

model RecurringInvoiceLine {
  id                 String  @id @default(uuid())
  recurringInvoiceId String
  description        String
  quantity           Decimal @db.Decimal(12, 4)
  unitPrice          Decimal @db.Decimal(12, 4)
  sortOrder          Int     @default(0)

  recurringInvoice RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)

  @@index([recurringInvoiceId])
  @@map("recurring_invoice_lines")
}

/// A planned installment on an invoice's payment schedule (e.g. "Deposit — 30%",
/// "On completion — 40%"). Purely a plan: actual money received is still recorded
/// as Payment rows and matched against installments client-side by running total,
/// so this never has to be reconciled against Payment as a hard foreign key.
model InvoiceInstallment {
  id        String    @id @default(uuid())
  invoiceId String
  label     String
  amount    Decimal   @db.Decimal(14, 2)
  dueDate   DateTime?
  sortOrder Int       @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_installments")
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(12, 4)
  unitPrice   Decimal @db.Decimal(12, 4)
  lineTotal   Decimal @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

/// A taxing authority (state/county/city or a country-level VAT/GST regime) this company bills
/// clients under. Deliberately just name + country + region — enough to pick the right rate and
/// label a filing, not a full address-validation/geocoding system.
model TaxJurisdiction {
  id        String   @id @default(uuid())
  companyId String
  name      String
  country   String
  region    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rates    TaxRate[]
  clients  Client[]
  invoices Invoice[]

  @@index([companyId])
  @@map("tax_jurisdictions")
}

/// One rate a jurisdiction charged over a date range — a new rate is added (not edited in place)
/// when a jurisdiction's rate changes, so TaxService.findActiveRate() can still compute the
/// correct historical rate for an invoice dated before the change. effectiveTo: null means still
/// current.
model TaxRate {
  id             String    @id @default(uuid())
  companyId      String
  jurisdictionId String
  ratePercent    Decimal   @db.Decimal(6, 3)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  createdAt      DateTime  @default(now())

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jurisdiction TaxJurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([jurisdictionId])
  @@map("tax_rates")
}

/// A client's on-file exemption certificate (government/nonprofit/resale) — while valid (not
/// expired as of the invoice date), TaxService.recalculateTax() zeroes the computed tax instead
/// of applying the jurisdiction's rate.
model TaxExemptionCertificate {
  id                String    @id @default(uuid())
  companyId         String
  clientId          String
  certificateNumber String
  reason            String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([clientId])
  @@map("tax_exemption_certificates")
}

model Payment {
  id            String    @id @default(uuid())
  invoiceId     String
  /// Always in the invoice's own currency — the amount actually credited against its balance.
  /// Equal to foreignAmount * exchangeRate when this was a foreign-currency settlement.
  amount        Decimal   @db.Decimal(14, 2)
  method        String
  paidAt        DateTime  @default(now())
  /// The remaining fields are null for an ordinary same-currency payment. Set together only when
  /// the client actually settled in a currency other than the invoice's — see FxSettlementService.
  /// currency: what the client paid in. foreignAmount: how much of it. exchangeRate: the rate
  /// actually used (e.g. the bank's wire rate) to arrive at `amount`. fxGainLoss: `amount` minus
  /// what foreignAmount would have converted to at the company's current benchmark rate for that
  /// pair at record time — frozen then, so a later benchmark-rate change never retroactively
  /// rewrites a past payment's gain/loss. Positive means the settlement beat the benchmark rate.
  currency      Currency?
  foreignAmount Decimal?  @db.Decimal(14, 2)
  exchangeRate  Decimal?  @db.Decimal(12, 6)
  fxGainLoss    Decimal?  @db.Decimal(14, 2)
  /// Stripe Checkout Session id for a payment recorded from BillingService's webhook — unique so
  /// a redelivered `checkout.session.completed` event (Stripe explicitly does not guarantee
  /// exactly-once delivery) can't record the same payment twice. Null for a manually-recorded
  /// (cash/check/ACH) payment.
  stripeCheckoutSessionId String? @unique

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

/// One row per line of an imported bank statement CSV — reconciliation is manual matching
/// against an Invoice (money in) or Expense (money out), since there's no live bank-feed
/// integration (no Plaid-style API key available) to auto-match against.
model BankTransaction {
  id               String           @id @default(uuid())
  companyId        String
  date             DateTime
  description      String
  amount           Decimal          @db.Decimal(14, 2)
  matchedInvoiceId String?
  matchedExpenseId String?
  reconciled       Boolean          @default(false)
  /// Set by BankReconciliationService.applyRules() matching a saved BankTransactionRule against
  /// `description`, or manually — independent of matchedInvoiceId/matchedExpenseId/reconciled,
  /// since a recurring operational transaction (rent, a software subscription) is categorized for
  /// bookkeeping without ever being "matched" to an Invoice or Expense record.
  category         ExpenseCategory?
  createdAt        DateTime         @default(now())

  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  matchedInvoice Invoice? @relation(fields: [matchedInvoiceId], references: [id], onDelete: SetNull)
  matchedExpense Expense? @relation(fields: [matchedExpenseId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@map("bank_transactions")
}

/// A saved rule that auto-categorizes a bank transaction whose description contains `pattern`
/// (case-insensitive substring match) — applied in creation order, first match wins, whenever
/// applyRules() runs (on-demand, and automatically right after a CSV import). Doesn't touch
/// matchedInvoiceId/matchedExpenseId/reconciled: this is bookkeeping categorization for
/// transactions that were never going to match an Invoice or Expense in the first place.
model BankTransactionRule {
  id        String          @id @default(uuid())
  companyId String
  pattern   String
  category  ExpenseCategory
  createdAt DateTime        @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("bank_transaction_rules")
}

enum SubcontractorDiversityCategory {
  mbe
  wbe
  dbe
  vbe
  sdvosb
  other
}

/// A subcontractor the company pays for labor/work — distinct from Worker
/// (internal staff whose hours are tracked via TimeEntry) and from Supplier
/// (sells materials, paid via PurchaseOrder).
model Subcontractor {
  id                              String                           @id @default(uuid())
  companyId                       String
  name                            String
  email                           String?
  phone                           String?
  /// Self-described trade/specialty (e.g. "Electrical", "Framing") shown on the public profile.
  specialization                  String?
  /// Short self-described blurb for the public profile — not moderated, this company's own words about a sub it trusts.
  bio                             String?
  /// Set when publicListed is turned on; the public profile lives at /subcontractor-profile/:publicToken.
  publicToken                     String?                          @unique
  publicListed                    Boolean                          @default(false)
  /// Prequalification fields, self-reported by the GC (or, later, the sub through their portal) —
  /// none of these gate anything today the way insurance documents do in assertCompliant(); they're
  /// informational context shown alongside the compliance/performance data.
  licenseNumber                   String?
  bondingCapacity                 Decimal?                         @db.Decimal(14, 2)
  safetyProgramSummary            String?
  /// US 1099-NEC fields, self-reported by the GC — only meaningful for a US company
  /// (Company.country === "US"); nothing today gates on their presence the way insurance
  /// documents gate assign(). taxId is plaintext (no field-level encryption infra exists yet in
  /// this codebase) so SubcontractorsService masks it to last-4 in list/summary responses and
  /// only returns it in full from the dedicated tax-profile endpoint.
  taxId                           String?
  legalBusinessName               String?
  mailingAddress                  String?
  /// Self-reported diversity certifications (MBE/WBE/DBE/etc.) for public-work bid compliance
  /// reporting — see SubcontractorsService.diversitySpendReport(). Not verified against any
  /// certifying agency's registry; same self-attested trust level as licenseNumber/bondingCapacity
  /// above. expiresAt applies to the certification(s) as a set, not per-category, since a sub
  /// typically renews all its certifications through one agency cycle.
  diversityCertifications         SubcontractorDiversityCategory[] @default([])
  diversityCertificationExpiresAt DateTime?

  company                Company                          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  costs                  SubcontractorCost[]
  payments               SubcontractorPayment[]
  assignments            SubcontractorAssignment[]
  portalLoginTokens      SubcontractorPortalLoginToken[]
  documents              SubcontractorDocument[]
  lienWaivers            LienWaiver[]
  bidInvites             BidInvite[]
  bids                   Bid[]
  contracts              Contract[]
  performanceReviews     SubcontractorPerformanceReview[]
  assignedPunchListItems PunchListItem[]
  prequalifications      SubcontractorPrequalification[]
  backcharges            SubcontractorBackcharge[]
  defaultNotices         SubcontractorDefaultNotice[]

  @@index([companyId])
  @@map("subcontractors")
}

enum PrequalificationStatus {
  pending
  approved
  rejected
}

/// A formal review cycle, distinct from the free-text licenseNumber/bondingCapacity/
/// safetyProgramSummary fields on Subcontractor above (which are self-reported and gate
/// nothing). Each row is one cycle — a sub can be re-prequalified over time, so history is
/// multiple rows per subcontractor rather than one row updated in place; "current" status is
/// whichever row is most recent. Deliberately not wired into SubcontractorsService.assign()'s
/// compliance gate — unlike insurance documents, retroactively requiring approval would block
/// every subcontractor assigned before this feature existed.
model SubcontractorPrequalification {
  id              String                 @id @default(uuid())
  companyId       String
  subcontractorId String
  licenseNumber   String?
  bondingCapacity Decimal?               @db.Decimal(14, 2)
  yearsInBusiness Int?
  /// Experience Modification Rate — the standard workers'-comp safety metric used in trade
  /// prequalification (1.0 is the industry-average baseline; lower is safer).
  safetyEmrRating Decimal?               @db.Decimal(4, 2)
  referencesNotes String?
  score           Int?
  status          PrequalificationStatus @default(pending)
  reviewedByName  String?
  reviewedAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime               @default(now())

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([subcontractorId])
  @@map("subcontractor_prequalifications")
}

enum SubcontractorBackchargeStatus {
  pending
  deducted
  waived
}

/// A cost the GC intends to deduct from a subcontractor for defective/incomplete work the sub
/// won't fix itself — optionally evidenced by the PunchListItem that documents the defect.
/// Netting against an actual SubcontractorPayment is a manual bookkeeping step (status change
/// only); this model is the claim ledger, not a live balance calculator.
model SubcontractorBackcharge {
  id              String                        @id @default(uuid())
  companyId       String
  projectId       String
  subcontractorId String
  punchListItemId String?
  /// Alternative to punchListItemId, same "belongs to whichever is set, never both, not enforced
  /// at the schema level" convention as PunchListItem's own dual attachment points.
  warrantyClaimId String?
  description     String
  amount          Decimal                       @db.Decimal(14, 2)
  status          SubcontractorBackchargeStatus @default(pending)
  createdByName   String
  createdAt       DateTime                      @default(now())
  resolvedAt      DateTime?

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcontractor Subcontractor  @relation(fields: [subcontractorId], references: [id], onDelete: Restrict)
  punchListItem PunchListItem? @relation(fields: [punchListItemId], references: [id], onDelete: SetNull)
  warrantyClaim WarrantyClaim? @relation(fields: [warrantyClaimId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@index([subcontractorId])
  @@index([warrantyClaimId])
  @@map("subcontractor_backcharges")
}

enum SubcontractorDefaultNoticeStatus {
  issued
  cured
  terminated
}

/// A formal notice that a subcontractor is in default of its contract (e.g. abandoned the site,
/// missed a milestone) with a cure period before the GC can terminate — the documented
/// notice-and-cure trail construction contracts require before termination is enforceable.
model SubcontractorDefaultNotice {
  id              String                           @id @default(uuid())
  companyId       String
  projectId       String
  subcontractorId String
  title           String
  description     String
  noticeDate      DateTime                         @default(now())
  curePeriodDays  Int?
  cureDeadline    DateTime?
  status          SubcontractorDefaultNoticeStatus @default(issued)
  createdByName   String
  createdAt       DateTime                         @default(now())
  resolvedAt      DateTime?

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([projectId])
  @@index([subcontractorId])
  @@map("subcontractor_default_notices")
}

enum SubcontractorDocumentType {
  general_liability_insurance
  workers_comp_insurance
  license
  bonding
  other
}

/// An insurance certificate or license on file for a subcontractor, with an expiration date.
/// SubcontractorsService.assign() checks for a current (non-expired) general_liability_insurance
/// and workers_comp_insurance document before allowing a project assignment — the two documents
/// virtually every jurisdiction requires before a sub can legally work on a job site.
model SubcontractorDocument {
  id              String                    @id @default(uuid())
  companyId       String
  subcontractorId String
  type            SubcontractorDocumentType
  name            String
  expiresAt       DateTime
  createdAt       DateTime                  @default(now())

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  /// The actual scanned certificate/policy file, if one's been uploaded — this record itself
  /// (type/name/expiresAt) is just the trackable metadata; the file is optional.
  attachments   Document[]

  @@index([companyId])
  @@index([subcontractorId])
  @@map("subcontractor_documents")
}

/// A safety/skills certification on file for an internal Worker (OSHA 30, forklift operator,
/// first aid/CPR, confined space, etc.) with an expiration date. Unlike SubcontractorDocument,
/// there's no single fixed pair of universally-required types here — certifications vary too
/// widely by trade and jurisdiction — so this is tracking + expiry notifications only, not a
/// hard gate on any one action.
model WorkerCertification {
  id        String   @id @default(uuid())
  companyId String
  workerId  String
  name      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([workerId])
  @@map("worker_certifications")
}

enum TrainingEnrollmentStatus {
  enrolled
  completed
}

/// The company's catalog of structured training courses — distinct from WorkerCertification,
/// which just tracks a name+expiry with no course content, enrollment, or completion workflow
/// behind it. validityMonths, when set, is how long a completion stays current before the
/// worker needs to retake it; TrainingService.completeEnrollment() auto-issues/renews a matching
/// WorkerCertification on completion so the existing expiry-notification pipeline covers it too.
model TrainingCourse {
  id             String   @id @default(uuid())
  companyId      String
  title          String
  description    String?
  category       String?
  validityMonths Int?
  createdAt      DateTime @default(now())

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enrollments TrainingEnrollment[]

  @@index([companyId])
  @@map("training_courses")
}

model TrainingEnrollment {
  id          String                   @id @default(uuid())
  companyId   String
  courseId    String
  workerId    String
  status      TrainingEnrollmentStatus @default(enrolled)
  enrolledAt  DateTime                 @default(now())
  completedAt DateTime?
  score       Int?
  notes       String?

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  course  TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  worker  Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([courseId])
  @@index([workerId])
  @@map("training_enrollments")
}

/// The company's standard onboarding checklist — WorkerOnboardingTask rows are cloned from this
/// list (by title, at that moment) whenever a new Worker is created, so editing the template
/// later never rewrites tasks already assigned to someone.
model OnboardingTemplateItem {
  id        String @id @default(uuid())
  companyId String
  title     String
  sortOrder Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("onboarding_template_items")
}

model WorkerOnboardingTask {
  id          String    @id @default(uuid())
  companyId   String
  workerId    String
  title       String
  done        Boolean   @default(false)
  completedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([workerId])
  @@map("worker_onboarding_tasks")
}

/// Same reusable-checklist-template pattern as OnboardingTemplateItem, for the reverse process —
/// equipment return, access revocation, final pay, etc. when a worker is deactivated.
model OffboardingTemplateItem {
  id        String @id @default(uuid())
  companyId String
  title     String
  sortOrder Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("offboarding_template_items")
}

/// Cloned from OffboardingTemplateItem the moment a worker's `active` flips to false — same
/// snapshot-at-the-moment semantics as WorkerOnboardingTask, so editing the template later never
/// rewrites a departure already in progress.
model WorkerOffboardingTask {
  id          String    @id @default(uuid())
  companyId   String
  workerId    String
  title       String
  done        Boolean   @default(false)
  completedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([workerId])
  @@map("worker_offboarding_tasks")
}

enum TimeOffType {
  vacation
  sick
  unpaid
}

enum TimeOffStatus {
  pending
  approved
  denied
}

model TimeOffRequest {
  id              String        @id @default(uuid())
  companyId       String
  workerId        String
  type            TimeOffType
  startDate       DateTime
  endDate         DateTime
  reason          String?
  status          TimeOffStatus @default(pending)
  /// Who approved/denied it and when — null while status is still "pending".
  decidedByUserId String?
  decidedAt       DateTime?
  createdAt       DateTime      @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([workerId])
  @@map("time_off_requests")
}

enum ScheduledReportType {
  overview
  project_margins
  warehouse_turnover
  invoice_aging
  portfolio
  cash_flow_forecast
}

enum ScheduledReportFrequency {
  weekly
  monthly
}

/// Picks one of ReportsService's existing report methods and emails its headline numbers to a
/// recipient list on a schedule — not a from-scratch query/column builder, which would be a much
/// larger undertaking; this reuses the report logic that already exists and adds delivery on top.
model ScheduledReport {
  id              String                   @id @default(uuid())
  companyId       String
  name            String
  reportType      ScheduledReportType
  frequency       ScheduledReportFrequency
  recipientEmails String[]
  active          Boolean                  @default(true)
  nextRunAt       DateTime
  lastSentAt      DateTime?
  createdAt       DateTime                 @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([active, nextRunAt])
  @@map("scheduled_reports")
}

/// Which projects a subcontractor may see/log costs against from their portal — office staff
/// grants this explicitly; a subcontractor otherwise has no visibility into any project.
model SubcontractorAssignment {
  id              String    @id @default(uuid())
  subcontractorId String
  projectId       String
  /// Both nullable — an assignment with no dates means "on this project, timing TBD," matching
  /// the pre-existing behavior before this batch added scheduling. Set together or not at all;
  /// the service doesn't enforce startDate <= endDate at the DB level, only in application code.
  startDate       DateTime?
  endDate         DateTime?
  /// When the sub actually finished, set manually — compared against `endDate` (the planned date)
  /// to derive on-time performance. Null while still in progress or if never recorded.
  actualEndDate   DateTime?
  createdAt       DateTime  @default(now())

  subcontractor      Subcontractor                    @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  project            Project                          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  performanceReviews SubcontractorPerformanceReview[]

  @@unique([subcontractorId, projectId])
  @@index([subcontractorId])
  @@index([projectId])
  @@map("subcontractor_assignments")
}

/// A post-job performance rating the GC records for a subcontractor — builds up into a per-sub
/// scorecard (computed at read time, not cached/denormalized, same reasoning as
/// SubcontractorsService.complianceStatus()). onTime/safetyIncidents/reworkCount are the GC's own
/// account since nothing elsewhere in the schema derives them automatically (SubcontractorCost
/// isn't linked to a budget/estimate, and IncidentReport isn't linked to a subcontractor).
model SubcontractorPerformanceReview {
  id               String   @id @default(uuid())
  companyId        String
  subcontractorId  String
  assignmentId     String?
  reviewedByUserId String?
  reviewedByName   String
  /// Overall 1-5 rating.
  rating           Int
  onTime           Boolean?
  safetyIncidents  Int      @default(0)
  reworkCount      Int      @default(0)
  wouldHireAgain   Boolean?
  comments         String?
  createdAt        DateTime @default(now())

  company       Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subcontractor Subcontractor            @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  assignment    SubcontractorAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([subcontractorId])
  @@map("subcontractor_performance_reviews")
}

/// Single-use magic-link token for the subcontractor portal — same shape and lifecycle as
/// ClientPortalLoginToken, kept as its own model since subcontractors and clients are
/// distinct entities with no shared identity.
model SubcontractorPortalLoginToken {
  id              String    @id @default(uuid())
  subcontractorId String
  token           String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)

  @@index([subcontractorId])
  @@map("subcontractor_portal_login_tokens")
}

/// Same magic-link login pattern as SubcontractorPortalLoginToken, for the material-supplier
/// self-service portal (PO visibility + acknowledgment).
model SupplierPortalLoginToken {
  id         String    @id @default(uuid())
  supplierId String
  token      String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_portal_login_tokens")
}

/// A bill from a subcontractor against a project — an actual cost the moment
/// it's logged (mirrors how stock issue counts as actual at issue-time, not
/// payment-time); `paid` and `dueDate` exist for the cash-flow forecast, not
/// for gating whether it counts toward budget-vs-actual.
model SubcontractorCost {
  id                         String    @id @default(uuid())
  companyId                  String
  subcontractorId            String
  projectId                  String
  description                String
  amount                     Decimal   @db.Decimal(14, 2)
  incurredDate               DateTime  @default(now())
  dueDate                    DateTime?
  paid                       Boolean   @default(false)
  /// Optional CSI cost code, for job-costing roll-ups — see JobCostingService.
  costCodeId                 String?
  /// Set once pushed to the connected accounting system as a Bill — same
  /// externalAccountingId/SyncedAt idempotency pair as Invoice, see AccountingSyncService.syncBills().
  externalAccountingId       String?
  externalAccountingSyncedAt DateTime?

  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subcontractor Subcontractor          @relation(fields: [subcontractorId], references: [id], onDelete: Restrict)
  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCode      CostCode?              @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  lienWaiver    LienWaiver?
  payments      SubcontractorPayment[]

  @@index([companyId])
  @@index([projectId])
  @@index([subcontractorId])
  @@index([costCodeId])
  @@map("subcontractor_costs")
}

/// The actual cash-payment ledger for a subcontractor — distinct from SubcontractorCost.paid
/// (a boolean flip with no date, kept for cash-flow-forecast dueDate filtering, not
/// payment-date tracking; see the comment on SubcontractorCost). One row per payment, so a cost
/// paid in installments produces multiple rows against the same subcontractorCostId, and a
/// standalone/lump-sum payment not tied to any single cost line (e.g. a retainage release) can
/// have subcontractorCostId null. This is what 1099 calendar-year totals are computed from —
/// SubcontractorCost.incurredDate can't answer "how much did we pay this sub in 2026" on its own.
model SubcontractorPayment {
  id                  String   @id @default(uuid())
  companyId           String
  subcontractorId     String
  subcontractorCostId String?
  amount              Decimal  @db.Decimal(14, 2)
  paidAt              DateTime @default(now())
  note                String?
  createdAt           DateTime @default(now())

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subcontractor     Subcontractor      @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  subcontractorCost SubcontractorCost? @relation(fields: [subcontractorCostId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([subcontractorId])
  @@index([subcontractorCostId])
  @@index([paidAt])
  @@map("subcontractor_payments")
}

/// CSI MasterFormat-style division, used to classify estimate/change-order/subcontractor-cost
/// lines for job-costing roll-ups and schedule-of-values billing — see JobCostingService and
/// AiaBillingService. Company-scoped so each company can trim/extend the list to what it uses.
model CostCode {
  id        String @id @default(uuid())
  companyId String
  code      String
  name      String

  company                    Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  estimateLines              EstimateLine[]
  changeOrderLines           ChangeOrderLine[]
  subcontractorCosts         SubcontractorCost[]
  productivityLogs           ProductivityLog[]
  budgetTransfersFrom        CostCodeBudgetTransfer[] @relation("CostCodeBudgetTransferFrom")
  budgetTransfersTo          CostCodeBudgetTransfer[] @relation("CostCodeBudgetTransferTo")

  @@unique([companyId, code])
  @@index([companyId])
  @@map("cost_codes")
}

enum AllowanceStatus {
  active
  exceeded
  closed
}

/// A contract allowance — a budgeted placeholder sum (e.g. "$5,000 for lighting fixtures") that
/// actual charges get reconciled against as the real product/vendor is picked. Deliberately not
/// linked to a specific EstimateLine — an allowance is a contract-level commitment that may span
/// or predate any one estimate line, and reconciliation only needs the running total, not a tie
/// back to the pricing engine.
model Allowance {
  id             String          @id @default(uuid())
  companyId      String
  projectId      String
  name           String
  budgetedAmount Decimal         @db.Decimal(14, 2)
  notes          String?
  status         AllowanceStatus @default(active)
  createdAt      DateTime        @default(now())

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  charges AllowanceCharge[]

  @@index([companyId])
  @@index([projectId])
  @@map("allowances")
}

model AllowanceCharge {
  id            String   @id @default(uuid())
  allowanceId   String
  description   String
  amount        Decimal  @db.Decimal(14, 2)
  chargedAt     DateTime @default(now())
  createdByName String?

  allowance Allowance @relation(fields: [allowanceId], references: [id], onDelete: Cascade)

  @@index([allowanceId])
  @@map("allowance_charges")
}

/// A contract line priced per unit of field-measured quantity (common on civil/infrastructure
/// work) rather than a fixed lump sum — UnitPriceMeasurement rows accumulate the quantity
/// actually installed, verified in the field, which is what gets billed (quantity × contractUnitPrice).
model UnitPriceItem {
  id                String   @id @default(uuid())
  companyId         String
  projectId         String
  description       String
  unit              String
  contractUnitPrice Decimal  @db.Decimal(12, 4)
  estimatedQuantity Decimal? @db.Decimal(14, 4)
  createdAt         DateTime @default(now())

  company      Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  measurements UnitPriceMeasurement[]

  @@index([companyId])
  @@index([projectId])
  @@map("unit_price_items")
}

model UnitPriceMeasurement {
  id               String   @id @default(uuid())
  unitPriceItemId  String
  measuredQuantity Decimal  @db.Decimal(14, 4)
  measuredAt       DateTime @default(now())
  measuredByName   String
  notes            String?

  unitPriceItem UnitPriceItem @relation(fields: [unitPriceItemId], references: [id], onDelete: Cascade)

  @@index([unitPriceItemId])
  @@map("unit_price_measurements")
}

enum TMTicketStatus {
  draft
  submitted
  approved
  rejected
  /// The owner sent it back for revision rather than a flat rejection — reviseTMTicket() edits the
  /// cost/description fields and returns it to draft for another decideTMTicket() pass.
  disputed
}

/// A field-signed time-and-material ticket for out-of-scope/change-directive work priced after
/// the fact by actual labor/equipment/material cost rather than a pre-agreed unit price or lump
/// sum — ownerSignerName/signedAt capture the on-site acknowledgment (text signature, same
/// lightweight convention as LienNotice's methodOfService — no image capture needed for a field slip).
model TMTicket {
  id              String         @id @default(uuid())
  companyId       String
  projectId       String
  /// Sequential per project (1, 2, 3, ...).
  ticketNumber    Int
  workDate        DateTime
  description     String
  laborCost       Decimal        @default(0) @db.Decimal(14, 2)
  equipmentCost   Decimal        @default(0) @db.Decimal(14, 2)
  materialCost    Decimal        @default(0) @db.Decimal(14, 2)
  status          TMTicketStatus @default(draft)
  ownerSignerName String?
  signedAt        DateTime?
  createdAt       DateTime       @default(now())
  /// Set when status=disputed — why the owner sent it back. Cleared on the next reviseTMTicket().
  disputeReason   String?
  /// Bumped by reviseTMTicket() each time a disputed ticket is edited and resubmitted.
  revisionCount   Int            @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, ticketNumber])
  @@index([companyId])
  @@index([projectId])
  @@map("tm_tickets")
}

/// A day's self-reported output for a cost code — quantityCompleted against laborHours spent
/// getting there, so hours-per-unit can be tracked over time and compared across crews/dates.
/// Deliberately not derived from TimeEntry: TimeEntry hours aren't broken out by quantity of work
/// accomplished, only by project/task, so laborHours here is a separate field-reported figure.
model ProductivityLog {
  id                String   @id @default(uuid())
  companyId         String
  projectId         String
  costCodeId        String?
  workDate          DateTime
  quantityCompleted Decimal  @db.Decimal(14, 4)
  unit              String
  laborHours        Decimal  @db.Decimal(10, 2)
  crewName          String?
  notes             String?
  createdAt         DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCode CostCode? @relation(fields: [costCodeId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@index([costCodeId])
  @@map("productivity_logs")
}

/// A company-maintained trade + prevailing-wage rate pair, e.g. "Electrician — $42.50/hr + $9.20
/// fringe". Rates are entered manually from the applicable wage determination (there's no live
/// government feed integration) and are looked up per Worker for certified payroll compliance.
model WageClassification {
  id              String   @id @default(uuid())
  companyId       String
  trade           String
  hourlyRate      Decimal  @db.Decimal(10, 2)
  /// Fringe benefit rate per hour — paid in addition to the base wage, cash or bona-fide plan.
  /// Kept as a single flat figure even though fringeBenefitFunds below can itemize it by fund —
  /// this stays the total used everywhere the breakdown doesn't matter (e.g. computeWeek's
  /// grossPay math), same "flat number + optional breakdown" shape as WarrantyRegistration's
  /// expirationDate alongside its termMonths.
  fringeRate      Decimal  @default(0) @db.Decimal(10, 2)
  /// Free-text apprentice:journeyman ratio from the applicable CBA/prevailing-wage determination
  /// (e.g. "1:4") — deliberately not a structured numerator/denominator pair since some
  /// determinations step the ratio by project size or apprentice year. Null means unenforced.
  apprenticeRatio String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workers            Worker[]
  fringeBenefitFunds FringeBenefitFund[]

  @@index([companyId])
  @@map("wage_classifications")
}

enum FringeFundType {
  pension
  health
  training
  vacation
  other
}

/// Itemizes a WageClassification's flat fringeRate into named union/CBA benefit funds (health,
/// pension, training, vacation) — a certified payroll statement of compliance for a union job
/// often has to show the per-fund breakdown, not just the total.
model FringeBenefitFund {
  id                   String         @id @default(uuid())
  companyId            String
  wageClassificationId String
  fundType             FringeFundType
  name                 String
  ratePerHour          Decimal        @db.Decimal(10, 2)
  createdAt            DateTime       @default(now())

  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  wageClassification WageClassification @relation(fields: [wageClassificationId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([wageClassificationId])
  @@map("fringe_benefit_funds")
}

/// One filed weekly certified payroll record for a public-work project (federal WH-347 shape:
/// per-worker hours/rate/gross for the week, plus a signed statement of compliance). lineItems is
/// a snapshot taken at generation time — deliberately not live-computed from TimeEntry on every
/// read, so a later rate change or edited time entry can't retroactively alter an already-filed
/// report, mirroring TimeEntry.hourlyCostSnapshot's reasoning.
model CertifiedPayrollReport {
  id                        String    @id @default(uuid())
  companyId                 String
  projectId                 String
  weekEndingDate            DateTime
  /// Sequential per project (1, 2, 3, ...), assigned at generation time.
  payrollNumber             Int
  noWorkPerformed           Boolean   @default(false)
  lineItems                 Json?
  /// Snapshot of ApprenticeRatioViolation[] at generation time — same "snapshot, not live-computed"
  /// reasoning as lineItems above.
  apprenticeRatioViolations Json?
  totalGrossPay             Decimal?  @db.Decimal(12, 2)
  statementSignerName       String?
  statementSignedAt         DateTime?
  pdfStorageKey             String?
  createdAt                 DateTime  @default(now())
  createdByUserId           String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, weekEndingDate])
  @@index([companyId])
  @@index([projectId])
  @@map("certified_payroll_reports")
}

enum LienWaiverType {
  conditional_progress
  unconditional_progress
  conditional_final
  unconditional_final
}

/// A subcontractor's waiver of their right to file a mechanic's lien against the project for a
/// specific payment — "conditional" is signed before payment clears, "unconditional" after.
/// Snapshotted at request time from SubcontractorCost.paid, so it doesn't retroactively change
/// if the cost's paid status changes later.
model LienWaiver {
  id                  String         @id @default(uuid())
  companyId           String
  projectId           String
  subcontractorId     String
  subcontractorCostId String         @unique
  type                LienWaiverType
  amount              Decimal        @db.Decimal(14, 2)
  requestedAt         DateTime       @default(now())
  signedAt            DateTime?
  signerName          String?
  signatureImageKey   String?
  signedIp            String?

  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcontractor     Subcontractor     @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  subcontractorCost SubcontractorCost @relation(fields: [subcontractorCostId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([subcontractorId])
  @@map("lien_waivers")
}

enum LienNoticeDirection {
  sent
  received
}

enum LienNoticeType {
  preliminary_notice
  notice_to_owner
  notice_of_furnishing
  other
}

/// A statutory lien-rights notice — "sent" is this company protecting its OWN right to lien the
/// project (a preliminary notice to the owner), "received" is a supplier/subcontractor notifying
/// THIS company of their furnishing on the project. Deliberately no per-state deadline-rules
/// table (jurisdiction rules vary too much to responsibly hardcode) — deadlineDate is entered by
/// whoever files the notice, based on their own counsel/research.
model LienNotice {
  id               String              @id @default(uuid())
  companyId        String
  projectId        String
  direction        LienNoticeDirection
  type             LienNoticeType      @default(preliminary_notice)
  relatedPartyName String
  firstFurnishDate DateTime?
  deadlineDate     DateTime?
  sentAt           DateTime?
  methodOfService  String?
  notes            String?
  createdAt        DateTime            @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@map("lien_notices")
}

enum LienFilingStatus {
  filed
  released
  disputed
}

/// A mechanic's lien actually filed AGAINST this company's project by an unpaid supplier or
/// subcontractor — as opposed to LienWaiver, which is a waiver THIS company collects to protect
/// itself from exactly this happening.
model MechanicsLienFiling {
  id          String           @id @default(uuid())
  companyId   String
  projectId   String
  filedByName String
  amount      Decimal          @db.Decimal(14, 2)
  filedAt     DateTime
  status      LienFilingStatus @default(filed)
  releasedAt  DateTime?
  notes       String?
  createdAt   DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@map("mechanics_lien_filings")
}

enum DrawRequestStatus {
  draft
  submitted
  under_review
  approved
  funded
}

/// The bank/lender-facing wrapper around one progress-billing Invoice — adds the fields a
/// construction loan draw needs that Invoice's client-facing shape doesn't carry: a sequential
/// draw number, the period covered, and a lender review workflow (submitted/under_review/
/// approved/funded) distinct from InvoiceStatus (draft/sent/paid/void). Kept as a separate model
/// rather than fields bolted onto Invoice so client-facing billing state and lender-facing draw
/// state can't be confused with each other.
model DrawRequest {
  id                 String            @id @default(uuid())
  companyId          String
  projectId          String
  invoiceId          String            @unique
  drawNumber         Int
  periodStart        DateTime
  periodEnd          DateTime
  status             DrawRequestStatus @default(draft)
  lenderName         String?
  lenderContactEmail String?
  notes              String?
  submittedAt        DateTime?
  approvedAt         DateTime?
  fundedAt           DateTime?
  createdAt          DateTime          @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([projectId, drawNumber])
  @@index([companyId])
  @@index([projectId])
  @@map("draw_requests")
}

/// A reusable free-text contract body — cloned into a fresh Contract's body at creation time,
/// same clone-on-use convention as InspectionTemplate/OnboardingTemplateItem.
model ContractTemplate {
  id        String   @id @default(uuid())
  companyId String
  name      String
  body      String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("contract_templates")
}

enum ContractStatus {
  draft
  sent
  signed
  void
}

/// A free-form legal document (prime contract or subcontractor agreement) — distinct from
/// Estimate/ChangeOrder, which are structured pricing documents this codebase already renders
/// from line items. Reuses the same signerName/signatureImageKey/signedIp/clientAccessToken
/// trio those two already use for e-signature, rather than inventing a new mechanism.
model Contract {
  id                String         @id @default(uuid())
  companyId         String
  projectId         String
  clientId          String?
  subcontractorId   String?
  title             String
  body              String
  status            ContractStatus @default(draft)
  clientAccessToken String?        @unique
  sentAt            DateTime?
  signerName        String?
  signatureImageKey String?
  signedIp          String?
  signedAt          DateTime?
  createdAt         DateTime       @default(now())

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client        Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  subcontractor Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@map("contracts")
}

enum SuretyBondType {
  bid
  performance
  payment
  maintenance
}

enum SuretyBondStatus {
  active
  released
  expired
}

/// A surety bond THIS company carries (bid/performance/payment/maintenance) — as opposed to
/// Subcontractor.bondingCapacity, which is prequalification info about a sub's OWN bonding
/// capacity. Tracked per-project when tied to a specific contract, or company-wide (projectId
/// null) for e.g. an aggregate program bond. SuretyBondsService.bondingCapacityUtilization()
/// sums active bonds' penalSum against Company.bondingCapacityLimit to show how much headroom
/// is left to bid new work.
model SuretyBond {
  id           String           @id @default(uuid())
  companyId    String
  projectId    String?
  type         SuretyBondType
  bondNumber   String?
  suretyName   String
  agentContact String?
  penalSum     Decimal          @db.Decimal(14, 2)
  premium      Decimal?         @db.Decimal(12, 2)
  issueDate    DateTime
  expiryDate   DateTime?
  status       SuretyBondStatus @default(active)
  notes        String?
  createdAt    DateTime         @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@map("surety_bonds")
}

enum SignatureRequestStatus {
  draft
  sent
  completed
  voided
}

/// A general-purpose, reusable e-signature workflow over any already-uploaded Document — unlike
/// Contract/ChangeOrder/LienWaiver's single-signer trio baked into each entity, this supports an
/// ordered chain of multiple external signers (e.g. contractor countersigns, then the client) on
/// any document type, without adding a signing mechanism to every new entity that needs one.
model SignatureRequest {
  id              String                 @id @default(uuid())
  companyId       String
  documentId      String
  title           String
  status          SignatureRequestStatus @default(draft)
  createdByUserId String?
  createdAt       DateTime               @default(now())
  completedAt     DateTime?

  company   Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document  Document                 @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User?                    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  signers   SignatureRequestSigner[]

  @@index([companyId])
  @@index([documentId])
  @@map("signature_requests")
}

/// One recipient in a SignatureRequest's chain. `order` controls sequencing — SignatureRequestsService
/// only emails a signer once every signer with a lower order has signed, so a later signer can't
/// sign out of turn even though each has their own independent access token.
model SignatureRequestSigner {
  id                 String    @id @default(uuid())
  signatureRequestId String
  order              Int
  name               String
  email              String
  accessToken        String    @unique
  notifiedAt         DateTime?
  signedAt           DateTime?
  signatureImageKey  String?
  signedIp           String?

  signatureRequest SignatureRequest @relation(fields: [signatureRequestId], references: [id], onDelete: Cascade)

  @@index([signatureRequestId])
  @@map("signature_request_signers")
}

enum BidRequestStatus {
  open
  awarded
  cancelled
}

/// A scope of work put out to competing subcontractors for pricing, before any SubcontractorAssignment
/// exists — awarding a bid creates the assignment (via SubcontractorsService.assign, so the usual
/// insurance-compliance gate still applies) and locks the request against further submissions.
model BidRequest {
  id          String           @id @default(uuid())
  companyId   String
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  status      BidRequestStatus @default(open)
  createdAt   DateTime         @default(now())

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invites  BidInvite[]
  bids     Bid[]
  criteria BidScoreCriterion[]

  @@index([companyId])
  @@index([projectId])
  @@map("bid_requests")
}

/// Which subcontractors were invited to bid — only invited subs can see/submit against a BidRequest from their portal.
model BidInvite {
  id              String   @id @default(uuid())
  bidRequestId    String
  subcontractorId String
  createdAt       DateTime @default(now())

  bidRequest    BidRequest    @relation(fields: [bidRequestId], references: [id], onDelete: Cascade)
  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)

  @@unique([bidRequestId, subcontractorId])
  @@index([subcontractorId])
  @@map("bid_invites")
}

model Bid {
  id              String   @id @default(uuid())
  bidRequestId    String
  subcontractorId String
  amount          Decimal  @db.Decimal(14, 2)
  notes           String?
  isAwarded       Boolean  @default(false)
  submittedAt     DateTime @default(now())

  bidRequest    BidRequest    @relation(fields: [bidRequestId], references: [id], onDelete: Cascade)
  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  scores        BidScore[]
  lines         BidLine[]

  @@unique([bidRequestId, subcontractorId])
  @@index([bidRequestId])
  @@index([subcontractorId])
  @@map("bids")
}

/// A single priced scope item within a bid, for leveling (side-by-side comparison across subs
/// bidding the same BidRequest) — see bid-leveling.ts. description is matched exactly
/// (case/whitespace-insensitive) across bids to line up common scope items; there's no shared
/// scope-item taxonomy, so this only works as well as the subs name things consistently.
/// Replaced wholesale (delete+recreate) on every re-submission of a bid, same
/// deleteMany-then-create pattern SafetyBriefing uses for its attendees on update.
model BidLine {
  id          String  @id @default(uuid())
  bidId       String
  description String
  amount      Decimal @db.Decimal(14, 2)
  included    Boolean @default(true)
  sortOrder   Int     @default(0)

  bid Bid @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@index([bidId])
  @@map("bid_lines")
}

/// A qualitative criterion the GC scores every bid against besides price (timeline, quality,
/// reliability, safety record, ...) — defined per BidRequest so different trades can use
/// different rubrics. weight is relative, not required to sum to 100 — BidRequestsService
/// normalizes by the sum of weights actually in use when it computes each bid's weighted total.
model BidScoreCriterion {
  id           String @id @default(uuid())
  bidRequestId String
  label        String
  weight       Int

  bidRequest BidRequest @relation(fields: [bidRequestId], references: [id], onDelete: Cascade)
  scores     BidScore[]

  @@index([bidRequestId])
  @@map("bid_score_criteria")
}

/// One bid's score (1-5) against one criterion — missing rows just mean that criterion hasn't
/// been scored yet for that bid, not a score of zero.
model BidScore {
  id          String @id @default(uuid())
  bidId       String
  criterionId String
  score       Int

  bid       Bid               @relation(fields: [bidId], references: [id], onDelete: Cascade)
  criterion BidScoreCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([bidId, criterionId])
  @@index([bidId])
  @@index([criterionId])
  @@map("bid_scores")
}

/// A company-wide non-working day (public holiday, planned shutdown) — used to flag a task/
/// milestone whose due date lands on one, not to reflow the critical-path engine's own calendar-
/// day math (a weather delay genuinely costs calendar days; this is a separate, additive check).
model CompanyHoliday {
  id        String   @id @default(uuid())
  companyId String
  date      DateTime @db.Date
  label     String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId])
  @@map("company_holidays")
}

// ---------- CRM (thin in Phase 1) ----------

model Client {
  id                       String               @id @default(uuid())
  companyId                String
  name                     String
  email                    String?
  phone                    String?
  stage                    ClientStage          @default(lead)
  notes                    String?
  createdAt                DateTime             @default(now())
  /// Overrides Company.defaultPaymentTermsDays for this client only — null means use the
  /// company default.
  paymentTermsDays         Int?
  /// Which of the 5 launch locales to send invoice/estimate/change-order PDFs and their "sent"
  /// emails in — null falls back to Company.locale. Same independence from the logged-in user's
  /// own UI locale as Worker.preferredLocale for SMS.
  preferredLocale          Locale?
  /// Estimated deal value while the client is still in the pipeline (lead/contacted/qualified).
  estimatedValue           Decimal?             @db.Decimal(12, 2)
  ownerWorkerId            String?
  wonAt                    DateTime?
  lostAt                   DateTime?
  lostReason               String?
  /// The existing client who referred this one in — self-referential, so a company can trace
  /// its referral chains through the CRM without a separate tracking system.
  referredByClientId       String?
  /// Manually-set win likelihood (0-100) for pipeline forecasting. When unset, the forecast
  /// falls back to a per-stage default so every open deal still contributes a weighted value.
  probability              Int?
  expectedCloseDate        DateTime?
  /// Automated day-1/3/7 follow-up emails while still in stage=lead — see LeadFollowUpService.
  leadFollowUpCount        Int                  @default(0)
  lastLeadFollowUpSentAt   DateTime?
  /// Referral reward tracking for the client who *made* the referral (not the referred-in one) —
  /// set to "pending" once a client they referred reaches "won"; marked "paid" manually, since
  /// there's no payment-processor integration to automate the actual payout.
  referralRewardStatus     ReferralRewardStatus @default(none)
  referralRewardAmount     Decimal?             @db.Decimal(12, 2)
  /// Billing/postal address, split into the structured fields an EN16931 e-invoice's buyer party
  /// requires (BT-50/BT-52/BT-55/BT-40) — separate from Project.address (the job site), since a
  /// client is billed at their own address even when the site is elsewhere.
  street                   String?
  city                     String?
  postalCode               String?
  country                  String? // ISO 3166-1 alpha-2 — null falls back to the company's own country on e-invoices.
  /// Buyer's EU VAT ID (BT-48) — optional, since many clients are private individuals with none.
  vatId                    String?
  /// Stripe Customer created lazily the first time this client saves a card for autopay — null
  /// until then. Kept even after the payment method is removed, so re-adding a card doesn't spawn
  /// duplicate Stripe Customer objects.
  stripeCustomerId         String?
  /// Saved default card for RecurringInvoice.autopayEnabled — null means no card on file, and
  /// autopay can't be turned on for this client's recurring invoices until one is saved via the
  /// portal's "save card" Checkout (mode "setup", never charges anything itself).
  stripePaymentMethodId    String?
  stripePaymentMethodBrand String?
  stripePaymentMethodLast4 String?
  /// Free-text acquisition channel (e.g. "referral", "google_ads", "trade_show", "cold_call") —
  /// independent of campaignId, since not every source is a tracked, spend-attributed campaign.
  source                   String?
  campaignId               String?
  /// Default taxing jurisdiction for this client's invoices — TaxService.recalculateTax() reads
  /// this (or an explicit override on the invoice itself, once set) to find the applicable rate.
  /// Null means no jurisdiction assigned yet, not "tax-exempt" (see TaxExemptionCertificate for that).
  taxJurisdictionId        String?

  company               Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner                 Worker?                   @relation(fields: [ownerWorkerId], references: [id], onDelete: SetNull)
  referredBy            Client?                   @relation("ClientReferrals", fields: [referredByClientId], references: [id], onDelete: SetNull)
  referrals             Client[]                  @relation("ClientReferrals")
  campaign              MarketingCampaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  taxJurisdiction       TaxJurisdiction?          @relation(fields: [taxJurisdictionId], references: [id], onDelete: SetNull)
  projects              Project[]
  invoices              Invoice[]
  recurringInvoices     RecurringInvoice[]
  activities            ClientActivity[]
  reminders             ClientReminder[]
  portalLoginTokens     ClientPortalLoginToken[]
  warrantyClaims        WarrantyClaim[]
  serviceContracts      ServiceContract[]
  stageHistory          ClientStageHistory[]
  contracts             Contract[]
  portalMessages        PortalMessage[]
  supportTickets        SupportTicket[]
  taxExemptCertificates TaxExemptionCertificate[]
  changeRequests        ClientChangeRequest[]

  @@unique([id, companyId])
  @@index([companyId])
  @@index([ownerWorkerId])
  @@index([referredByClientId])
  @@index([campaignId])
  @@index([taxJurisdictionId])
  @@map("clients")
}

/// A tracked, spend-attributed lead source — as opposed to Client.source (free text, no spend
/// tracking). MarketingAttributionService.roiByChannel() groups clients by campaign.channel (or
/// bare Client.source when no campaign is linked) to compute cost-per-lead and cost-per-won-deal.
model MarketingCampaign {
  id        String    @id @default(uuid())
  companyId String
  name      String
  channel   String
  spend     Decimal?  @db.Decimal(12, 2)
  startDate DateTime?
  endDate   DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clients Client[]

  @@index([companyId])
  @@map("marketing_campaigns")
}

enum ReferralRewardStatus {
  none
  pending
  paid
}

/// One row per stage transition — lets pipeline reporting compute win rate and average
/// time-in-stage without replaying the generic AuditLog (which isn't structured for that).
model ClientStageHistory {
  id        String       @id @default(uuid())
  companyId String
  clientId  String
  fromStage ClientStage?
  toStage   ClientStage
  changedAt DateTime     @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([clientId])
  @@map("client_stage_history")
}

/// A single-use magic-link token — the client's persistent portal session is a JWT
/// issued once this is verified, not this row itself (this row is only the login step).
model ClientPortalLoginToken {
  id        String    @id @default(uuid())
  clientId  String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_portal_login_tokens")
}

enum ClientActivityType {
  note
  call
  meeting
  email
}

/// A timestamped log entry on a client — calls, meetings, emails, freeform notes.
/// Distinct from Client.notes (a single pinned summary field): this is a history.
model ClientActivity {
  id        String             @id @default(uuid())
  companyId String
  clientId  String
  type      ClientActivityType
  content   String
  createdAt DateTime           @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([clientId])
  @@map("client_activities")
}

/// A follow-up reminder against a client (e.g. "Call back about the quote").
model ClientReminder {
  id        String   @id @default(uuid())
  companyId String
  clientId  String
  title     String
  dueDate   DateTime
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([clientId])
  @@map("client_reminders")
}

// ---------- Recruiting (applicant tracking) ----------

enum JobPostingStatus {
  open
  closed
}

model JobPosting {
  id          String           @id @default(uuid())
  companyId   String
  title       String
  trade       String?
  location    String?
  description String?
  status      JobPostingStatus @default(open)
  createdAt   DateTime         @default(now())

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidates Candidate[]

  @@index([companyId])
  @@map("job_postings")
}

enum CandidateStage {
  applied
  screening
  interviewing
  offer
  hired
  rejected
}

/// hiredWorkerId is set once convertToWorker() creates a Worker record from this candidate —
/// same "soft link to the resulting record" shape as WarrantyClaim referencing its resolution,
/// left null for every candidate who never reaches "hired".
model Candidate {
  id            String         @id @default(uuid())
  companyId     String
  jobPostingId  String
  name          String
  email         String?
  phone         String?
  source        String?
  notes         String?
  stage         CandidateStage @default(applied)
  hiredWorkerId String?
  createdAt     DateTime       @default(now())

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobPosting JobPosting  @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  interviews Interview[]

  @@index([companyId])
  @@index([jobPostingId])
  @@map("candidates")
}

model Interview {
  id              String    @id @default(uuid())
  companyId       String
  candidateId     String
  scheduledAt     DateTime?
  interviewerName String?
  notes           String?
  /// 1-5, null until the interview has actually happened and been scored.
  rating          Int?
  createdAt       DateTime  @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([candidateId])
  @@map("interviews")
}

// ---------- Team/HR (schema-only until Phase 5) ----------

model Worker {
  id                   String    @id @default(uuid())
  companyId            String
  userId               String?
  name                 String
  role                 String?
  /// Cost rate used to value TimeEntry hours into actual labor cost (Finance budget-vs-actual).
  hourlyCost           Decimal?  @db.Decimal(10, 2)
  active               Boolean   @default(true)
  /// Running PTO balance in hours — can go negative (unpaid/advance time off). Adjusted manually
  /// by an admin and auto-deducted when a vacation-type TimeOffRequest is approved.
  ptoBalanceHours      Decimal   @default(0) @db.Decimal(8, 2)
  /// Trade classification for prevailing-wage compliance (certified payroll) — null means this
  /// worker hasn't been tagged yet and is excluded from wage-floor checks, not that they're exempt.
  wageClassificationId String?
  /// For SMS notifications — a Worker with userId: null has no other contact channel in the app
  /// at all (push/email/in-app all require a User+Membership), so this is genuinely the first
  /// way to reach a field worker with no account.
  phone                String?
  /// Which of the 5 launch locales to send SMS text in — null falls back to the company's own
  /// locale. Independent of Company.locale/the NEXT_LOCALE cookie, which only cover logged-in
  /// User accounts viewing the web app.
  preferredLocale      Locale?
  /// Self-reported employee ID in an external payroll processor (ADP/Gusto/etc.), used only as
  /// the identifier column on payroll CSV exports so the importing side can match rows to an
  /// existing employee record — not validated against any external system, same as
  /// Subcontractor.taxId. Null just means it hasn't been filled in yet.
  payrollEmployeeId    String?
  /// bcrypt hash of a short PIN (set by an admin) letting this worker identify themselves on a
  /// shared kiosk device without their own login — the device itself is already inside an
  /// authenticated company session (someone logged in), so this PIN is a consent/identity gate
  /// for that session, not a replacement for real auth. Null means kiosk clock-in is off for
  /// this worker.
  clockInPinHash       String?
  /// CDL (commercial driver's license) expiry, for a worker who drives a company Vehicle — null
  /// means this worker either doesn't hold a CDL or it isn't tracked. Feeds the same compliance
  /// calendar as WorkerCertification's expiry tracking.
  cdlExpiresAt         DateTime?
  /// Apprentice vs. journeyman standing under the worker's WageClassification — feeds the
  /// apprentice-to-journeyman ratio compliance check on certified payroll (see
  /// CertifiedPayrollService). Not itself a pay rate; hourlyCost still governs what they're paid.
  isApprentice         Boolean   @default(false)

  company                  Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                     User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  wageClassification       WageClassification?        @relation(fields: [wageClassificationId], references: [id], onDelete: SetNull)
  timeEntries              TimeEntry[]
  expenses                 Expense[]
  equipmentAssignments     EquipmentAssignment[]
  punchListItems           PunchListItem[]
  safetyBriefingAttendance SafetyBriefingAttendance[]
  warrantyClaims           WarrantyClaim[]
  ownedClients             Client[]
  resourceAssignments      ResourceAssignment[]
  crewMemberships          CrewMember[]
  certifications           WorkerCertification[]
  onboardingTasks          WorkerOnboardingTask[]
  offboardingTasks         WorkerOffboardingTask[]
  timeOffRequests          TimeOffRequest[]
  serviceVisits            ServiceVisit[]
  inspectionsPerformed     InspectionChecklist[]
  assignedDeficiencies     Deficiency[]
  jhaAcknowledgments       JhaAcknowledgment[]
  enpsSurveys              EnpsSurvey[]
  trainingEnrollments      TrainingEnrollment[]
  performanceReviews       PerformanceReview[]
  performanceGoals         PerformanceGoal[]
  hrCases                  HrCase[]
  assignedVehicles         Vehicle[]
  benefitEnrollments       BenefitEnrollment[]
  toolCheckouts            ToolCheckout[]

  @@index([companyId])
  @@map("workers")
}

enum BenefitPlanType {
  medical
  dental
  vision
  life
  disability
  other
}

/// The company's offered benefit plans — a plan has one or more BenefitPlanTier options
/// (Employee Only / +Spouse / +Family, etc.) a worker enrolls into. No OpenEnrollmentPeriod or
/// life-event workflow modeled — enrollment effectiveDate/endDate alone captures when coverage
/// starts and stops, which is enough for a first version of this without a full HR-benefits
/// state machine.
model BenefitPlan {
  id        String          @id @default(uuid())
  companyId String
  name      String
  type      BenefitPlanType
  carrier   String?
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tiers       BenefitPlanTier[]
  enrollments BenefitEnrollment[]

  @@index([companyId])
  @@map("benefit_plans")
}

/// One coverage tier under a plan, with its own employer/employee monthly cost split — a worker's
/// BenefitEnrollment picks exactly one tier of exactly one plan.
model BenefitPlanTier {
  id                  String  @id @default(uuid())
  companyId           String
  planId              String
  name                String
  monthlyEmployerCost Decimal @db.Decimal(10, 2)
  monthlyEmployeeCost Decimal @db.Decimal(10, 2)

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan        BenefitPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  enrollments BenefitEnrollment[]

  @@index([companyId])
  @@index([planId])
  @@map("benefit_plan_tiers")
}

enum BenefitEnrollmentStatus {
  active
  waived
  terminated
}

model BenefitEnrollment {
  id            String                  @id @default(uuid())
  companyId     String
  workerId      String
  planId        String
  tierId        String
  effectiveDate DateTime
  endDate       DateTime?
  status        BenefitEnrollmentStatus @default(active)
  createdAt     DateTime                @default(now())

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker     Worker             @relation(fields: [workerId], references: [id], onDelete: Cascade)
  plan       BenefitPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  tier       BenefitPlanTier    @relation(fields: [tierId], references: [id], onDelete: Cascade)
  dependents BenefitDependent[]

  @@index([companyId])
  @@index([workerId])
  @@index([planId])
  @@map("benefit_enrollments")
}

/// A dependent listed on a worker's benefit enrollment — free-text relationship (spouse, child,
/// etc.) rather than an enum, since carriers vary in how finely they categorize this.
model BenefitDependent {
  id           String    @id @default(uuid())
  companyId    String
  enrollmentId String
  name         String
  relationship String
  birthDate    DateTime?

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enrollment BenefitEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([enrollmentId])
  @@map("benefit_dependents")
}

enum HrCaseCategory {
  safety_violation
  complaint
  attendance
  performance
  harassment
  other
}

enum HrCaseSeverity {
  low
  medium
  high
}

enum HrCaseStatus {
  open
  investigating
  resolved
  closed
}

/// An incident-driven HR case (disciplinary write-up, complaint, harassment report) — distinct
/// from PerformanceReview, which is a periodic rating, not an event-triggered record needing a
/// defensible paper trail. confidential defaults true since most of these carry sensitive
/// content; the UI gates the whole case list behind manager-only access regardless.
model HrCase {
  id           String         @id @default(uuid())
  companyId    String
  workerId     String
  reporterName String
  category     HrCaseCategory
  severity     HrCaseSeverity @default(medium)
  status       HrCaseStatus   @default(open)
  description  String
  confidential Boolean        @default(true)
  closedAt     DateTime?
  createdAt    DateTime       @default(now())

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  actions HrCaseAction[]

  @@index([companyId])
  @@index([workerId])
  @@map("hr_cases")
}

enum HrCaseActionType {
  coaching
  verbal_warning
  written_warning
  suspension
  termination
  note
}

/// One entry in a case's action/investigation log — a write-up, a coaching conversation, a
/// suspension, or just an investigation note. acknowledgedAt is set once the worker has signed
/// off on a formal action (write-up, suspension), left null for informal notes.
model HrCaseAction {
  id             String           @id @default(uuid())
  companyId      String
  caseId         String
  type           HrCaseActionType
  description    String
  actionDate     DateTime         @default(now())
  createdByName  String
  acknowledgedAt DateTime?
  createdAt      DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  case    HrCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([caseId])
  @@map("hr_case_actions")
}

enum PerformanceReviewCycleStatus {
  open
  closed
}

/// A named review period (e.g. "H1 2026") that PerformanceReview rows are grouped under — closing
/// a cycle is a manual signal that its reviews are final, mirroring TrainingCourse's own
/// "the record itself carries the meaning" simplicity rather than a workflow-engine state machine.
model PerformanceReviewCycle {
  id          String                       @id @default(uuid())
  companyId   String
  name        String
  periodStart DateTime
  periodEnd   DateTime
  status      PerformanceReviewCycleStatus @default(open)
  createdAt   DateTime                     @default(now())

  company Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviews PerformanceReview[]

  @@index([companyId])
  @@map("performance_review_cycles")
}

enum PerformanceRating {
  below_expectations
  meets_expectations
  exceeds_expectations
}

/// One review per worker per cycle (see @@unique below) — rating/strengths/improvementAreas are
/// all optional until submittedAt is set, so a reviewer can save a draft before finalizing.
model PerformanceReview {
  id               String             @id @default(uuid())
  companyId        String
  cycleId          String
  workerId         String
  reviewerName     String
  rating           PerformanceRating?
  strengths        String?
  improvementAreas String?
  submittedAt      DateTime?
  createdAt        DateTime           @default(now())

  company Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cycle   PerformanceReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  worker  Worker                 @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([cycleId, workerId])
  @@index([companyId])
  @@index([workerId])
  @@map("performance_reviews")
}

/// A worker's individual goal, tracked independently of any review cycle — progressPercent is
/// self-reported/manager-set, not derived from anything else in the system.
model PerformanceGoal {
  id              String    @id @default(uuid())
  companyId       String
  workerId        String
  title           String
  targetDate      DateTime?
  progressPercent Int       @default(0)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([workerId])
  @@map("performance_goals")
}

model TimeEntry {
  id                     String   @id @default(uuid())
  companyId              String
  workerId               String
  projectId              String
  taskId                 String?
  hours                  Decimal  @db.Decimal(6, 2)
  date                   DateTime
  createdAt              DateTime @default(now())
  /// Worker.hourlyCost captured at creation time, so past labor-cost reports don't shift when a worker's rate later changes.
  hourlyCostSnapshot     Decimal? @db.Decimal(10, 2)
  /// Captured from the field app's Geolocation API at submission time; null for entries logged from the office.
  clockInLat             Float?
  clockInLng             Float?
  /// Distance from the project's geofence center, and whether it's within radius — null for either field means no geofence was configured on the project at submission time (nothing to evaluate), not that the check failed.
  distanceFromSiteMeters Int?
  withinGeofence         Boolean?

  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([workerId])
  @@index([projectId])
  @@map("time_entries")
}

enum ExpenseCategory {
  materials
  fuel
  tools
  permits
  meals
  other
}

enum ExpenseStatus {
  pending
  approved
  rejected
}

/// An out-of-pocket expense a field worker submits against a project, with an optional receipt
/// photo, awaiting office approval — distinct from SubcontractorCost (a sub's invoiced cost) and
/// StockMovement (materials from the company's own warehouse); this is cash a worker spent and
/// needs reimbursed.
model Expense {
  id                String          @id @default(uuid())
  companyId         String
  projectId         String
  workerId          String
  category          ExpenseCategory @default(other)
  amount            Decimal         @db.Decimal(12, 2)
  description       String?
  incurredAt        DateTime
  status            ExpenseStatus   @default(pending)
  /// Receipt photo/scan, stored directly here (like Company.logoStorageKey) rather than via the
  /// generic Document table — an expense has at most one receipt, not a variable attachment set.
  receiptStorageKey String?
  receiptMimeType   String?
  approvedByUserId  String?
  approvedAt        DateTime?
  rejectedReason    String?
  createdAt         DateTime        @default(now())

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker           Worker            @relation(fields: [workerId], references: [id], onDelete: Cascade)
  bankTransactions BankTransaction[]

  @@index([companyId])
  @@index([projectId])
  @@index([workerId])
  @@map("expenses")
}

// ---------- Documents (schema-only until Phase 5) ----------

enum DocumentCategory {
  contract
  permit
  photo
  invoice_scan
  insurance_certificate
  /// Portfolio/marketing photos for a project's before/after gallery (see ProjectsController gallery endpoint).
  gallery_before
  gallery_after
  /// Redlined/final as-built drawing — distinct from the DrawingSheet model's own revision chain,
  /// since an as-built is often a scanned/marked-up field copy rather than a new sheet version.
  as_built
  /// Owner's operations & maintenance manual content (equipment manuals, warranty compilations)
  /// bundled at closeout — see ProjectCloseoutService's readiness check.
  om_manual
  other
}

model Document {
  id                      String           @id @default(uuid())
  companyId               String
  projectId               String?
  invoiceId               String?
  /// The following five are alternative attachment points alongside project/invoice — a photo of
  /// a defect, a daily-log condition shot, incident evidence, a warranty claim photo, or a scanned
  /// insurance certificate. Exactly one of these (or project/invoice) is set per document in
  /// practice, though nothing enforces that at the schema level, same as project/invoice today.
  punchListItemId         String?
  dailyLogId              String?
  incidentReportId        String?
  warrantyClaimId         String?
  subcontractorDocumentId String?
  deficiencyId            String?
  permitId                String?
  safetyBriefingId        String?
  supplierDocumentId      String?
  companyDocumentId       String?
  insuranceClaimId        String?
  /// An RFI reference photo (e.g. a site condition photo attached to the question or answer) —
  /// same generic attachment pattern as punchListItemId above.
  rfiId                   String?
  /// The uploaded PDF/scan for one SafetyDataSheet version — same generic attachment pattern as
  /// punchListItemId above.
  safetyDataSheetId       String?
  /// Damaged-goods photo evidence for one ReceivingDiscrepancy — same generic attachment pattern
  /// as punchListItemId above.
  receivingDiscrepancyId  String?
  name                    String
  storageKey              String
  mimeType                String
  size                    Int              @default(0)
  category                DocumentCategory @default(other)
  /// Which language this file's content is written in — only meaningful for documents that come
  /// in parallel-language variants (currently just safety-briefing materials); null for
  /// everything else, not "unknown".
  locale                  Locale?
  /// Free-form cross-cutting labels alongside the single required category — e.g. a "permit"
  /// category document can also be tagged ["electrical", "phase-2"].
  tags                    String[]         @default([])
  /// 1 on the first upload of a file; each replace() call increments this within the same version chain.
  version                 Int              @default(1)
  /// Null on the first version of a chain (the root); every later version points back to the root's id,
  /// so "latest per chain" can be found by grouping on COALESCE(rootDocumentId, id) and taking max(version).
  rootDocumentId          String?
  uploadedByUserId        String?
  /// Soft delete — kept for the version chain's history rather than removed outright.
  deletedAt               DateTime?
  createdAt               DateTime         @default(now())

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project               Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoice               Invoice?               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  punchListItem         PunchListItem?         @relation(fields: [punchListItemId], references: [id], onDelete: Cascade)
  dailyLog              DailyLog?              @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  incidentReport        IncidentReport?        @relation(fields: [incidentReportId], references: [id], onDelete: Cascade)
  warrantyClaim         WarrantyClaim?         @relation(fields: [warrantyClaimId], references: [id], onDelete: Cascade)
  subcontractorDocument SubcontractorDocument? @relation(fields: [subcontractorDocumentId], references: [id], onDelete: Cascade)
  deficiency            Deficiency?            @relation(fields: [deficiencyId], references: [id], onDelete: Cascade)
  permit                Permit?                @relation(fields: [permitId], references: [id], onDelete: Cascade)
  safetyBriefing        SafetyBriefing?        @relation(fields: [safetyBriefingId], references: [id], onDelete: Cascade)
  supplierDocument      SupplierDocument?      @relation(fields: [supplierDocumentId], references: [id], onDelete: Cascade)
  companyDocument       CompanyDocument?       @relation(fields: [companyDocumentId], references: [id], onDelete: Cascade)
  insuranceClaim        InsuranceClaim?        @relation(fields: [insuranceClaimId], references: [id], onDelete: Cascade)
  rfi                   Rfi?                   @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  safetyDataSheet       SafetyDataSheet?       @relation(fields: [safetyDataSheetId], references: [id], onDelete: Cascade)
  receivingDiscrepancy  ReceivingDiscrepancy?  @relation(fields: [receivingDiscrepancyId], references: [id], onDelete: Cascade)
  signatureRequests     SignatureRequest[]
  uploadedBy            User?                  @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  rootDocument          Document?              @relation("DocumentVersions", fields: [rootDocumentId], references: [id], onDelete: Cascade)
  versions              Document[]             @relation("DocumentVersions")

  @@index([companyId])
  @@index([rootDocumentId])
  @@index([punchListItemId])
  @@index([dailyLogId])
  @@index([incidentReportId])
  @@index([warrantyClaimId])
  @@index([subcontractorDocumentId])
  @@index([deficiencyId])
  @@index([permitId])
  @@index([safetyBriefingId])
  @@index([supplierDocumentId])
  @@index([companyDocumentId])
  @@index([insuranceClaimId])
  @@index([rfiId])
  @@index([safetyDataSheetId])
  @@index([receivingDiscrepancyId])
  @@map("documents")
}

/// A snapshot from ProgressTrackingService.computeAndSnapshot: reads the project's uploaded
/// `photo`-category Document tags, maps the most-advanced matching phase keyword (see
/// progress-estimate.ts's built-in phase dictionary) to a percent-complete, and compares it
/// against the most recent progress-billing Invoice.percentComplete for the same project. This is
/// a keyword heuristic over human-entered tags, not computer vision — matchedKeywords records
/// what actually drove the estimate so a reviewer can sanity-check it.
model ProgressEstimate {
  id                       String   @id @default(uuid())
  companyId                String
  projectId                String
  estimatedPercentComplete Int
  matchedKeywords          String[] @default([])
  photoCount               Int
  billedPercentComplete    Decimal? @db.Decimal(5, 2)
  varianceFlagged          Boolean  @default(false)
  computedAt               DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@map("progress_estimates")
}

// ---------- Permits & municipal inspections ----------

enum PermitStatus {
  draft
  submitted
  approved
  rejected
  expired
}

/// A building-permit application tracked per project — separate from InspectionChecklist (which
/// is an internal QC checklist run by our own workers, not tied to any external authority).
/// nextInspectionNotifiedAt-style dedupe isn't needed here; PermitExpiringRemindersService uses
/// its own guard field below.
model Permit {
  id                 String       @id @default(uuid())
  companyId          String
  projectId          String
  permitType         String
  permitNumber       String?
  authorityName      String?
  status             PermitStatus @default(draft)
  submittedAt        DateTime?
  approvedAt         DateTime?
  expiresAt          DateTime?
  /// Set once an expiring-soon reminder has gone out, so the daily pass doesn't re-send it —
  /// same pattern as Equipment.maintenanceOverdueNotifiedAt.
  expiringNotifiedAt DateTime?
  notes              String?
  createdAt          DateTime     @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inspections Inspection[]
  documents   Document[]

  @@index([companyId])
  @@index([projectId])
  @@map("permits")
}

enum InspectionResult {
  pending
  passed
  failed
  cancelled
}

/// One scheduled municipal inspection tied to a permit. inspectorName/inspectorContact are free
/// text (not a Worker FK) since the inspector is an external party the company doesn't control —
/// unlike InspectionChecklist.inspectorWorkerId, which is always an internal employee.
model Inspection {
  id               String           @id @default(uuid())
  companyId        String
  permitId         String
  inspectionType   String
  scheduledDate    DateTime?
  inspectorName    String?
  inspectorContact String?
  result           InspectionResult @default(pending)
  completedAt      DateTime?
  notes            String?
  createdAt        DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permit  Permit  @relation(fields: [permitId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([permitId])
  @@map("permit_inspections")
}

// ---------- Plan room: drawing sheets & markup ----------

/// One uploaded drawing sheet (a single-page PDF or image) — sheet metadata (number/discipline/
/// revision) lives here rather than on the generic Document model since none of it fits Document's
/// shape well. Revisions are separate rows (not a version chain like Document) so an older
/// revision's markup history stays intact after a newer one is uploaded.
model DrawingSheet {
  id               String    @id @default(uuid())
  companyId        String
  projectId        String
  sheetNumber      String
  discipline       String?
  title            String?
  revision         String?
  revisionDate     DateTime?
  storageKey       String
  mimeType         String
  uploadedByUserId String?
  createdAt        DateTime  @default(now())
  /// 1 on the first upload of a sheet number; each supersede() call increments this within the
  /// same version chain — same rootDocumentId/version pattern as Document.
  version          Int       @default(1)
  /// Null on the first version of a chain (the root); every later version points back to the
  /// root's id, so "current version" can be found by grouping on COALESCE(rootSheetId, id) and
  /// taking max(version). Annotations/RFI/punch-list pins stay attached to the specific sheet
  /// version they were made on, rather than migrating forward automatically.
  rootSheetId      String?

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  annotations    Annotation[]
  rfis           Rfi[]
  punchListItems PunchListItem[]
  rootSheet      DrawingSheet?   @relation("DrawingSheetVersions", fields: [rootSheetId], references: [id], onDelete: Cascade)
  versions       DrawingSheet[]  @relation("DrawingSheetVersions")

  @@index([companyId])
  @@index([projectId])
  @@index([rootSheetId])
  @@map("drawing_sheets")
}

enum AnnotationType {
  freehand
  rectangle
  cloud
  arrow
  text
}

/// A markup shape pinned to a DrawingSheet. points are normalized to [0,1] of the sheet's
/// rendered page — same reasoning as TakeoffMeasurement.points — so markup stays aligned
/// regardless of what size the viewer renders the page at.
model Annotation {
  id             String         @id @default(uuid())
  companyId      String
  drawingSheetId String
  authorUserId   String?
  authorName     String
  type           AnnotationType
  points         Json
  color          String         @default("#e11d48")
  text           String?
  createdAt      DateTime       @default(now())

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sheet   DrawingSheet @relation(fields: [drawingSheetId], references: [id], onDelete: Cascade)

  @@index([drawingSheetId])
  @@map("annotations")
}

// ---------- Equipment / asset tracking ----------

enum EquipmentStatus {
  available
  in_use
  maintenance
  retired
  rented_out
}

enum DepreciationMethod {
  straight_line
  declining_balance
}

model Equipment {
  id                                String              @id @default(uuid())
  companyId                         String
  name                              String
  category                          String
  serialNumber                      String?
  purchaseDate                      DateTime?
  purchaseCost                      Decimal?            @db.Decimal(12, 2)
  status                            EquipmentStatus     @default(available)
  notes                             String?
  createdAt                         DateTime            @default(now())
  /// Recurring preventive-maintenance interval — null disables scheduling entirely for this
  /// piece of equipment. nextMaintenanceDueAt advances by this many days each time maintenance
  /// completes, mirroring RecurringInvoice.nextRunDate's advance-on-completion pattern.
  maintenanceIntervalDays           Int?
  nextMaintenanceDueAt              DateTime?
  /// Set once an overdue-while-in-use notification email has gone out, so the hourly pass
  /// doesn't re-send it every hour until the equipment is checked in and can actually be
  /// pulled into maintenance status. Cleared whenever maintenance completes.
  maintenanceOverdueNotifiedAt      DateTime?
  /// Running meter/engine-hours reading, updated manually (no telematics integration) — null
  /// means this equipment isn't hour-tracked. Mirrors the day-interval fields above but keyed
  /// off usage instead of the calendar; the two schedules are independent and either or both
  /// can be active at once.
  currentMeterHours                 Decimal?            @db.Decimal(10, 1)
  maintenanceIntervalHours          Decimal?            @db.Decimal(10, 1)
  nextMaintenanceDueHours           Decimal?            @db.Decimal(10, 1)
  /// Separate dedupe flag from maintenanceOverdueNotifiedAt so an hours-overdue notification and
  /// a date-overdue notification don't suppress each other.
  maintenanceOverdueHoursNotifiedAt DateTime?
  /// Fixed-asset depreciation schedule — all three null means depreciation isn't tracked for
  /// this piece of equipment (purchaseCost/purchaseDate alone aren't enough to compute a book
  /// value). See equipment-depreciation.ts for the pure calculation.
  depreciationMethod                DepreciationMethod?
  usefulLifeMonths                  Int?
  salvageValue                      Decimal?            @db.Decimal(12, 2)

  company             Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments         EquipmentAssignment[]
  maintenanceRecords  EquipmentMaintenanceRecord[]
  resourceAssignments ResourceAssignment[]
  gpsPings            EquipmentGpsPing[]
  fuelLogs            EquipmentFuelLog[]
  rentals             EquipmentRental[]
  disposal            AssetDisposal?
  loans               Loan[]
  calibrationRecords  CalibrationRecord[]

  @@index([companyId])
  @@map("equipment")
}

/// Recorded once when a piece of equipment is sold or scrapped — saleAmount vs. its book value
/// at disposedAt (per equipment-depreciation.ts) gives the gain/loss. A one-to-one with
/// Equipment (unique equipmentId) since a given asset is disposed of exactly once; disposing
/// also moves Equipment.status to retired.
model AssetDisposal {
  id          String   @id @default(uuid())
  companyId   String
  equipmentId String   @unique
  disposedAt  DateTime @default(now())
  saleAmount  Decimal? @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("asset_disposals")
}

enum LoanStatus {
  active
  paid_off
  defaulted
}

/// A loan the company itself owes (equipment financing, working-capital line, term loan) — as
/// opposed to DrawRequest/ContingencyDraw, which track money drawn from a CLIENT's construction
/// lender or a project's own contingency fund. equipmentId links the loan to what it financed,
/// when applicable; a working-capital loan leaves it null. The full amortization schedule is
/// generated as LoanPayment rows at creation time (see loan-amortization.ts), not computed live,
/// so a payment can be recorded against a specific due row.
model Loan {
  id                  String     @id @default(uuid())
  companyId           String
  equipmentId         String?
  lenderName          String
  principal           Decimal    @db.Decimal(14, 2)
  interestRatePercent Decimal    @db.Decimal(5, 2)
  termMonths          Int
  startDate           DateTime
  status              LoanStatus @default(active)
  notes               String?
  createdAt           DateTime   @default(now())

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  equipment Equipment?    @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  payments  LoanPayment[]

  @@index([companyId])
  @@map("loans")
}

/// One scheduled installment — principalPortion/interestPortion come from the amortization
/// schedule computed at loan creation. paidAt/paidAmount are null until recordPayment() is
/// called; paidAmount can differ from principalPortion+interestPortion (a partial or extra
/// payment), which is deliberately not reconciled back into later rows — the schedule is fixed,
/// actual payment history is a separate fact layered on top of it.
model LoanPayment {
  id               String    @id @default(uuid())
  companyId        String
  loanId           String
  dueDate          DateTime
  principalPortion Decimal   @db.Decimal(12, 2)
  interestPortion  Decimal   @db.Decimal(12, 2)
  paidAt           DateTime?
  paidAmount       Decimal?  @db.Decimal(12, 2)
  createdAt        DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  loan    Loan    @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([loanId])
  @@map("loan_payments")
}

enum VehicleType {
  truck
  van
  trailer
  other
}

/// A licensed road vehicle (truck, van, trailer) — distinct from Equipment (excavators, cranes,
/// etc.), which tracks engine-hours and preventive maintenance rather than VIN/plate/registration
/// and a driver's CDL. assignedDriverId points at a Worker; that worker's own cdlExpiresAt (not a
/// separate assignment-history table) is what compliance tracking reads.
model Vehicle {
  id                    String      @id @default(uuid())
  companyId             String
  name                  String
  vin                   String?
  licensePlate          String?
  type                  VehicleType @default(truck)
  assignedDriverId      String?
  registrationExpiresAt DateTime?
  insuranceExpiresAt    DateTime?
  odometerMiles         Decimal?    @db.Decimal(10, 1)
  createdAt             DateTime    @default(now())

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedDriver Worker?             @relation(fields: [assignedDriverId], references: [id], onDelete: SetNull)
  inspections    VehicleInspection[]
  fuelLogs       VehicleFuelLog[]

  @@index([companyId])
  @@index([assignedDriverId])
  @@map("vehicles")
}

enum VehicleInspectionResult {
  passed
  failed
}

/// A DOT (or equivalent) annual/periodic inspection record for one vehicle.
model VehicleInspection {
  id            String                  @id @default(uuid())
  companyId     String
  vehicleId     String
  inspectedAt   DateTime                @default(now())
  result        VehicleInspectionResult
  inspectorName String?
  notes         String?
  createdAt     DateTime                @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([vehicleId])
  @@map("vehicle_inspections")
}

/// Fuel fill-up log for a fleet vehicle — the Vehicle-side counterpart to EquipmentFuelLog.
/// idleHours is self-reported by the driver at fill-up (no telematics integration exists to
/// derive it automatically), used only for the fuel/idle-time fleet analytics report.
model VehicleFuelLog {
  id            String   @id @default(uuid())
  companyId     String
  vehicleId     String
  filledAt      DateTime @default(now())
  quantity      Decimal  @db.Decimal(10, 2)
  cost          Decimal? @db.Decimal(12, 2)
  odometerMiles Decimal? @db.Decimal(10, 1)
  idleHours     Decimal? @db.Decimal(6, 2)
  notes         String?
  createdAt     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([vehicleId])
  @@map("vehicle_fuel_logs")
}

/// This company's own equipment rented OUT to an external party as a revenue source — the
/// mirror image of EquipmentAssignment (which tracks OUR use of OUR equipment on OUR projects).
/// renterName is free text rather than a Subcontractor FK since a rental customer is often not
/// an existing subcontractor relationship at all. Revenue is computed at read time from
/// dailyRate × elapsed days (open-ended while actualReturnDate is null), same
/// no-denormalized-total reasoning as EquipmentService.costPerHour().
model EquipmentRental {
  id                 String    @id @default(uuid())
  companyId          String
  equipmentId        String
  renterName         String
  renterContact      String?
  dailyRate          Decimal   @db.Decimal(12, 2)
  startDate          DateTime  @default(now())
  expectedReturnDate DateTime?
  actualReturnDate   DateTime?
  notes              String?
  createdAt          DateTime  @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([equipmentId])
  @@map("equipment_rentals")
}

/// A hand tool, small power tool, or consumable tracked by count rather than as its own Equipment
/// record (which models heavy fleet assets with GPS/fuel/maintenance intervals) — a tool crib's
/// concern is simply "how many do we have, how many are checked out, and to whom".
model ToolCribItem {
  id              String   @id @default(uuid())
  companyId       String
  name            String
  barcode         String?
  replacementCost Decimal? @db.Decimal(10, 2)
  parLevel        Int?
  quantityOnHand  Int      @default(0)
  createdAt       DateTime @default(now())

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  checkouts          ToolCheckout[]
  calibrationRecords CalibrationRecord[]

  @@index([companyId])
  @@map("tool_crib_items")
}

enum ToolCheckoutCondition {
  good
  damaged
  lost
}

/// One checkout of `quantity` units of an item to a worker — returnedAt: null means still out.
/// returnCondition/chargeAmount are only set at check-in; a "lost" return never adds the quantity
/// back to ToolCribItem.quantityOnHand (see ToolCribService.checkIn), unlike "good"/"damaged".
model ToolCheckout {
  id              String                 @id @default(uuid())
  companyId       String
  itemId          String
  workerId        String
  projectId       String?
  quantity        Int                    @default(1)
  checkedOutAt    DateTime               @default(now())
  returnedAt      DateTime?
  returnCondition ToolCheckoutCondition?
  chargeAmount    Decimal?               @db.Decimal(10, 2)
  notes           String?

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item    ToolCribItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  worker  Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  project Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([itemId])
  @@index([workerId])
  @@index([projectId])
  @@map("tool_checkouts")
}

/// One calibration event for a physical instrument — a tool crib item (torque wrench, gas
/// detector) or a piece of Equipment (survey gear, testing gauge). Exactly one of
/// toolCribItemId/equipmentId is set per record, same polymorphic-attachment convention as
/// Document's punchListItemId/dailyLogId/etc. "Currently due" for an item is derived by reading
/// its most recent record's nextDueAt rather than stored redundantly on the item itself.
model CalibrationRecord {
  id                String   @id @default(uuid())
  companyId         String
  toolCribItemId    String?
  equipmentId       String?
  calibratedAt      DateTime
  nextDueAt         DateTime
  certificateNumber String?
  performedBy       String?
  notes             String?
  createdAt         DateTime @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  toolCribItem ToolCribItem? @relation(fields: [toolCribItemId], references: [id], onDelete: Cascade)
  equipment    Equipment?    @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([toolCribItemId])
  @@index([equipmentId])
  @@map("calibration_records")
}

/// A self-reported fuel purchase — same "no telematics hardware or provider integration" framing
/// as EquipmentGpsPing below; someone keys this in by hand (or a fuel-card CSV import later), it
/// isn't pulled from a fleet-card or telematics API. quantity is liters or gallons per
/// Company.unitSystem, labeled by the frontend at the point of display (no unit column stored,
/// same as the rest of the equipment module keeps currentMeterHours unit-agnostic).
model EquipmentFuelLog {
  id          String   @id @default(uuid())
  equipmentId String
  filledAt    DateTime @default(now())
  quantity    Decimal  @db.Decimal(10, 2)
  cost        Decimal? @db.Decimal(12, 2)
  /// Meter reading at fill-up, if logged — feeds Equipment.currentMeterHours forward the same way
  /// EquipmentService.updateMeterReading() does, but only advances it (never overwrites with an
  /// older/lower backfilled reading).
  meterHours  Decimal? @db.Decimal(10, 1)
  supplierId  String?
  notes       String?
  createdAt   DateTime @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  supplier  Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([equipmentId])
  @@map("equipment_fuel_logs")
}

/// One GPS fix from a field device tracking this piece of equipment — the browser/device sends
/// these itself while an operator has tracking turned on, there's no external telematics hardware
/// or provider integration behind it. Used only to draw a route for the day, not stored forever.
model EquipmentGpsPing {
  id          String   @id @default(uuid())
  equipmentId String
  lat         Float
  lng         Float
  recordedAt  DateTime @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId, recordedAt])
  @@map("equipment_gps_pings")
}

/// One row per check-out; checkedInAt stays null while the item is still out. Exactly one
/// open (checkedInAt: null) assignment can exist per Equipment — enforced in the service, not the DB.
/// checkOut/checkIn location fields are captured one-shot from the device's geolocation, the same
/// way TimeEntry.clockInLat/Lng work — a continuous route (EquipmentGpsPing) is a separate,
/// manually-started feature and unrelated to this. Geofence result is only computed when the
/// assignment has a projectId and that project has a geofence configured; otherwise all four
/// geofence fields stay null (not a failed check — nothing to check against).
model EquipmentAssignment {
  id                        String    @id @default(uuid())
  equipmentId               String
  projectId                 String?
  workerId                  String?
  checkedOutAt              DateTime  @default(now())
  checkedInAt               DateTime?
  notes                     String?
  checkOutLat               Float?
  checkOutLng               Float?
  checkOutDistanceFromSiteM Int?
  checkOutWithinGeofence    Boolean?
  checkInLat                Float?
  checkInLng                Float?
  checkInDistanceFromSiteM  Int?
  checkInWithinGeofence     Boolean?

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  worker    Worker?   @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([equipmentId])
  @@index([projectId])
  @@map("equipment_assignments")
}

/// A logged maintenance event — historical record, independent of the equipment's current status.
model EquipmentMaintenanceRecord {
  id          String   @id @default(uuid())
  equipmentId String
  description String
  cost        Decimal? @db.Decimal(12, 2)
  performedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  supplierId  String?
  /// Meter reading at the time this service was performed — null if this equipment isn't
  /// hour-tracked or the reading wasn't logged for this particular record.
  meterHours  Decimal? @db.Decimal(10, 1)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  supplier  Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([equipmentId])
  @@map("equipment_maintenance_records")
}

// ---------- Sustainability ----------

enum GreenCertificationType {
  leed_certified
  leed_silver
  leed_gold
  leed_platinum
  breeam
  well
  energy_star
  other
}

/// A green-building certification achieved (or pursued) for one project — LEED, BREEAM, etc.
/// expiresAt is nullable because most of these (LEED) are a one-time achievement with no expiry;
/// the few that do require periodic recertification (WELL, Energy Star) set it, and reuse the
/// same expired/expiring_soon/valid bucketing pattern as WorkerCertification.
model ProjectGreenCertification {
  id        String                 @id @default(uuid())
  companyId String
  projectId String
  type      GreenCertificationType
  name      String
  issuedAt  DateTime?
  expiresAt DateTime?
  notes     String?
  createdAt DateTime               @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@map("project_green_certifications")
}

// ---------- Safety ----------

/// A project's stormwater (NPDES) permit — EPA/environmental compliance, distinct from OSHA/
/// HazCom safety tracking (IncidentReport/HazardousMaterial above). NOI = Notice of Intent
/// (filed to start coverage), NOT = Notice of Termination (filed to end it).
model StormwaterPermit {
  id           String    @id @default(uuid())
  companyId    String
  projectId    String
  permitNumber String?
  noiFiledAt   DateTime?
  notFiledAt   DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inspections BmpInspection[]

  @@index([companyId])
  @@index([projectId])
  @@map("stormwater_permits")
}

enum BmpInspectionResult {
  satisfactory
  deficient
}

/// A best-management-practice inspection under a stormwater permit — routine (weekly) or
/// triggered by a qualifying rain event; triggerReason is free text since exact thresholds vary
/// by permit/jurisdiction.
model BmpInspection {
  id                String              @id @default(uuid())
  companyId         String
  permitId          String
  inspectedAt       DateTime            @default(now())
  triggerReason     String?
  result            BmpInspectionResult
  inspectorName     String?
  correctiveActions String?
  createdAt         DateTime            @default(now())

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permit  StormwaterPermit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([permitId])
  @@map("bmp_inspections")
}

enum EnvironmentalIncidentSeverity {
  minor
  moderate
  major
}

enum EnvironmentalIncidentStatus {
  open
  contained
  resolved
}

/// A spill or other environmental release on-site — separate from IncidentReport (worker
/// safety/OSHA-recordable events), since regulatory notification obligations and severity
/// classification are entirely different for environmental releases.
model EnvironmentalIncident {
  id                String                        @id @default(uuid())
  companyId         String
  projectId         String
  description       String
  severity          EnvironmentalIncidentSeverity @default(minor)
  status            EnvironmentalIncidentStatus   @default(open)
  occurredAt        DateTime                      @default(now())
  containedAt       DateTime?
  regulatorNotified Boolean                       @default(false)
  notes             String?
  createdAt         DateTime                      @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@map("environmental_incidents")
}

/// A chemical/hazardous substance tracked for OSHA Hazard Communication compliance — one company
/// catalog entry per substance, versioned SDS documents live on SafetyDataSheet below it.
model HazardousMaterial {
  id           String   @id @default(uuid())
  companyId    String
  name         String
  manufacturer String?
  casNumber    String?
  createdAt    DateTime @default(now())

  company          Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sdsSheets        SafetyDataSheet[]
  projectInventory ProjectHazmatInventory[]

  @@index([companyId])
  @@map("hazardous_materials")
}

/// One version of a hazardous material's safety data sheet — a new row is added (not edited in
/// place) each time the manufacturer issues a revision, so history isn't lost; revisionDate
/// drives StaleSdsReport (sheets past their review cycle need a fresh copy requested).
model SafetyDataSheet {
  id                   String    @id @default(uuid())
  companyId            String
  hazardousMaterialId  String
  version              String?
  revisionDate         DateTime?
  hazardClassification String?
  createdAt            DateTime  @default(now())

  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  hazardousMaterial HazardousMaterial @relation(fields: [hazardousMaterialId], references: [id], onDelete: Cascade)
  attachments       Document[]

  @@index([companyId])
  @@index([hazardousMaterialId])
  @@map("safety_data_sheets")
}

/// Which hazardous materials are on-site at a given project, and roughly how much — the
/// per-project inventory a site safety officer or fire marshal needs on hand. quantity is free
/// text (e.g. "2 x 5-gallon drums") rather than a structured unit/amount, since containers and
/// units vary too widely across trades to normalize usefully here.
model ProjectHazmatInventory {
  id                  String   @id @default(uuid())
  companyId           String
  projectId           String
  hazardousMaterialId String
  quantity            String?
  location            String?
  createdAt           DateTime @default(now())

  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hazardousMaterial HazardousMaterial @relation(fields: [hazardousMaterialId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@index([hazardousMaterialId])
  @@map("project_hazmat_inventory")
}

enum IncidentSeverity {
  near_miss
  first_aid
  medical_treatment
  lost_time_injury
  fatality
}

/// OSHA Form 300 log columns M1–M6 — which category of illness this recordable case falls
/// under. Left null for injuries, which OSHA 300 tracks as a plain "Injury" checkbox rather
/// than one of these illness columns (see oshaRecordable + severity for the injury case).
enum OshaCaseType {
  injury
  skin_disorder
  respiratory_condition
  poisoning
  hearing_loss
  all_other_illnesses
}

model IncidentReport {
  id                           String           @id @default(uuid())
  companyId                    String
  projectId                    String
  occurredAt                   DateTime
  severity                     IncidentSeverity
  description                  String
  location                     String?
  involvedPersons              String?
  correctiveActions            String?
  /// Whether this case meets OSHA's recordability criteria — distinct from `severity`, which is
  /// this company's own internal classification and doesn't map 1:1 onto OSHA's rules (e.g. a
  /// medical-treatment case is always recordable, but so is any case with days away from work
  /// regardless of severity label).
  oshaRecordable               Boolean          @default(false)
  oshaCaseType                 OshaCaseType?
  daysAwayFromWork             Int?
  daysJobTransferOrRestriction Int?
  reportedByUserId             String?
  reportedByName               String
  createdAt                    DateTime         @default(now())

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  photos          Document[]
  insuranceClaims InsuranceClaim[]

  @@index([projectId])
  @@index([companyId])
  @@map("incident_reports")
}

enum InsuranceClaimType {
  general_liability
  workers_comp
  property
  auto
  equipment
  other
}

enum InsuranceClaimStatus {
  filed
  under_review
  approved
  denied
  settled
  closed
}

/// A claim filed with the company's insurer — optionally tied to the IncidentReport that caused
/// it (a workers' comp or general-liability claim usually is), but not required to be: property,
/// auto, and equipment claims often have no linked safety incident at all. Likewise optionally
/// tied to a Project — a company-wide policy claim (e.g. office property damage) has none.
model InsuranceClaim {
  id               String               @id @default(uuid())
  companyId        String
  projectId        String?
  incidentReportId String?
  claimType        InsuranceClaimType
  status           InsuranceClaimStatus @default(filed)
  claimNumber      String?
  insurerName      String
  policyNumber     String?
  dateFiled        DateTime
  description      String
  adjusterName     String?
  adjusterContact  String?
  claimAmount      Decimal?             @db.Decimal(14, 2)
  /// Set once the insurer pays out — null before then, regardless of status (a claim can move to
  /// "approved" before the actual settlement amount/date is known).
  settledAmount    Decimal?             @db.Decimal(14, 2)
  settledAt        DateTime?
  notes            String?
  createdByUserId  String?
  createdByName    String
  createdAt        DateTime             @default(now())

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  incidentReport IncidentReport? @relation(fields: [incidentReportId], references: [id], onDelete: SetNull)
  documents      Document[]

  @@index([companyId])
  @@index([projectId])
  @@index([incidentReportId])
  @@map("insurance_claims")
}

/// Pre-work safety briefing ("toolbox talk") with per-worker attendance — the standard
/// evidence a commercial GC keeps to show a crew was briefed on a hazard before starting work.
model SafetyBriefing {
  id                String   @id @default(uuid())
  companyId         String
  projectId         String
  date              DateTime
  topic             String
  notes             String?
  conductedByUserId String?
  conductedByName   String
  createdAt         DateTime @default(now())

  company   Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attendees SafetyBriefingAttendance[]
  /// Alternate-language material for this briefing — one Document per language variant
  /// (discriminated by Document.locale), not a version chain (those are revisions of the same
  /// file, not parallel translations of it).
  documents Document[]

  @@index([projectId])
  @@index([companyId])
  @@map("safety_briefings")
}

model SafetyBriefingAttendance {
  id         String @id @default(uuid())
  briefingId String
  workerId   String

  briefing SafetyBriefing @relation(fields: [briefingId], references: [id], onDelete: Cascade)
  worker   Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([briefingId, workerId])
  @@map("safety_briefing_attendance")
}

/// A proactive pre-task hazard/control/PPE checklist for a specific piece of hazardous work —
/// distinct from SafetyBriefing (a reactive toolbox-talk log with no hazard/control structure)
/// and from IncidentReport (after the fact). Scoped to Project like every other safety record,
/// with an optional taskId since hazard analysis is often specific to one task type (excavation
/// vs. roofing) without needing Task to become the primary safety anchor.
model JobHazardAnalysis {
  id                String   @id @default(uuid())
  companyId         String
  projectId         String
  taskId            String?
  date              DateTime
  taskDescription   String
  hazards           String
  controlMeasures   String
  requiredPpe       String?
  conductedByUserId String?
  conductedByName   String
  createdAt         DateTime @default(now())

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task            Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  acknowledgments JhaAcknowledgment[]

  @@index([companyId])
  @@index([projectId])
  @@index([taskId])
  @@map("job_hazard_analyses")
}

/// One row per crew member who acknowledged a JHA — signedAt (not just presence, unlike
/// SafetyBriefingAttendance) is the whole point: it's what makes this a sign-off record rather
/// than an attendance list. Recorded by whoever runs the briefing at the moment of acknowledgment,
/// same as SafetyBriefingAttendance — there's no separate self-service worker-signing flow.
model JhaAcknowledgment {
  id       String   @id @default(uuid())
  jhaId    String
  workerId String
  signedAt DateTime @default(now())

  jha    JobHazardAnalysis @relation(fields: [jhaId], references: [id], onDelete: Cascade)
  worker Worker            @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([jhaId, workerId])
  @@map("jha_acknowledgments")
}

enum ObservationCategory {
  safe
  at_risk
}

/// A proactive behavior-based-safety (BBS) observation card — logged before anything goes wrong,
/// unlike IncidentReport (after the fact) or JobHazardAnalysis (before a specific task). Anyone
/// on site can log one; at_risk observations carry a correctiveAction, safe ones don't need one.
model SafetyObservation {
  id               String              @id @default(uuid())
  companyId        String
  projectId        String
  observedAt       DateTime            @default(now())
  category         ObservationCategory
  behaviorObserved String
  correctiveAction String?
  observerUserId   String?
  observerName     String
  createdAt        DateTime            @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@map("safety_observations")
}

// ---------- Submittals ----------

enum SubmittalStatus {
  draft
  submitted
  approved
  approved_as_noted
  revise_and_resubmit
  rejected
}

/// Shop-drawing / product-data approval workflow, gating procurement or installation until the
/// client/architect signs off. Revisions chain the same way Document versioning does (version +
/// rootId self-relation) — `number` stays constant across a chain, `revision` counts resubmissions.
model Submittal {
  id                String          @id @default(uuid())
  companyId         String
  projectId         String
  /// Constant across a revision chain, e.g. "SUB-001".
  number            String
  /// 0 on the first submission; each resubmission increments this within the same chain.
  revision          Int             @default(0)
  /// Null on revision 0 (the root); later revisions point back to the root's id.
  rootSubmittalId   String?
  title             String
  specSection       String?
  status            SubmittalStatus @default(draft)
  dueDate           DateTime?
  submittedAt       DateTime?
  submittedByUserId String?
  submittedByName   String?
  reviewedAt        DateTime?
  reviewedByUserId  String?
  reviewedByName    String?
  reviewComments    String?
  createdAt         DateTime        @default(now())
  escalatedAt       DateTime?

  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rootSubmittal Submittal?  @relation("SubmittalRevisions", fields: [rootSubmittalId], references: [id], onDelete: Cascade)
  revisions     Submittal[] @relation("SubmittalRevisions")

  @@index([projectId])
  @@index([companyId])
  @@index([rootSubmittalId])
  @@map("submittals")
}

enum TransmittalMethod {
  email
  mail
  hand_delivery
  courier
  portal
}

/// A formal, logged transfer of drawings/specs/submittals to a sub, architect, or owner — the
/// document-control record of what was sent, to whom, how, and (once acknowledged) confirmation
/// it was received. Items are described in free text rather than linked to specific
/// Document/DrawingSheet/Submittal rows — a transmittal commonly bundles several of those plus
/// physical items with no record of their own, and the recipient's copy is what matters for the
/// log, not a live link that could drift if the source document is later superseded.
model Transmittal {
  id                 String            @id @default(uuid())
  companyId          String
  projectId          String
  /// Sequential per project (1, 2, 3, ...).
  number             Int
  recipientName      String
  recipientCompany   String?
  method             TransmittalMethod @default(email)
  purpose            String?
  sentAt             DateTime          @default(now())
  acknowledgedAt     DateTime?
  acknowledgedByName String?
  notes              String?
  createdAt          DateTime          @default(now())

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   TransmittalItem[]

  @@unique([projectId, number])
  @@index([companyId])
  @@index([projectId])
  @@map("transmittals")
}

model TransmittalItem {
  id            String @id @default(uuid())
  transmittalId String
  description   String
  quantity      Int    @default(1)

  transmittal Transmittal @relation(fields: [transmittalId], references: [id], onDelete: Cascade)

  @@index([transmittalId])
  @@map("transmittal_items")
}

// ---------- Warranty (post-handover) ----------

enum WarrantyClaimStatus {
  open
  in_progress
  resolved
  denied
}

/// A defect reported after handover, within the project's warranty window — distinct from
/// PunchListItem, which is pre-handover QA. Can be raised internally (a phone call logged by the
/// office) or by the client themselves through the portal.
model WarrantyClaim {
  id                  String              @id @default(uuid())
  companyId           String
  projectId           String
  title               String
  description         String?
  location            String?
  status              WarrantyClaimStatus @default(open)
  submittedByClientId String?
  submittedByUserId   String?
  submittedByName     String
  assigneeWorkerId    String?
  resolvedAt          DateTime?
  resolvedByUserId    String?
  resolvedByName      String?
  resolutionNotes     String?
  /// Cost of the actual repair, entered on resolve() — independent of how much (if any) gets
  /// recovered from a subcontractor via a linked SubcontractorBackcharge; see backcharges below.
  repairCost          Decimal?            @db.Decimal(14, 2)
  deniedAt            DateTime?
  deniedByUserId      String?
  deniedByName        String?
  denialReason        String?
  createdAt           DateTime            @default(now())

  company           Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project           Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedByClient Client?                   @relation(fields: [submittedByClientId], references: [id], onDelete: SetNull)
  assignee          Worker?                   @relation(fields: [assigneeWorkerId], references: [id], onDelete: SetNull)
  photos            Document[]
  backcharges       SubcontractorBackcharge[]

  @@index([projectId])
  @@index([companyId])
  @@map("warranty_claims")
}

enum WarrantyCoverageType {
  material
  labor
  both
}

/// What is actually under warranty, and until when — WarrantyClaim itself has no term or
/// expiration, so there was previously no way to know if a claim is still in-warranty before
/// filing it. expirationDate is stored (not computed live) so editing termMonths later doesn't
/// retroactively change a registration's original coverage window; scope is free text (e.g.
/// "Roofing", "Plumbing") rather than a fixed enum since coverage breakdowns vary by trade and
/// contract.
model WarrantyRegistration {
  id             String               @id @default(uuid())
  companyId      String
  projectId      String
  scope          String
  manufacturer   String?
  coverageType   WarrantyCoverageType @default(both)
  termMonths     Int
  startDate      DateTime
  expirationDate DateTime
  notes          String?
  createdAt      DateTime             @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@map("warranty_registrations")
}

/// A recurring maintenance agreement beyond the initial warranty window — e.g. quarterly HVAC
/// service. nextVisitDate drives the reminder job (see ServiceVisitsSchedulerService) and is
/// advanced whenever a ServiceVisit under this contract is scheduled.
model ServiceContract {
  id              String   @id @default(uuid())
  companyId       String
  projectId       String
  clientId        String
  title           String
  frequencyMonths Int
  startDate       DateTime
  nextVisitDate   DateTime
  active          Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  visits  ServiceVisit[]

  @@index([companyId])
  @@index([projectId])
  @@map("service_contracts")
}

model ServiceVisit {
  id                  String    @id @default(uuid())
  serviceContractId   String
  companyId           String
  scheduledDate       DateTime
  completedAt         DateTime?
  notes               String?
  technicianWorkerId  String?
  /// Unauthenticated token embedded in the post-visit satisfaction survey link.
  feedbackToken       String    @unique
  satisfactionRating  Int?
  satisfactionComment String?
  createdAt           DateTime  @default(now())

  serviceContract ServiceContract @relation(fields: [serviceContractId], references: [id], onDelete: Cascade)
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  technician      Worker?         @relation(fields: [technicianWorkerId], references: [id], onDelete: SetNull)

  @@index([serviceContractId])
  @@index([companyId])
  @@map("service_visits")
}

/// Threaded discussion on a Task/Rfi/PunchListItem — same "one nullable FK column per target
/// model" polymorphic-attachment pattern already established by Document, rather than a generic
/// polymorphic join table.
model Comment {
  id           String   @id @default(uuid())
  companyId    String
  authorUserId String?
  authorName   String
  content      String
  createdAt    DateTime @default(now())

  taskId          String?
  rfiId           String?
  punchListItemId String?
  /// A project-wide channel — the general "group chat" attachment point, alongside the
  /// narrower task/RFI/punch-list threads above.
  projectId       String?

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author        User?            @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  task          Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  rfi           Rfi?             @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  punchListItem PunchListItem?   @relation(fields: [punchListItemId], references: [id], onDelete: Cascade)
  project       Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mentions      CommentMention[]

  @@index([companyId])
  @@index([taskId])
  @@index([rfiId])
  @@index([punchListItemId])
  @@index([projectId])
  @@map("comments")
}

/// A client-visible message thread on one project, separate from the internal Comment/RFI/punch-
/// list threads on purpose — those can carry internal-only discussion, and reusing that model for
/// client-facing chat would risk leaking it across the portal boundary. Exactly one of
/// authorUserId (staff) / authorClientId (client, via the portal) is set per message.
model PortalMessage {
  id             String   @id @default(uuid())
  companyId      String
  projectId      String
  authorUserId   String?
  authorClientId String?
  authorName     String
  content        String
  createdAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  client  Client? @relation(fields: [authorClientId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@map("portal_messages")
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

enum TicketStatus {
  open
  in_progress
  waiting_on_customer
  resolved
  closed
}

/// Per-priority response/resolution targets, applied to a ticket's slaResponseDueAt/
/// slaResolutionDueAt at creation time — SupportTicketsService computes "past due" live by
/// comparing against these stamped deadlines rather than running a background job.
model SlaPolicy {
  id                String         @id @default(uuid())
  companyId         String
  priority          TicketPriority
  responseMinutes   Int
  resolutionMinutes Int

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, priority])
  @@map("sla_policies")
}

/// A support ticket — distinct from PortalMessage's free-form per-project chat: this has a
/// lifecycle (status, priority, SLA deadlines, assignment) suited to accountable post-sale
/// support (warranty questions, portal access issues, billing disputes) rather than ad hoc
/// project conversation. requesterClientId is optional since staff can also file an internal
/// ticket with no client attached, in which case requesterName/requesterEmail carry the contact.
model SupportTicket {
  id                 String         @id @default(uuid())
  companyId          String
  projectId          String?
  requesterClientId  String?
  requesterName      String
  requesterEmail     String?
  subject            String
  category           String?
  priority           TicketPriority @default(medium)
  status             TicketStatus   @default(open)
  assignedToUserId   String?
  slaResponseDueAt   DateTime?
  slaResolutionDueAt DateTime?
  firstRespondedAt   DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime       @default(now())

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  requesterClient Client?         @relation(fields: [requesterClientId], references: [id], onDelete: SetNull)
  assignedTo      User?           @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages        TicketMessage[]

  @@index([companyId])
  @@index([projectId])
  @@index([requesterClientId])
  @@map("support_tickets")
}

/// isInternal marks a staff-only note invisible to the client-portal "My Tickets" thread — every
/// message a portal client posts is public by construction (the portal has no internal-note UI).
model TicketMessage {
  id           String   @id @default(uuid())
  companyId    String
  ticketId     String
  content      String
  authorName   String
  authorUserId String?
  isInternal   Boolean  @default(false)
  createdAt    DateTime @default(now())

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ticket  SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([ticketId])
  @@map("ticket_messages")
}

/// Marks one derived notification item (identified by its stable NotificationItem.key) as read
/// by a user. The notification feed itself is computed on the fly (see NotificationsService) —
/// this is the only persisted state, so "unread" is just "no row here yet".
model NotificationRead {
  id              String   @id @default(uuid())
  companyId       String
  userId          String
  notificationKey String
  readAt          DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationKey])
  @@index([companyId])
  @@map("notification_reads")
}

enum DashboardWidgetType {
  revenue_trend
  cash_flow_forecast
  project_margins
  portfolio_summary
  invoice_aging
  warehouse_turnover
  labor_cost
  custom_report
  backlog
  compliance_calendar
}

/// One tile on a user's own configurable dashboard. Every widget renders from an *existing*
/// report/insight endpoint (see ReportsService) rather than a new query engine — config just
/// carries the extra parameter a given type needs (e.g. customReportId, or a trailing-months window).
model DashboardWidget {
  id        String              @id @default(uuid())
  companyId String
  userId    String
  type      DashboardWidgetType
  config    Json?
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@map("dashboard_widgets")
}

/// A user @mentioned in a Comment — explicit rows captured from the picker UI (not parsed out of
/// free text) so a mentioned name containing spaces is never ambiguous. Feeds NotificationsService
/// as another derived notification branch, same as the rest of that module.
model CommentMention {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
  @@map("comment_mentions")
}

/// A planned future allocation of a Worker OR Equipment to a Project over a date range — distinct
/// from TimeEntry (actual hours already worked) and EquipmentAssignment (live checkout/checkin
/// with no planned end date). Powers the cross-project resource-planning calendar; double-booking
/// is detected by the service from overlapping date ranges on the same resource, not prevented at
/// the schema level — a real scheduling conflict needs to be seen and resolved, not silently blocked.
/// A named, reusable group of workers (e.g. "Framing Crew A") — lets a foreman bulk-assign the
/// whole group to a project in one action instead of one ResourceAssignment at a time. Crews
/// themselves don't carry a schedule; each member still gets its own ResourceAssignment row
/// (tagged with crewId) so per-worker conflict detection keeps working unchanged.
model Crew {
  id        String   @id @default(uuid())
  companyId String
  name      String
  createdAt DateTime @default(now())

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members             CrewMember[]
  resourceAssignments ResourceAssignment[]

  @@index([companyId])
  @@map("crews")
}

model CrewMember {
  id       String @id @default(uuid())
  crewId   String
  workerId String

  crew   Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([crewId, workerId])
  @@index([crewId])
  @@index([workerId])
  @@map("crew_members")
}

model ResourceAssignment {
  id          String   @id @default(uuid())
  companyId   String
  projectId   String
  /// Optional: pins the assignment to a specific task instead of just the project, so the
  /// workload heatmap and Gantt can show who's on what, not just who's on the project.
  taskId      String?
  workerId    String?
  equipmentId String?
  /// Set when this assignment was created as part of a bulk crew-assign — groups rows in the
  /// timeline/heatmap by crew without changing how individual-worker conflict detection works.
  crewId      String?
  startDate   DateTime
  endDate     DateTime
  note        String?
  createdAt   DateTime @default(now())

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  worker    Worker?    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  equipment Equipment? @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  crew      Crew?      @relation(fields: [crewId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@index([taskId])
  @@index([workerId])
  @@index([equipmentId])
  @@index([crewId])
  @@map("resource_assignments")
}

enum ChecklistTemplateType {
  punch_list
  rfi
  safety_briefing
  jha
}

/// A reusable, company-defined template. Shape depends on `type`: punch_list templates carry
/// multiple `items` that get bulk-applied onto a project's punch list in one action; rfi and
/// safety_briefing templates are single-entry prefill text (defaultSubject/defaultBody) that the
/// frontend copies into a new RFI/briefing form — there's nothing to "apply" server-side for those.
model ChecklistTemplate {
  id                     String                @id @default(uuid())
  companyId              String
  type                   ChecklistTemplateType
  name                   String
  defaultSubject         String?
  defaultBody            String?
  /// Only meaningful for type=jha — defaultSubject doubles as the default task description for
  /// that type, same reuse-not-duplicate reasoning as punch_list reusing `items` instead of a
  /// jha-specific list field.
  defaultHazards         String?
  defaultControlMeasures String?
  defaultPpe             String?
  createdAt              DateTime              @default(now())

  /// Bumped on every edit — update() never mutates items/hazard fields in place, it clones a new
  /// row so a past inspection's audit trail always points at the exact configuration used, not
  /// whatever the template looks like today. archivedAt marks a superseded version; list() only
  /// returns the current (non-archived) version of each template lineage.
  version           Int       @default(1)
  archivedAt        DateTime?
  previousVersionId String?   @unique

  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items           ChecklistTemplateItem[]
  previousVersion ChecklistTemplate?      @relation("ChecklistTemplateVersions", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersion     ChecklistTemplate?      @relation("ChecklistTemplateVersions")

  @@index([companyId])
  @@map("checklist_templates")
}

model ChecklistTemplateItem {
  id          String  @id @default(uuid())
  templateId  String
  title       String
  description String?
  location    String?
  sortOrder   Int     @default(0)

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("checklist_template_items")
}

/// A reusable, company-wide checklist of what to check for a given trade (e.g. "Electrical
/// rough-in") — cloned into a fresh InspectionChecklist each time an inspection is run, same
/// clone-on-use pattern as the worker onboarding template.
model InspectionTemplate {
  id        String   @id @default(uuid())
  companyId String
  name      String
  trade     String
  createdAt DateTime @default(now())

  company Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   InspectionTemplateItem[]

  @@index([companyId])
  @@map("inspection_templates")
}

model InspectionTemplateItem {
  id                   String @id @default(uuid())
  inspectionTemplateId String
  description          String
  sortOrder            Int    @default(0)

  template InspectionTemplate @relation(fields: [inspectionTemplateId], references: [id], onDelete: Cascade)

  @@index([inspectionTemplateId])
  @@map("inspection_template_items")
}

enum InspectionStatus {
  open
  passed
  failed
}

enum InspectionItemResult {
  pending
  pass
  fail
  na
}

/// One run of a trade/phase inspection against a project — a checklist instance, distinct from
/// the reusable InspectionTemplate it may have been cloned from (templateId is nullable so an
/// inspector can also start one ad hoc, with no template).
model InspectionChecklist {
  id                String           @id @default(uuid())
  companyId         String
  projectId         String
  templateId        String?
  name              String
  trade             String
  phase             String?
  status            InspectionStatus @default(open)
  inspectorWorkerId String?
  inspectedAt       DateTime?
  createdAt         DateTime         @default(now())

  company   Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inspector Worker?                   @relation(fields: [inspectorWorkerId], references: [id], onDelete: SetNull)
  items     InspectionChecklistItem[]

  @@index([companyId])
  @@index([projectId])
  @@map("inspection_checklists")
}

model InspectionChecklistItem {
  id                    String               @id @default(uuid())
  inspectionChecklistId String
  description           String
  result                InspectionItemResult @default(pending)
  notes                 String?
  sortOrder             Int                  @default(0)

  checklist    InspectionChecklist @relation(fields: [inspectionChecklistId], references: [id], onDelete: Cascade)
  deficiencies Deficiency[]

  @@index([inspectionChecklistId])
  @@map("inspection_checklist_items")
}

enum DeficiencySeverity {
  minor
  major
  critical
}

enum DeficiencyStatus {
  open
  resolved
  verified
}

/// A QC-found defect, distinct from the general PunchListItem: it's raised from a failed
/// inspection checklist item (or ad hoc during an inspection) rather than a general project
/// punch item, so QC pass/fail rates can be reported on separately from punch-list closeout.
/// Same open -> resolved -> verified two-step closeout convention as PunchListItem.
model Deficiency {
  id                        String             @id @default(uuid())
  companyId                 String
  projectId                 String
  inspectionChecklistItemId String?
  description               String
  severity                  DeficiencySeverity
  status                    DeficiencyStatus   @default(open)
  assigneeWorkerId          String?
  dueDate                   DateTime?
  createdAt                 DateTime           @default(now())
  resolvedAt                DateTime?
  verifiedAt                DateTime?
  /// Free-text zone/floor/area (e.g. "3rd floor — east wing") for the heat-map report — see
  /// DeficienciesService.heatMap(). Not a fixed taxonomy, same as PunchListItem.location, since
  /// building zone naming varies too much project to project for a shared enum to hold up.
  location                  String?

  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project                 Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inspectionChecklistItem InspectionChecklistItem? @relation(fields: [inspectionChecklistItemId], references: [id], onDelete: SetNull)
  assignee                Worker?                  @relation(fields: [assigneeWorkerId], references: [id], onDelete: SetNull)
  photos                  Document[]

  @@index([companyId])
  @@index([projectId])
  @@index([inspectionChecklistItemId])
  @@map("deficiencies")
}

enum CommissioningSystemStatus {
  pending_testing
  testing
  complete
}

/// One MEP/building system going through commissioning (Cx) on a project — e.g. "AHU-1 (HVAC)"
/// or "Fire Alarm Panel". Distinct from the general Quality module's InspectionChecklist: this is
/// functional-performance testing and owner training/sign-off for systems startup, not
/// workmanship inspection.
model CommissioningSystem {
  id        String                    @id @default(uuid())
  companyId String
  projectId String
  name      String
  category  String?
  status    CommissioningSystemStatus @default(pending_testing)
  createdAt DateTime                  @default(now())

  company          Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project          Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checklistItems   CommissioningChecklistItem[]
  functionalTests  FunctionalTest[]
  trainingSessions OwnerTrainingSession[]

  @@index([companyId])
  @@index([projectId])
  @@map("commissioning_systems")
}

model CommissioningChecklistItem {
  id              String    @id @default(uuid())
  systemId        String
  description     String
  done            Boolean   @default(false)
  completedAt     DateTime?
  completedByName String?

  system CommissioningSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@index([systemId])
  @@map("commissioning_checklist_items")
}

enum FunctionalTestResult {
  pass
  fail
}

model FunctionalTest {
  id           String               @id @default(uuid())
  systemId     String
  procedure    String
  result       FunctionalTestResult
  testedByName String
  testedAt     DateTime             @default(now())
  notes        String?

  system CommissioningSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@index([systemId])
  @@map("functional_tests")
}

/// The owner-training/handover step of commissioning a system — kept separate from
/// ProjectCloseoutPanel's general closeout package since it's per-system, not per-project.
model OwnerTrainingSession {
  id               String    @id @default(uuid())
  systemId         String
  trainerName      String
  trainingDate     DateTime
  attendeeNames    String?
  ownerSignedOffAt DateTime?
  ownerSignerName  String?
  createdAt        DateTime  @default(now())

  system CommissioningSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@index([systemId])
  @@map("owner_training_sessions")
}

/// One concrete placement event on a project — location, mix design, and the specified strength
/// it's being tested against. QC records (slump, cylinder breaks) hang off this rather than off
/// the project directly, since a project has many pours over its life and each pour's tests only
/// make sense grouped together.
model ConcretePour {
  id                String   @id @default(uuid())
  companyId         String
  projectId         String
  location          String
  pourDate          DateTime
  mixDesign         String?
  /// Cubic yards or cubic meters per the company's unit system — not converted or labeled here,
  /// same "raw number, company decides the unit" convention as other quantity fields in this schema.
  volume            Decimal? @db.Decimal(10, 2)
  specifiedStrength Decimal? @db.Decimal(10, 2)
  specifiedSlump    Decimal? @db.Decimal(6, 2)
  supplierName      String?
  notes             String?
  createdAt         DateTime @default(now())

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slumpTests     SlumpTest[]
  cylinderBreaks CylinderBreak[]

  @@index([companyId])
  @@index([projectId])
  @@map("concrete_pours")
}

/// Slump is measured on-site at time of placement and judged against spec by whoever tests it —
/// withinSpec is an explicit call from the tester, not computed here, since a slump spec is
/// normally a tolerance range (e.g. "4in ± 1in") that this schema doesn't model as two numbers.
model SlumpTest {
  id           String   @id @default(uuid())
  pourId       String
  testedAt     DateTime @default(now())
  slumpValue   Decimal  @db.Decimal(6, 2)
  withinSpec   Boolean
  testedByName String
  notes        String?

  pour ConcretePour @relation(fields: [pourId], references: [id], onDelete: Cascade)

  @@index([pourId])
  @@map("slump_tests")
}

enum CylinderBreakResult {
  pass
  fail
}

/// One test cylinder from a pour, broken at a given age (7-day, 28-day, etc.) — result is derived
/// from breakStrength vs. the parent pour's specifiedStrength once a strength is recorded (see
/// classifyCylinderBreak); staying null both before testing and when the pour has no spec to
/// compare against, since neither case is a pass or a fail.
model CylinderBreak {
  id            String               @id @default(uuid())
  pourId        String
  cylinderLabel String
  breakAgeDays  Int
  breakDate     DateTime
  breakStrength Decimal?             @db.Decimal(10, 2)
  result        CylinderBreakResult?
  testedByName  String?
  notes         String?
  createdAt     DateTime             @default(now())

  pour ConcretePour @relation(fields: [pourId], references: [id], onDelete: Cascade)

  @@index([pourId])
  @@map("cylinder_breaks")
}

enum CustomFieldEntityType {
  project
  client
}

enum CustomFieldType {
  text
  number
  date
  boolean
  select
}

/// Company-defined extra field on Project or Client records — "select" uses `options` as the
/// allowed values; every other type stores free-form text and is validated client-side only.
model CustomFieldDefinition {
  id         String                @id @default(uuid())
  companyId  String
  entityType CustomFieldEntityType
  name       String
  type       CustomFieldType
  options    String[]              @default([])
  sortOrder  Int                   @default(0)
  createdAt  DateTime              @default(now())

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  values  CustomFieldValue[]

  @@unique([companyId, entityType, name])
  @@index([companyId])
  @@map("custom_field_definitions")
}

/// entityId is polymorphic (a Project.id or a Client.id, per the parent field's entityType) —
/// one column can't FK two tables, so ownership is checked at the application layer instead.
model CustomFieldValue {
  id       String  @id @default(uuid())
  fieldId  String
  entityId String
  value    String?

  field CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, entityId])
  @@index([entityId])
  @@map("custom_field_values")
}

/// A user's personal saved filter/sort configuration for a list page (viewType is a free-form
/// key the frontend defines, e.g. "projects" or "clients"); `filters` is opaque JSON the
/// frontend owns the shape of — the backend just stores and returns it.
model SavedView {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  viewType  String
  name      String
  filters   Json
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, viewType, name])
  @@index([companyId])
  @@map("saved_views")
}

enum ReportDataset {
  projects
  invoices
  estimates
  time_entries
  punch_list
  rfis
  revenue_by_month
  project_margins
  labor_utilization
}

/// A saved custom-report definition: pick a dataset, pick columns from that dataset's fixed
/// field list, optionally filter by date range (each dataset has one built-in date field) and
/// by status (ignored for datasets with no status field). Company-wide, not per-user — reports
/// are a team asset, unlike SavedView's personal list filters.
model CustomReport {
  id           String        @id @default(uuid())
  companyId    String
  userId       String
  name         String
  dataset      ReportDataset
  columns      String[]
  dateFrom     DateTime?
  dateTo       DateTime?
  statusEquals String?
  createdAt    DateTime      @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("custom_reports")
}

enum AccountingProvider {
  quickbooks
  xero
}

/// One connected accounting system per company. Absence of a row means "not connected" — no
/// nullable-flag-on-Company needed since the row itself carries the provider + tokens.
model AccountingConnection {
  id                String             @id @default(uuid())
  companyId         String             @unique
  provider          AccountingProvider
  accessToken       String
  refreshToken      String
  tokenExpiresAt    DateTime
  /// QuickBooks: realm (company) ID, returned on the OAuth callback. Xero: tenant ID, fetched
  /// from GET /connections right after token exchange since Xero doesn't return it on the callback.
  externalAccountId String
  connectedAt       DateTime           @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("accounting_connections")
}

enum AccountingSyncStatus {
  success
  failed
}

/// One row per invoice sync attempt (success or failure) — the persistent trail that
/// AccountingSyncService.syncInvoices()'s previously-transient SyncSummary lacked, so a failure
/// is still visible after the page that showed the toast is long gone.
/// One attempt to push either an AR record (Invoice) or an AP record (SubcontractorCost, as a
/// Bill) to the connected provider — exactly one of the invoice/subcontractorCost id+label pairs
/// is set per row, mirroring the optional-attachment-point convention Document already uses.
model AccountingSyncLog {
  id                         String               @id @default(uuid())
  companyId                  String
  provider                   AccountingProvider
  invoiceId                  String?
  invoiceNumber              String?
  subcontractorCostId        String?
  subcontractorCostReference String?
  status                     AccountingSyncStatus
  errorMessage               String?
  attemptedAt                DateTime             @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, status])
  @@map("accounting_sync_logs")
}

/// A weekly owner/architect/contractor (OAC) meeting log for a project — minutes with a
/// free-text attendee list and a set of action items tracked to close-out. Deliberately no
/// polymorphic "meeting type" field: this covers any recurring project meeting (OAC, safety,
/// subcontractor coordination, etc.), distinguished only by its title.
model Meeting {
  id              String   @id @default(uuid())
  companyId       String
  projectId       String
  /// Sequential per project, e.g. meeting #4 — same numbering convention as Transmittal.number.
  number          Int
  title           String
  meetingDate     DateTime
  location        String?
  attendees       String[] @default([])
  notes           String?
  createdByUserId String?
  createdByName   String
  createdAt       DateTime @default(now())

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actionItems MeetingActionItem[]

  @@index([companyId])
  @@index([projectId])
  @@map("meetings")
}

enum MeetingActionItemStatus {
  open
  done
}

model MeetingActionItem {
  id               String                  @id @default(uuid())
  meetingId        String
  description      String
  ownerName        String
  dueDate          DateTime?
  status           MeetingActionItemStatus @default(open)
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedByName   String?
  createdAt        DateTime                @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_action_items")
}

enum LongLeadItemStatus {
  tracking
  ordered
  in_fabrication
  shipped
  delivered
}

/// Tracks a procurement item whose lead time is long enough to threaten the schedule on its own
/// (elevators, switchgear, curtain wall) independent of the warehouse-restocking PurchaseOrder
/// flow — a PurchaseOrder here is optional and only linked once one has actually been cut.
/// requiredOnSiteDate is entered manually rather than pulled from a Task, since these items are
/// usually identified during estimating/procurement planning, before the detailed schedule exists.
model LongLeadItem {
  id                    String             @id @default(uuid())
  companyId             String
  projectId             String
  description           String
  supplierId            String?
  purchaseOrderId       String?
  status                LongLeadItemStatus @default(tracking)
  submittalApprovalDate DateTime?
  orderedDate           DateTime?
  expectedDeliveryDate  DateTime?
  actualDeliveryDate    DateTime?
  requiredOnSiteDate    DateTime?
  notes                 String?
  createdByUserId       String?
  createdByName         String
  createdAt             DateTime           @default(now())

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@map("long_lead_items")
}

/// Moves budget between two cost codes on the same project — e.g. $10k from Concrete (which came
/// in under) to Electrical (which is trending over) — so JobCostingService.report()'s "estimated"
/// column reflects where the money is actually allocated now, with an audit trail of why. Same
/// signed-log shape as BudgetRevision, but between two cost codes on one project rather than
/// adjusting the project's total.
model CostCodeBudgetTransfer {
  id              String   @id @default(uuid())
  companyId       String
  projectId       String
  fromCostCodeId  String
  toCostCodeId    String
  amount          Decimal  @db.Decimal(14, 2)
  reason          String
  createdByUserId String?
  createdByName   String
  createdAt       DateTime @default(now())

  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromCostCode CostCode @relation("CostCodeBudgetTransferFrom", fields: [fromCostCodeId], references: [id], onDelete: Restrict)
  toCostCode   CostCode @relation("CostCodeBudgetTransferTo", fields: [toCostCodeId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([projectId])
  @@map("cost_code_budget_transfers")
}
