generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum MembershipRole {
  owner
  admin
  estimator
  foreman
  accountant
  worker
}

enum EmailDigestFrequency {
  off
  daily
  weekly
}

enum UnitSystem {
  metric
  imperial
}

enum Currency {
  EUR
  USD
  GBP
  CHF
  CAD
}

enum Locale {
  en
  de
  es
  pl
  uk
}

/// Static/seeded conversion rates between the five supported currencies — there's no live forex
/// feed wired up (no API key available), so these are refreshed manually via a seed script rather
/// than a scheduled job. One row per direction (EUR→USD and USD→EUR are stored separately) so a
/// lookup is always a single indexed read, never an inversion at query time.
model ExchangeRate {
  id           String   @id @default(uuid())
  fromCurrency Currency
  toCurrency   Currency
  rate         Decimal  @db.Decimal(14, 6)
  updatedAt    DateTime @updatedAt

  @@unique([fromCurrency, toCurrency])
  @@map("exchange_rates")
}

enum SubscriptionStatus {
  incomplete
  active
  past_due
  canceled
}

enum EstimateStatus {
  draft
  /// Above the company's approval threshold — some but not all required internal approvals recorded yet.
  pending_approval
  approved
}

enum EstimateClientDecision {
  pending
  approved
  rejected
  /// Client proposes a different price instead of a flat approve/reject — see
  /// Estimate.counterOfferAmount. Terminal like approved/rejected: the PM responds by creating a
  /// new variant (EstimatesService.createVariant, already existed) with revised pricing and
  /// sending that instead, rather than this row ever transitioning again.
  countered
}

enum InvoiceStatus {
  draft
  sent
  paid
  void
}

enum RecurringInvoiceFrequency {
  weekly
  monthly
  quarterly
  yearly
}

enum StockMovementType {
  receipt
  issue
  transfer
  write_off
}

/// in_transit: debited from the source warehouse already, not yet credited to the destination —
/// goods are physically between the two. received: credited to the destination, terminal.
/// cancelled: credited back to the source, terminal. See StockTransfer.
enum StockTransferStatus {
  in_transit
  received
  cancelled
}

/// weighted_average: StockLevel.averageCost blends every receipt into one running per-unit cost.
/// fifo: InventoryCostLayer rows track each receipt separately, consumed oldest-first on issue.
enum InventoryCostingMethod {
  fifo
  weighted_average
}

enum TaskStatus {
  planned
  in_progress
  done
}

enum PurchaseOrderStatus {
  draft
  ordered
  partially_received
  received
}

enum ClientStage {
  lead
  contacted
  qualified
  won
  lost
}

enum WeatherCondition {
  clear
  cloudy
  rain
  snow
  extreme_heat
  extreme_cold
  other
}

/// open: logged, not yet fixed. resolved: assignee says it's fixed. verified: a second person
/// (typically the one who logged it, or a PM) confirmed the fix — the standard two-step
/// punch-list closeout so the same person doesn't both fix and sign off on their own work.
enum PunchListItemStatus {
  open
  resolved
  verified
}

enum RfiStatus {
  open
  answered
  closed
}

enum RfiPriority {
  low
  medium
  high
}

/// Who needs to act next — unlike status (open/answered/closed), this doesn't follow automatically
/// from the RFI's own fields since there's no fixed external-reviewer step in this model; it's a
/// manually-set field so a PM can see at a glance whose desk something is sitting on.
enum BallInCourtParty {
  internal
  client
  subcontractor
}

// ---------- Tenancy & Identity ----------

model Company {
  id                                   String                 @id @default(uuid())
  name                                 String
  unitSystem                           UnitSystem             @default(metric)
  currency                             Currency               @default(EUR)
  locale                               Locale                 @default(en)
  country                              String // ISO 3166-1 alpha-2
  createdAt                            DateTime               @default(now())
  onboardingCompletedAt                DateTime?
  /// Storage key for the uploaded logo image (PNG/JPEG — pdfkit can't rasterize SVG), read back via StorageService.
  logoStorageKey                       String?
  logoMimeType                         String?
  /// Hex color (e.g. "#465fff") used as the accent on generated estimate/invoice PDFs.
  brandColor                           String?
  /// Estimates at or above this amount need `requiredApprovalCount` distinct internal
  /// approvals before they can be finalized — null disables the chain (single-click approve).
  approvalThresholdAmount              Decimal?               @db.Decimal(14, 2)
  requiredApprovalCount                Int                    @default(1)
  /// Same threshold-gated multi-approver chain, applied to change orders instead of estimates.
  changeOrderApprovalThresholdAmount   Decimal?               @db.Decimal(14, 2)
  changeOrderRequiredApprovalCount     Int                    @default(1)
  /// When true, a Client sitting in stage=lead with no stage change gets automated day-1/3/7
  /// follow-up emails — off by default, same "unsolicited email" reasoning as invoiceRemindersEnabled.
  leadFollowUpEnabled                  Boolean                @default(false)
  /// When true, an Estimate sent to the client and still clientDecision=pending gets the same
  /// escalating-reminder treatment invoices already get.
  estimateRemindersEnabled             Boolean                @default(false)
  /// Same escalating-reminder treatment, applied to a ChangeOrder sent to the client and still
  /// clientDecision=pending, via ChangeOrderRemindersService.
  changeOrderRemindersEnabled          Boolean                @default(false)
  /// When true, EnpsSurveyService's quarterly pass texts every active worker with a phone an
  /// anonymous-in-the-UI 0-10 "how likely to recommend working here" question — off by default,
  /// same "unsolicited message" reasoning as workerSmsNotificationsEnabled.
  enpsSurveysEnabled                   Boolean                @default(false)
  /// Last time a quarterly eNPS wave went out — null means never. EnpsSurveyService advances this
  /// by ~90 days per wave rather than using a fixed calendar schedule, so turning the toggle off
  /// and back on later doesn't immediately fire a wave.
  lastEnpsSentAt                       DateTime?
  /// Fraction of budgeted cost (materials + labor + subcontractor actuals) spent before
  /// NotificationsService.budgetAlerts flags a project — was a hard-coded 90 for every company;
  /// Project.budgetAlertThresholdPercent overrides this for one project (e.g. a fixed-price
  /// contract the PM wants watched tighter).
  budgetAlertThresholdPercent          Int                    @default(90)
  /// Monthly late-fee rate applied to an overdue invoice's outstanding balance (e.g. 1.5 for
  /// 1.5%/month) — see calculateLateFee. Null disables late fees entirely; this is never applied
  /// automatically, only ever shown as an accrued amount until InvoicesService.chargeLateFee adds
  /// it as a real line, so a company can quote it to a client before actually billing it.
  lateFeePercentPerMonth               Decimal?               @db.Decimal(5, 2)
  /// Fully-loaded labor rate components — see labor-burden.ts. Each is a percentage added on top
  /// of Worker.hourlyCost (e.g. payrollTaxBurdenPercent=10 means +10% for employer-side FICA/
  /// FUTA/SUTA); null means that component isn't tracked, same "null disables" convention as
  /// lateFeePercentPerMonth above. Company-wide only — no per-worker override exists, since these
  /// are jurisdiction/policy rates that don't vary person-to-person the way a wage does.
  payrollTaxBurdenPercent              Decimal?               @db.Decimal(5, 2)
  workersCompBurdenPercent             Decimal?               @db.Decimal(5, 2)
  benefitsBurdenPercent                Decimal?               @db.Decimal(5, 2)
  otherBurdenPercent                   Decimal?               @db.Decimal(5, 2)
  /// Gates SubcontractorsService.assign() alongside the existing insurance-document check —
  /// null/false leaves prequalification purely informational, as it's been since the module was
  /// added. When requireSubcontractorPrequalification is true, assign() requires an
  /// approved, non-expired SubcontractorPrequalification cycle; subcontractorEmrThreshold (when
  /// set) additionally rejects a safetyEmrRating above it, independent of the require-approval flag.
  requireSubcontractorPrequalification Boolean                @default(false)
  subcontractorEmrThreshold            Decimal?               @db.Decimal(4, 2)
  /// Default "net" payment terms in days, used to compute Invoice.dueDate on send() when it
  /// wasn't already set explicitly — Client.paymentTermsDays overrides this per client.
  defaultPaymentTermsDays              Int                    @default(30)
  /// Days after creation an open RFI/punch list item may stay unanswered/unresolved before
  /// it's auto-escalated (flagged + emailed to the company owner) — null disables escalation.
  rfiSlaDays                           Int?
  punchListSlaDays                     Int?
  /// Same escalation treatment as rfiSlaDays/punchListSlaDays, but Submittal already carries its
  /// own per-item dueDate (set when the submittal is created), so there's no days-count to
  /// configure — just an on/off gate, mirroring invoiceRemindersEnabled's boolean-toggle shape.
  submittalEscalationEnabled           Boolean                @default(false)
  /// How StockMovement/StockLevel value inventory on issue/write-off — see InventoryCostingMethod.
  /// Changing this only affects movements recorded after the change; it doesn't retroactively
  /// recost history.
  inventoryCostingMethod               InventoryCostingMethod @default(weighted_average)
  /// A RateCatalogItem edit changing laborHoursPerUnit by more than this percentage (either
  /// direction) is held as a RateCatalogItemPendingChange instead of applying immediately — null
  /// disables gating entirely, so every edit applies at once, same as before this field existed.
  rateCatalogApprovalThresholdPercent  Decimal?               @db.Decimal(5, 2)
  /// When true, a client's NPS response at or below the detractor cutoff (see nps-surveys.service.ts)
  /// creates a follow-up Task on the project and emails the company owner(s) — off by default,
  /// same "no unsolicited automation" reasoning as invoiceRemindersEnabled.
  npsDetractorFollowUpEnabled          Boolean                @default(false)
  /// When true, overdue invoices get automatic escalating reminder emails to the client (see
  /// InvoiceReminderService) — off by default since it sends unsolicited email on the company's behalf.
  invoiceRemindersEnabled              Boolean                @default(false)
  /// SMS to a worker's phone (in their preferredLocale) when assigned to a task, or when a
  /// safety briefing they're listed on is created — off by default, same "unsolicited message"
  /// reasoning as invoiceRemindersEnabled. SmsService itself no-ops (logs only) when Twilio
  /// isn't configured, same graceful-degrade as MailService without SMTP_HOST.
  workerSmsNotificationsEnabled        Boolean                @default(false)
  /// Public, unauthenticated token embedded in the company's lead-capture form URL — null disables the form entirely.
  publicLeadFormToken                  String?                @unique
  /// Vanity domain (e.g. "portal.mycompany.com") the client portal is branded for once verified —
  /// null means no custom domain requested. Setting it alone doesn't activate anything: the
  /// customer must point a CNAME at us (see PortalBrandingService.CNAME_TARGET) and the domain
  /// must actually resolve there before verifyCustomPortalDomain() sets the verified timestamp.
  /// Note this covers branding only — routing browser traffic for the domain to this app (DNS
  /// beyond the CNAME check, plus a TLS certificate for it) is infrastructure/ops work outside
  /// what application code can provision.
  customPortalDomain                   String?                @unique
  customPortalDomainVerifiedAt         DateTime?
  /// Enterprise SSO (SAML 2.0) — all four null means SSO is off for this company. When set,
  /// a user whose email matches ssoDomain is routed to the IdP at ssoEntryPoint instead of
  /// password login, and is just-in-time provisioned (as "worker") on first successful sign-in.
  /// ssoIssuer/ssoCert describe the IdP (its entity ID and signing certificate) — our own SP
  /// entity ID is derived per-company, not stored here.
  ssoDomain                            String?                @unique
  ssoEntryPoint                        String?
  ssoIssuer                            String?
  ssoCert                              String?
  /// GDPR Art. 17 account-deletion request — set when an owner/admin asks to close the
  /// account; null means no request is pending. Actual deletion is a manual support-team
  /// process (retention/legal review), not an automated hard delete from this flag alone.
  deletionRequestedAt                  DateTime?
  deletionRequestedByUserId            String?
  /// Google/Yelp/etc. review link shared with clients after project closeout — null disables
  /// the "request a review" action entirely (nothing to point the client at yet).
  reviewRequestUrl                     String?
  /// Franchise/multi-branch rollup: a parent company can view read-only aggregate stats across
  /// every company that has linked to it (see franchiseLinkCode). Null means this company is
  /// either standalone or itself a parent — never both, enforced in CompanyService.
  parentCompanyId                      String?
  /// One-time code the parent shares out-of-band; a prospective branch redeems it via
  /// POST /company/link-to-parent to set its own parentCompanyId. Regenerating clears the old code.
  franchiseLinkCode                    String?                @unique
  /// Exact IPs or CIDR blocks (e.g. "203.0.113.4" or "203.0.113.0/24") allowed to sign in —
  /// empty means unrestricted. Checked in IpAllowlistGuard, after authentication succeeds.
  ipAllowlist                          String[]               @default([])
  /// Auto-signs out a session after this many minutes of inactivity — null disables the policy
  /// (the JWT's own expiry is still the outer bound). Enforced in JwtAuthGuard via SessionsService.
  sessionTimeoutMinutes                Int?
  /// Password policy applied wherever a password is set (signup, invite accept, change/reset) —
  /// see assertPasswordPolicy() in AuthService.
  passwordMinLength                    Int                    @default(8)
  passwordRequireSymbol                Boolean                @default(false)
  /// Roles that see quantities/scope on estimates but not internal cost/markup figures
  /// (materialsCost, laborCost, markupAmount, markupPercent, laborRatePerHour) — enforced in
  /// EstimatesService. Empty means everyone with estimate access sees the full breakdown.
  hideCostDataFromRoles                MembershipRole[]       @default([])
  /// Sidebar nav item keys (matching authenticated-shell.tsx's NAV_ITEMS[].key, e.g. "fleet",
  /// "hazmat") this company has chosen to hide — an admin's business doesn't need every module
  /// this app ships, and a 33-item menu with nothing hidden is harder to scan than one trimmed to
  /// what's actually used. Empty (the default) shows everything, so existing companies and any
  /// nav item added later are unaffected until someone opts to hide it.
  hiddenNavItems                       String[]               @default([])
  /// This company's own shareable code for Cantero's platform referral program — generated once
  /// at signup, never changes. Distinct from the CRM's client-to-client referral tracking.
  referralCode                         String?                @unique
  /// Set at signup if the new company used another company's referralCode.
  referredByCompanyId                  String?
  /// Incoming webhook URLs for chat notifications on key events — null disables that channel.
  slackWebhookUrl                      String?
  teamsWebhookUrl                      String?
  /// Token embedded in the company's public ICS calendar-subscription URL — null disables the feed.
  calendarFeedToken                    String?                @unique
  /// Monthly PTO accrual shown to admins as a reference figure when adjusting a worker's balance —
  /// null means the company doesn't run a formal accrual policy (balances are still adjustable).
  ptoAccrualHoursPerMonth              Decimal?               @db.Decimal(6, 2)
  /// Currency franchise rollups convert branch figures into — null means "use this company's own
  /// currency", only meaningful for a parent company with linked branches.
  reportingCurrency                    Currency?
  /// Contractor's mailing address, printed in the header of certified payroll reports (WH-347).
  /// Also used as the street line of the seller's postal address on generated e-invoices (see
  /// InvoicesService.generateXRechnungXml). Null just means it hasn't been filled in yet.
  address                              String?
  /// City/postal code, split out from `address` specifically for the structured postal-address
  /// block EN16931 e-invoices require (BT-37/BT-38) — `address` itself stays a single free-text
  /// street line, consistent with how every other address field in this schema is modeled.
  city                                 String?
  postalCode                           String?
  /// EU VAT identification number (e.g. "DE123456789") — required on an XRechnung/Factur-X
  /// e-invoice as the seller's tax registration (BT-31). Null blocks e-invoice generation.
  vatId                                String?
  /// IBAN shown as the e-invoice's payment means (BT-84) — null just omits the PaymentMeans
  /// block rather than blocking generation, since not every seller pays by bank transfer.
  iban                                 String?
  /// Set when coiPubliclyShared is turned on; the public COI page lives at /company-coi/:coiPublicToken.
  /// Same shareable-link pattern as Subcontractor.publicToken/publicListed — lets a client or lender
  /// view/download this company's current insurance certificates without an account.
  coiPublicToken                       String?                @unique
  coiPubliclyShared                    Boolean                @default(false)
  /// Aggregate bonding capacity this company's surety will support — the sum of active
  /// SuretyBond.penalSum against this limit is the bonding-capacity-utilization figure GCs
  /// track before bidding new public/large work. Null means no limit has been recorded yet.
  bondingCapacityLimit                 Decimal?               @db.Decimal(14, 2)

