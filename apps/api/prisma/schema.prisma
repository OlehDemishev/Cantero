generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum MembershipRole {
  owner
  admin
  estimator
  foreman
  accountant
  worker
}

enum UnitSystem {
  metric
  imperial
}

enum Currency {
  EUR
  USD
  GBP
  CHF
  CAD
}

enum Locale {
  en
  de
  es
}

enum SubscriptionStatus {
  incomplete
  active
  past_due
  canceled
}

enum EstimateStatus {
  draft
  approved
}

enum InvoiceStatus {
  draft
  sent
  paid
  void
}

enum StockMovementType {
  receipt
  issue
  transfer
  write_off
}

enum TaskStatus {
  planned
  in_progress
  done
}

enum PurchaseOrderStatus {
  draft
  ordered
  received
}

enum ClientStage {
  lead
  contacted
  qualified
  won
  lost
}

// ---------- Tenancy & Identity ----------

model Company {
  id         String     @id @default(uuid())
  name       String
  unitSystem UnitSystem @default(metric)
  currency   Currency   @default(EUR)
  locale     Locale     @default(en)
  country    String // ISO 3166-1 alpha-2
  createdAt  DateTime   @default(now())

  memberships  Membership[]
  invites      Invite[]
  subscription Subscription?

  materialCatalogItems MaterialCatalogItem[]
  rateCatalogItems     RateCatalogItem[]
  projects             Project[]
  clients              Client[]
  estimates            Estimate[]
  invoices             Invoice[]
  warehouses           Warehouse[]
  suppliers            Supplier[]
  workers              Worker[]
  documents            Document[]

  @@map("companies")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  memberships Membership[]
  workers     Worker[]

  @@map("users")
}

model Membership {
  id        String         @id @default(uuid())
  userId    String
  companyId String
  role      MembershipRole @default(owner)
  createdAt DateTime       @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("memberships")
}

model Invite {
  id         String         @id @default(uuid())
  companyId  String
  email      String
  role       MembershipRole @default(worker)
  token      String         @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("invites")
}

// ---------- Billing ----------

model Plan {
  id            String   @id @default(uuid())
  code          String   @unique // starter | growth | pro
  name          String
  pricePerSeat  Decimal  @db.Decimal(10, 2)
  currency      Currency @default(EUR)
  stripePriceId String?
  seatMinimum   Int      @default(1)
  createdAt     DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String              @id @default(uuid())
  companyId            String              @unique
  planId               String
  seats                Int                 @default(1)
  status               SubscriptionStatus  @default(incomplete)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

// ---------- Estimates (flagship) ----------

model MaterialCatalogItem {
  id               String   @id @default(uuid())
  companyId        String
  code             String
  name             String
  unit             String
  defaultUnitPrice Decimal  @db.Decimal(12, 4)
  /// Below this quantity on hand (summed across warehouses), a low-stock alert is queued. Null = no alert.
  reorderThreshold Decimal? @db.Decimal(14, 4)
  createdAt        DateTime @default(now())

  company              Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rateCatalogItemUses  RateCatalogItemMaterial[]
  stockLevels          StockLevel[]
  stockMovements       StockMovement[]
  purchaseOrderLines   PurchaseOrderLine[]
  requirementLines     EstimateMaterialRequirement[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("material_catalog_items")
}

model RateCatalogItem {
  id                String   @id @default(uuid())
  companyId         String
  code              String
  name              String
  unit              String
  laborHoursPerUnit Decimal  @db.Decimal(10, 4)
  createdAt         DateTime @default(now())

  company       Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  materials     RateCatalogItemMaterial[]
  estimateLines EstimateLine[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("rate_catalog_items")
}

model RateCatalogItemMaterial {
  id                     String  @id @default(uuid())
  rateCatalogItemId      String
  materialCatalogItemId  String
  quantityPerUnit        Decimal @db.Decimal(12, 6)
  wasteFactorPercent     Decimal @default(0) @db.Decimal(5, 2)

  rateCatalogItem     RateCatalogItem     @relation(fields: [rateCatalogItemId], references: [id], onDelete: Cascade)
  materialCatalogItem MaterialCatalogItem @relation(fields: [materialCatalogItemId], references: [id], onDelete: Restrict)

  @@unique([rateCatalogItemId, materialCatalogItemId])
  @@index([rateCatalogItemId])
  @@map("rate_catalog_item_materials")
}

model Estimate {
  id               String         @id @default(uuid())
  companyId        String
  projectId        String
  name             String
  status           EstimateStatus @default(draft)
  laborRatePerHour Decimal        @db.Decimal(10, 2)
  markupPercent    Decimal        @default(15) @db.Decimal(5, 2)
  taxPercent       Decimal        @default(0) @db.Decimal(5, 2)

  materialsCostTotal Decimal @default(0) @db.Decimal(14, 2)
  laborCostTotal     Decimal @default(0) @db.Decimal(14, 2)
  subtotal           Decimal @default(0) @db.Decimal(14, 2)
  markupAmount       Decimal @default(0) @db.Decimal(14, 2)
  taxAmount          Decimal @default(0) @db.Decimal(14, 2)
  grandTotal         Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sections     EstimateSection[]
  lines        EstimateLine[]
  requirements EstimateMaterialRequirement[]
  invoices     Invoice[]

  @@index([companyId])
  @@index([projectId])
  @@map("estimates")
}

model EstimateSection {
  id         String @id @default(uuid())
  estimateId String
  name       String
  sortOrder  Int    @default(0)

  estimate Estimate       @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  lines    EstimateLine[]

  @@index([estimateId])
  @@map("estimate_sections")
}

model EstimateLine {
  id                String  @id @default(uuid())
  estimateId        String
  sectionId         String?
  rateCatalogItemId String
  quantity          Decimal @db.Decimal(12, 4)
  materialsCost     Decimal @default(0) @db.Decimal(14, 2)
  laborCost         Decimal @default(0) @db.Decimal(14, 2)
  lineTotal         Decimal @default(0) @db.Decimal(14, 2)
  sortOrder         Int     @default(0)

  estimate        Estimate         @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  section         EstimateSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  rateCatalogItem RateCatalogItem  @relation(fields: [rateCatalogItemId], references: [id], onDelete: Restrict)
  tasks           Task[]
  stockMovements  StockMovement[]

  @@index([estimateId])
  @@map("estimate_lines")
}

/// Snapshot of the material requirement list generated when an estimate is approved.
model EstimateMaterialRequirement {
  id                    String  @id @default(uuid())
  estimateId            String
  materialCatalogItemId String
  quantity              Decimal @db.Decimal(14, 4)
  unit                  String

  estimate            Estimate            @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  materialCatalogItem MaterialCatalogItem @relation(fields: [materialCatalogItemId], references: [id], onDelete: Restrict)

  @@unique([estimateId, materialCatalogItemId])
  @@index([estimateId])
  @@map("estimate_material_requirements")
}

// ---------- Materials & Inventory (schema-only until Phase 2, except MaterialCatalogItem above) ----------

model Warehouse {
  id        String @id @default(uuid())
  companyId String
  name      String
  address   String?

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockLevels    StockLevel[]
  stockMovements StockMovement[]

  @@index([companyId])
  @@map("warehouses")
}

model StockLevel {
  id                    String  @id @default(uuid())
  warehouseId           String
  materialCatalogItemId String
  quantityOnHand        Decimal @default(0) @db.Decimal(14, 4)

  warehouse           Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  materialCatalogItem MaterialCatalogItem @relation(fields: [materialCatalogItemId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, materialCatalogItemId])
  @@map("stock_levels")
}

model StockMovement {
  id                    String            @id @default(uuid())
  companyId             String
  warehouseId           String
  materialCatalogItemId String
  type                  StockMovementType
  quantity              Decimal           @db.Decimal(14, 4)
  projectId             String?
  estimateLineId        String?
  createdAt             DateTime          @default(now())

  warehouse           Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  materialCatalogItem MaterialCatalogItem @relation(fields: [materialCatalogItemId], references: [id], onDelete: Restrict)
  project             Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  estimateLine         EstimateLine?      @relation(fields: [estimateLineId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([warehouseId])
  @@map("stock_movements")
}

model Supplier {
  id        String  @id @default(uuid())
  companyId String
  name      String
  email     String?
  phone     String?

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@index([companyId])
  @@map("suppliers")
}

model PurchaseOrder {
  id         String              @id @default(uuid())
  companyId  String
  supplierId String
  status     PurchaseOrderStatus @default(draft)
  receivedAt DateTime?
  createdAt  DateTime            @default(now())

  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines    PurchaseOrderLine[]

  @@index([companyId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                    String  @id @default(uuid())
  purchaseOrderId       String
  materialCatalogItemId String
  quantity              Decimal @db.Decimal(14, 4)
  unitPrice             Decimal @db.Decimal(12, 4)

  purchaseOrder       PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  materialCatalogItem MaterialCatalogItem @relation(fields: [materialCatalogItemId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

// ---------- Projects (thin in Phase 1; Scheduling schema-only until Phase 3) ----------

model Project {
  id        String   @id @default(uuid())
  companyId String
  name      String
  address   String?
  clientId  String?
  createdAt DateTime @default(now())

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  estimates      Estimate[]
  invoices       Invoice[]
  tasks          Task[]
  milestones     Milestone[]
  stockMovements StockMovement[]
  timeEntries    TimeEntry[]
  documents      Document[]

  @@index([companyId])
  @@map("projects")
}

model Task {
  id             String     @id @default(uuid())
  projectId      String
  estimateLineId String?
  name           String
  status         TaskStatus @default(planned)
  startDate      DateTime?
  dueDate        DateTime?
  sortOrder      Int        @default(0)

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  estimateLine EstimateLine? @relation(fields: [estimateLineId], references: [id], onDelete: SetNull)
  timeEntries  TimeEntry[]

  @@index([projectId])
  @@map("tasks")
}

model Milestone {
  id        String    @id @default(uuid())
  projectId String
  name      String
  dueDate   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("milestones")
}

// ---------- Finance (thin in Phase 1; Payments/budget-vs-actual in Phase 4) ----------

model Invoice {
  id         String        @id @default(uuid())
  companyId  String
  projectId  String
  clientId   String
  estimateId String?
  number     String
  status     InvoiceStatus @default(draft)
  subtotal   Decimal       @db.Decimal(14, 2)
  taxAmount  Decimal       @default(0) @db.Decimal(14, 2)
  total      Decimal       @db.Decimal(14, 2)
  createdAt  DateTime      @default(now())

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client   Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  estimate Estimate?     @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  lines    InvoiceLine[]
  payments Payment[]
  documents Document[]

  @@unique([companyId, number])
  @@index([companyId])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(12, 4)
  unitPrice   Decimal @db.Decimal(12, 4)
  lineTotal   Decimal @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  amount    Decimal  @db.Decimal(14, 2)
  method    String
  paidAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

// ---------- CRM (thin in Phase 1) ----------

model Client {
  id        String      @id @default(uuid())
  companyId String
  name      String
  email     String?
  phone     String?
  stage     ClientStage @default(lead)
  notes     String?
  createdAt DateTime    @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects Project[]
  invoices Invoice[]

  @@index([companyId])
  @@map("clients")
}

// ---------- Team/HR (schema-only until Phase 5) ----------

model Worker {
  id          String   @id @default(uuid())
  companyId   String
  userId      String?
  name        String
  role        String?
  /// Cost rate used to value TimeEntry hours into actual labor cost (Finance budget-vs-actual).
  hourlyCost  Decimal? @db.Decimal(10, 2)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]

  @@index([companyId])
  @@map("workers")
}

model TimeEntry {
  id        String   @id @default(uuid())
  companyId String
  workerId  String
  projectId String
  taskId    String?
  hours     Decimal  @db.Decimal(6, 2)
  date      DateTime

  worker  Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([workerId])
  @@index([projectId])
  @@map("time_entries")
}

// ---------- Documents (schema-only until Phase 5) ----------

model Document {
  id         String   @id @default(uuid())
  companyId  String
  projectId  String?
  invoiceId  String?
  name       String
  storageKey String
  mimeType   String
  createdAt  DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("documents")
}
