# Copy to .env and fill in real values for anything beyond local dev.
# Deploying with docker-compose.prod.yml? This whole file is the checklist for what goes into
# the repo-root .env.prod it reads via env_file: — see that file's own top comment.

# In docker-compose.prod.yml, postgres/redis are reached by service name, not localhost:
#   DATABASE_URL="postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>"
#   REDIS_URL="redis://redis:6379"
DATABASE_URL="postgresql://baugeld:baugeld@localhost:5432/baugeld?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="dev-only-change-me"
# Separate secret for client-portal session tokens — keeps a leaked portal token from
# being replayable against internal (user) routes even though both share JwtService.
PORTAL_JWT_SECRET="dev-only-change-me-too"
SUBCONTRACTOR_PORTAL_JWT_SECRET="dev-only-change-me-as-well"
SUPPLIER_PORTAL_JWT_SECRET="dev-only-change-me-also"
WEB_ORIGIN="http://localhost:3000"
# Absolute URL back to this API, used when building links that must work outside a browser request
# context (accounting OAuth callback, SSO redirect) — where there's no incoming Origin/Host header
# to infer it from. Leave unset for local dev; in production set to the real public API URL
# (e.g. "https://api.example.com/api").
API_ORIGIN="http://localhost:4000/api"
# Public URL of the client/subcontractor/supplier portal, for links sent in emails (payment method
# setup, billing portal return). Falls back to WEB_ORIGIN, then to localhost — only set this
# separately if the portal is served from a different host than the main app.
PORTAL_ORIGIN=""
PORT=4000
# Standard Node environment flag — read directly by initSentry() to tag reported errors with their
# environment. Set to "production" in any real deployment; leave unset (or "development") locally.
NODE_ENV="development"
# Number of reverse-proxy/load-balancer hops in front of this process in production (usually 1).
# Needed for req.ip to resolve to the real client rather than the proxy — RateLimiterService's
# per-IP limits (login, 2FA, ...) depend on it. Leave at 0 for local dev or a direct-exposed
# deployment with no proxy in front.
TRUST_PROXY_HOPS=0

# Stripe — required to exercise the real checkout flow (not required for the
# seeded demo companies, which are seeded with an already-active subscription).
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Fill in after creating the three Plan rows' matching Stripe Prices:
# UPDATE plans SET "stripePriceId" = 'price_...' WHERE code = 'starter';

# Web push (VAPID) — generate your own with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:support@example.com"
# Push to the Cantero Field app (apps/mobile) goes through Expo Push, which needs no key by default.
# Set this only if "enhanced push security" is turned on for the Expo project (expo.dev → project
# → Credentials → Access tokens).
EXPO_ACCESS_TOKEN=""

# Email (SMTP) — leave SMTP_HOST unset to log outgoing emails to the console instead of
# sending them (useful for local dev without a real mailbox).
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="apikey"
SMTP_PASSWORD="..."
SMTP_FROM="Cantero <no-reply@example.com>"

# SMS (Twilio) — leave TWILIO_ACCOUNT_SID unset to log outgoing SMS to the console instead of
# sending them, same as SMTP_HOST above.
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_FROM_NUMBER="+15550000000"

# File storage — leave S3_BUCKET unset to store uploads on local disk instead (useful for local
# dev, NOT safe in production: local disk doesn't survive a redeploy or work across more than one
# instance). Works with AWS S3 or any S3-compatible provider (MinIO, Cloudflare R2, DigitalOcean
# Spaces, Backblaze B2, ...) — set S3_ENDPOINT for a non-AWS provider, and S3_FORCE_PATH_STYLE=true
# if that provider needs path-style URLs (MinIO does). S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY are
# optional on real AWS if the process already has credentials via an IAM role.
# UPLOADS_DIR — only read in local-disk mode (S3_BUCKET unset); overrides where uploads are
# written on disk, default "./uploads" relative to the process's working directory.
S3_BUCKET="cantero-uploads"
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
S3_ACCESS_KEY_ID="..."
S3_SECRET_ACCESS_KEY="..."

# Error monitoring (Sentry) — leave SENTRY_DSN unset to disable reporting entirely (no crash, just
# a no-op), same convention as the rest of this file. Reports unexpected errors only (raw thrown
# errors and 500+ responses) — an expected 4xx like a failed login or a validation error is normal
# control flow, not something worth an alert.
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"

# Accounting sync (QuickBooks Online / Xero) — leave a provider's CLIENT_ID unset to disable it
# (getAuthorizeUrl fails fast with a clear error instead of building a redirect that 404s).
QUICKBOOKS_CLIENT_ID="..."
QUICKBOOKS_CLIENT_SECRET="..."
# QuickBooks (unlike Xero) puts sandbox and production companies on different API hosts. Leave
# unset for local dev/testing against a sandbox company; a real deployment MUST set this to
# "https://quickbooks.api.intuit.com" or syncs silently keep writing into a sandbox company no
# real QBO user ever sees. If this is left unset while QUICKBOOKS_CLIENT_ID is set AND
# NODE_ENV=production, the server refuses to start at all (see quickbooks-production-safety.ts) —
# a startup crash with a clear message is safer than silently running against sandbox for weeks.
QUICKBOOKS_API_BASE_URL=""
XERO_CLIENT_ID="..."
XERO_CLIENT_SECRET="..."

# Peppol network Access Point — leave unset. This app can generate Peppol BIS Billing 3.0 XML on
# its own (no config needed), but actually transmitting it over the Peppol network requires a
# contracted Access Point provider (e.g. Storecove, Basware) — none is implemented yet, so setting
# this to anything other than unset just changes the scaffold's error message from
# "not configured" to "unknown provider". See PeppolAccessPointService.
PEPPOL_AP_PROVIDER=""

# DocuSign e-signature (contracts only, not estimates/change orders) — leave DOCUSIGN_CLIENT_ID
# unset to disable it (getAuthorizeUrl fails fast with a clear error). lexoffice's account model
# doesn't apply here: DocuSign uses a real OAuth2 app you register in DocuSign's developer portal.
DOCUSIGN_CLIENT_ID="..."
DOCUSIGN_CLIENT_SECRET="..."
# DocuSign (like QuickBooks) puts its demo/developer environment and production on different
# account hosts. Leave unset for local dev/testing against a demo account; a real deployment MUST
# set this to "https://account.docusign.com" or every connection attempt keeps hitting a demo
# account no real DocuSign customer has.
DOCUSIGN_OAUTH_BASE_URL=""

# MS Project ("Project for the Web") — leave MS_PROJECT_CLIENT_ID unset to disable it. Register a
# real app in Azure AD (Microsoft Entra) to get these; there's no sandbox/production split like
# QuickBooks/DocuSign since a Dataverse OAuth token is scoped to the company's own environment URL
# at connect time instead. See MsProjectService's doc comment: the Dataverse entity/field names
# this pushes (msdyn_project, msdyn_projecttask, ...) are unverified against a live environment —
# lower confidence than the other accounting/e-signature connectors.
MS_PROJECT_CLIENT_ID="..."
MS_PROJECT_CLIENT_SECRET="..."

# Autodesk Construction Cloud (via Autodesk Platform Services, formerly Forge) — leave
# AUTODESK_CLIENT_ID unset to disable it. Register a free APS developer app for these; real
# self-service OAuth2, same confidence level as QuickBooks/Xero/DocuSign. See AutodeskService's
# doc comment for what's pushed (punch list items as ACC Issues) and its confidence level.
AUTODESK_CLIENT_ID="..."
AUTODESK_CLIENT_SECRET="..."

# Sage Intacct Construction (REST API, OAuth 2.0 authorization code). Needs an app registered in the
# Sage App Registry — leave INTACCT_CLIENT_ID unset to disable. INTACCT_API_BASE_URL only needs
# setting to point at a stub/test host; the default is https://api.intacct.com/ia/api/v1.
INTACCT_CLIENT_ID="..."
INTACCT_CLIENT_SECRET="..."
INTACCT_API_BASE_URL=""

# Local OCR (receipt scans; scanned drawing sheets). Models for German, English, Polish and
# Ukrainian ship with the app — nothing is downloaded or sent anywhere. Name a subset to read
# faster, e.g. "deu+eng"; leave empty for all four.
OCR_LANGUAGES=""

# Meaning-based search (search by meaning across languages, "similar item already exists" hints).
# Embeddings are computed on this server's CPU with a local model — by default BAAI bge-m3
# (~560 MB on disk, ~1.7 GB RAM once loaded) — fetched once from the Hugging Face hub into
# EMBEDDINGS_CACHE_DIR (default: apps/api/.models). For a server without outbound access, copy that
# folder over and set EMBEDDINGS_ALLOW_DOWNLOAD=false. EMBEDDINGS_MODEL="Xenova/multilingual-e5-small"
# needs ~0.5 GB but finds noticeably worse matches across languages (see search/semantic/embedder.ts).
SEMANTIC_SEARCH_ENABLED="true"
EMBEDDINGS_MODEL=""
EMBEDDINGS_CACHE_DIR=""
EMBEDDINGS_ALLOW_DOWNLOAD="true"
