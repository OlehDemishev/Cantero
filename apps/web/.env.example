# Copy to .env.local for local dev. In docker-compose.prod.yml, NEXT_PUBLIC_API_URL is instead
# passed as a build arg (see that file's `web` service and apps/web/Dockerfile) — NEXT_PUBLIC_*
# vars are inlined into the client bundle at build time, not read at runtime.
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Error monitoring (Sentry) — leave NEXT_PUBLIC_SENTRY_DSN unset to disable reporting entirely (no
# crash, just a no-op), same convention as the API's SENTRY_DSN.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
